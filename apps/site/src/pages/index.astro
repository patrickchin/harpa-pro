---
import Layout from "../layouts/Layout.astro";
import Header from "../components/landing/Header.astro";
import Hero from "../components/landing/Hero.astro";
import AppOverview from "../components/landing/AppOverview.astro";
import Footer from "../components/landing/Footer.astro";
---

<Layout
  title="Your procurement agent in China. — Harpa Pro"
  description="Meet Haruna, your procurement agent in China. Follow each stage from the design brief and factory match to quality checks, shipment, and delivery."
>
  <div class="min-h-screen bg-background text-ink">
    <Header />
    <main>
      <Hero />
      <AppOverview />
    </main>
    <Footer />
  </div>
</Layout>

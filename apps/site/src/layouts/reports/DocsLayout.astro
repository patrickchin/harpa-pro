---
import type { CollectionEntry } from "astro:content";

import DocsSidebar from "../../components/reports/docs/DocsSidebar.astro";
import Breadcrumbs from "../../components/site/Breadcrumbs.astro";
import Footer from "../../components/site/Footer.astro";
import Header from "../../components/site/Header.astro";
import Layout from "../Layout.astro";
import { breadcrumbJsonLd, breadcrumbTrail } from "../../lib/site/sections";
import { canonicalPathname } from "../../lib/urls";

interface Props {
  title: string;
  description: string;
  guides: CollectionEntry<"reportsDocs">[];
  currentSlug?: string;
  currentTitle?: string;
}

const { title, description, guides, currentSlug, currentTitle } = Astro.props;
const breadcrumbs = breadcrumbTrail("reports", [
  { name: "Guides", path: "/reports/docs" },
  ...(currentTitle && currentSlug ? [{
    name: currentTitle,
    path: `/reports/docs/guides/${currentSlug}`,
  }] : []),
]);
const pageUrl = new URL(canonicalPathname(Astro.url.pathname), Astro.site).href;
const structuredData = [breadcrumbJsonLd(Astro.site!, pageUrl, breadcrumbs)];
---

<Layout
  section="reports"
  title={`${title} | Harpa Pro`}
  description={description}
  pageType={currentSlug ? "TechArticle" : "CollectionPage"}
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background text-ink">
    <Header section="reports" />
    <div class="docs-shell">
      <details class="docs-mobile-nav">
        <summary>
          <span>Browse site reporting guides</span>
          <svg
            class="docs-mobile-nav-chevron"
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <DocsSidebar
          guides={guides}
          currentSlug={currentSlug}
          label="Guide menu"
        />
      </details>

      <div class="docs-columns">
        <aside class="docs-desktop-nav">
          <a class="docs-home-link" href="/reports/docs">Site reporting guides</a>
          <DocsSidebar
            guides={guides}
            currentSlug={currentSlug}
            label="Guide sections"
          />
        </aside>

        <main class="docs-main" id="main-content">
          <Breadcrumbs items={breadcrumbs} />
          <slot />
        </main>
      </div>
    </div>
    <Footer section="reports" />
  </div>
</Layout>

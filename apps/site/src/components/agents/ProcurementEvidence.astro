---
import { Image } from "astro:assets";
import EvidenceImageDialog from "./EvidenceImageDialog.astro";
import revitShopDrawingImg from "../../assets/agents/procurement/revit-a103-shop-drawing.jpg";
import revitCoordinationImg from "../../assets/agents/procurement/revit-a104-coordination.jpg";
import aisFactoryImg from "../../assets/procurement/factories/ais-factory-exterior.webp";
import aisStyleImg from "../../assets/procurement/factories/catalogues/ais-style-selection-p04.webp";
import j2sProjectImg from "../../assets/procurement/factories/catalogues/j2s-project-p05.webp";
import j2sBarChairsImg from "../../assets/procurement/factories/catalogues/j2s-bar-chairs-p12.webp";
import kenuoOfficeImg from "../../assets/procurement/factories/catalogues/kenuo-office-p12.webp";
import masyoungerStorageImg from "../../assets/procurement/factories/catalogues/masyounger-storage-p08.webp";
import rongshuoBathroomImg from "../../assets/procurement/factories/catalogues/rongshuo-bathroom-p02.webp";
import rongshuoShowerImg from "../../assets/procurement/factories/catalogues/rongshuo-shower-p02.webp";
import aisHdfReportImg from "../../assets/procurement/factories/credentials/ais-hdf-formaldehyde-e0-2026.webp";
import aisHmrReportImg from "../../assets/procurement/factories/credentials/ais-hmr-particleboard-formaldehyde-e0-2026.webp";
import aisOsbReportImg from "../../assets/procurement/factories/credentials/ais-osb-formaldehyde-enf-2026.webp";
import aisPurVocReportImg from "../../assets/procurement/factories/credentials/ais-pur-adhesive-voc-2024.webp";
import aisRohsReportImg from "../../assets/procurement/factories/credentials/ais-hot-melt-adhesive-rohs-2024.webp";
import aisBoardE1ReportImg from "../../assets/procurement/factories/credentials/ais-board-e1-2020.webp";
import aisWanhuaCertificateImg from "../../assets/procurement/factories/credentials/ais-wanhua-production-control-2015.webp";
import j2sFormaldehydeReportImg from "../../assets/procurement/factories/credentials/j2s-sofa-formaldehyde-e1-test-2021.webp";
import j2sE1CertificateImg from "../../assets/procurement/factories/credentials/j2s-sofa-e1-certificate-2020.webp";
import j2sEuRepresentativeImg from "../../assets/procurement/factories/credentials/j2s-eu-representative-appointment-2025-2026.webp";

const factories = [
  {
    index: "01",
    name: "AIS Smarti",
    location: "Foshan and Jiangmen, Guangdong",
    scope:
      "Custom cabinetry, wardrobes, bathroom cabinets, doors, wall panels, and project joinery.",
    material:
      "Three catalogues, factory images, project examples, packing information, and seven credential records.",
    use:
      "Harpa Pro uses the drawings, finish ranges, factory records, and material reports to prepare project-specific joinery packages.",
    image: aisFactoryImg,
    alt: "AIS Smarti headquarters and factory in Foshan, China",
    featured: true,
  },
  {
    index: "02",
    name: "J2S",
    location: "Foshan, Guangdong",
    scope:
      "Custom furniture for restaurants, cafes, bars, hotel lobbies, and public areas.",
    material:
      "A 45-page hospitality catalogue and three certificate or test-report files.",
    use:
      "Harpa Pro uses the project references and model ranges to define seating, tables, finishes, quantities, and packing.",
    image: j2sProjectImg,
    alt: "J2S restaurant project and hospitality furniture catalogue spread",
  },
  {
    index: "03",
    name: "Kenuo",
    location: "Guangdong, China",
    scope:
      "Wood office desks, workstations, meeting tables, storage, and seating.",
    material:
      "Office, leather-chair, PVC, and series catalogues with product images and model references.",
    use:
      "Harpa Pro uses the series pages to compare layouts, finishes, sizes, seating, and order quantities.",
    image: kenuoOfficeImg,
    alt: "Kenuo executive office desk and storage catalogue page",
  },
  {
    index: "04",
    name: "Masyounger",
    location: "Luoyang, Henan",
    scope:
      "Steel filing cabinets, lockers, shelving, workbenches, and school furniture.",
    material:
      "Product catalogues with model numbers, dimensions, construction notes, and storage configurations.",
    use:
      "Harpa Pro uses the model and dimension data to compare storage capacity, construction, finish, packing, and quantities.",
    image: masyoungerStorageImg,
    alt: "Masyounger steel storage cabinet models and dimensions",
  },
  {
    index: "05",
    name: "Rong Shuo",
    location: "Pinghu, Zhejiang",
    scope:
      "Bathroom cabinets, mirrors, shower enclosures, and prefabricated bathroom systems.",
    material:
      "Three catalogues with model references, size ranges, glass, frame, hardware, and bathroom options.",
    use:
      "Harpa Pro uses the product data to confirm dimensions, finishes, glass, hardware, interfaces, packing, and order quantities.",
    image: rongshuoBathroomImg,
    alt: "Rong Shuo bathroom cabinet models from the supplied catalogue",
  },
];

const buyerInformation = [
  "Product or model reference",
  "Intended use and configuration",
  "Dimensions and permitted variation",
  "Materials and construction",
  "Finish, color, and hardware",
  "Applicable test reports or certificates",
  "Quantity and packing method",
  "Quotation basis, lead time, and items to confirm",
];

const productBriefs = [
  {
    index: "01",
    title: "AIS custom kitchen joinery",
    source: "AIS Smarti Product Style Selection, page 4",
    description:
      "This example starts with a style reference. The quoted brief would add approved drawings, dimensions, board grade, finishes, hardware, interfaces, quantity, and packing.",
    image: aisStyleImg,
    alt: "AIS Smarti modern kitchen style selection page",
    details: [
      ["Reference", "Project-specific joinery package"],
      ["Application", "Custom kitchen cabinetry"],
      ["Selection", "Layout, door style, finish, worktop interface, and hardware"],
      ["Confirmation", "Approved drawings, dimensions, quantities, and packing"],
    ],
  },
  {
    index: "02",
    title: "J2S JSBC hospitality seating",
    source: "J2S catalogue, pages 21-22",
    description:
      "The catalogue identifies the JSBC bar-chair series. The quoted brief would identify one model and record its dimensions, frame, upholstery, finish, quantity, and packing.",
    image: j2sBarChairsImg,
    alt: "J2S JSBC bar-chair series catalogue spread",
    details: [
      ["Reference", "JSBC hospitality seating series"],
      ["Application", "Bar and lounge seating"],
      ["Selection", "Model, frame, upholstery, color, and finish"],
      ["Confirmation", "Dimensions, quantity, packing, and dispatch lead time"],
    ],
  },
  {
    index: "03",
    title: "Rong Shuo SW-011 shower enclosure",
    source: "Rong Shuo Shower Room/Enclosure Catalogue, page 2",
    description:
      "This catalogue entry provides enough data for an initial comparison. The order brief would also record handing, site dimensions, finish, quantity, and packing.",
    image: rongshuoShowerImg,
    alt: "Rong Shuo SW-011 shower enclosure catalogue page",
    details: [
      ["Reference", "SW-011"],
      ["Size", "(800-900) x (800-1200) x 2000 mm"],
      ["Construction", "Chromed aluminium frame and 8 mm clear glass"],
      ["Hardware", "SUS sliding bar, stopper, and handle with brass roller"],
      ["Adjustment", "20 mm"],
    ],
  },
];

const credentialGroups = [
  {
    name: "AIS Smarti source package",
    documents: [
      {
        title: "Marine HDF formaldehyde test",
        meta: "SGS SDHL260400719601HI | 15 June 2026 | 3 pages",
        description:
          "Applicant: AIS JOINERY PTY LTD. The report records a GB 18580-2025 E0 result of pass for marine HDF.",
        image: aisHdfReportImg,
        alt: "First page of the AIS marine HDF formaldehyde test report",
        href: "/documents/factories/ais/ais-hdf-formaldehyde-e0-2026.pdf",
        linkLabel: "Open original PDF",
      },
      {
        title: "HMR particleboard formaldehyde test",
        meta: "SGS SDHL260400719501HI | 15 June 2026 | 3 pages",
        description:
          "Applicant: AIS JOINERY PTY LTD. The report records a GB 18580-2025 E0 result of pass for HMR particleboard.",
        image: aisHmrReportImg,
        alt: "First page of the AIS HMR particleboard formaldehyde test report",
        href: "/documents/factories/ais/ais-hmr-particleboard-formaldehyde-e0-2026.pdf",
        linkLabel: "Open original PDF",
      },
      {
        title: "OSB formaldehyde test",
        meta: "SGS SDHL260400719701HI | 15 June 2026 | 3 pages",
        description:
          "Applicant: AIS JOINERY PTY LTD. The report records a GB/T 39600-2021 ENF result of pass for oriented strand board.",
        image: aisOsbReportImg,
        alt: "First page of the AIS oriented strand board formaldehyde test report",
        href: "/documents/factories/ais/ais-osb-formaldehyde-enf-2026.pdf",
        linkLabel: "Open original PDF",
      },
      {
        title: "PUR adhesive VOC test",
        meta: "SGS CANEC24022609601 | 21 October 2024 | 3 pages",
        description:
          "Supplier document for polyurethane adhesive. The report records compliance with the GB 33372-2020 VOC limit.",
        image: aisPurVocReportImg,
        alt: "First page of the polyurethane adhesive VOC test report",
        href: "/documents/factories/ais/ais-supplied-pur-adhesive-voc-2024.pdf",
        linkLabel: "Open original PDF",
      },
      {
        title: "Hot-melt adhesive RoHS test",
        meta: "NPS2024030040 | 1 April 2024 | 6 pages",
        description:
          "Supplier document for Foshan Yuetai hot-melt adhesive. The report records compliance with the stated EU RoHS limits.",
        image: aisRohsReportImg,
        alt: "Cover of the hot-melt adhesive RoHS test report",
        href: "/documents/factories/ais/ais-supplied-hot-melt-adhesive-rohs-2024.pdf",
        linkLabel: "Open original PDF",
      },
      {
        title: "E1 board formaldehyde report",
        meta: "Chinese-language supplier report | 18 April 2020 | 3 pages",
        description:
          "This board report was supplied in the AIS material package. Review the original report before it is applied to an order.",
        image: aisBoardE1ReportImg,
        alt: "Cover of the Chinese-language E1 board formaldehyde report",
        href: "/documents/factories/ais/ais-supplied-board-e1-2020.pdf",
        linkLabel: "Open original PDF",
      },
      {
        title: "Wanhua Ecoboard production-control certificate",
        meta: "EPH 0766-CPR-338 | 4 June 2015 | image",
        description:
          "The certificate names Wanhua Ecoboard and particle board. It is a supplier document, not an AIS factory certificate.",
        image: aisWanhuaCertificateImg,
        alt: "Wanhua Ecoboard factory production-control certificate",
        href: "/documents/factories/ais/ais-supplied-wanhua-production-control-2015.jpg",
        linkLabel: "Open original image",
      },
    ],
  },
  {
    name: "J2S source package",
    documents: [
      {
        title: "Sofa formaldehyde test",
        meta: "ENC2012255GZ25E1 | 4 January 2021 | 5 pages",
        description:
          "The report covers J2S JS and YX sofa series and tests formaldehyde emissions to EN 717-1:2004.",
        image: j2sFormaldehydeReportImg,
        alt: "Cover of the J2S sofa formaldehyde test report",
        href: "/documents/factories/j2s/j2s-sofa-formaldehyde-e1-test-2021.pdf",
        linkLabel: "Open original PDF",
      },
      {
        title: "Sofa E1 certificate",
        meta: "ENC2012255GZ25 | 29 December 2020 | 1 page",
        description:
          "The certificate covers J2S JS and YX sofa series. It links its approval to test report ENC2012255GZ25E1.",
        image: j2sE1CertificateImg,
        alt: "J2S sofa E1 certification of conformity",
        href: "/documents/factories/j2s/j2s-sofa-e1-certificate-2020.pdf",
        linkLabel: "Open original PDF",
      },
      {
        title: "European representative appointment",
        meta: "EUREP-2025071609543457399 | 16 July 2025 | 1 page",
        description:
          "The appointment names EUREP ENV S.L. as the European representative for J2S. Its stated validity period has ended.",
        status: "expired",
        statusLabel: "Expired 15 July 2026",
        image: j2sEuRepresentativeImg,
        alt: "J2S European representative appointment certificate",
        href: "/documents/factories/j2s/j2s-eu-representative-appointment-2025-2026.pdf",
        linkLabel: "Open original PDF",
      },
    ],
  },
];

const technicalReviews = [
  {
    title: "Revit A104 coordination review",
    description:
      "Three-dimensional room views coordinate the layout, finishes, and interfaces before factory information is approved.",
    image: revitCoordinationImg,
    alt: "Revit A104 3D coordination review sheet",
  },
  {
    title: "Revit A103 shop-drawing review",
    description:
      "Chair elevations and dimensions support the review of the factory drawing before production.",
    image: revitShopDrawingImg,
    alt: "Revit A103 chair shop drawing review sheet",
  },
];
---

<div class="max-w-3xl">
  <p class="text-xs font-semibold uppercase tracking-wider text-accent-ink">
    Factory source library
  </p>
  <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
    Factory material and project records.
  </h2>
  <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">
    The factory catalogues, product pages, and original documents support the
    information shown below. Harpa Pro uses this material to prepare a clear
    order brief for each project.
  </p>
</div>

<section aria-labelledby="factory-partners-heading" class="mt-16">
  <div class="max-w-3xl">
    <p class="font-mono text-xs text-accent-ink">Current source package</p>
    <h3
      id="factory-partners-heading"
      class="mt-3 text-2xl font-semibold tracking-tight text-ink"
    >
      Five factory groups
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
      Each profile uses material supplied by the named factory group. Harpa Pro
      confirms the final product, specification, and document scope for each
      order.
    </p>
  </div>

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    {
      factories.map((factory) => (
        <article
          data-factory-partner
          class:list={[
            "overflow-hidden rounded-2xl border border-hairline bg-card shadow-sm",
            factory.featured && "lg:col-span-2 lg:grid lg:grid-cols-[1.15fr_0.85fr]",
          ]}
        >
          <Image
            src={factory.image}
            alt={factory.alt}
            widths={[520, 760, 1040, 1440]}
            sizes={
              factory.featured
                ? "(min-width: 64rem) 44rem, calc(100vw - 3rem)"
                : "(min-width: 64rem) 35rem, calc(100vw - 3rem)"
            }
            format="webp"
            quality={88}
            loading="lazy"
            decoding="async"
            class:list={[
              "w-full bg-white object-cover",
              factory.featured ? "h-full min-h-72" : "aspect-[16/10]",
            ]}
          />
          <div class="border-t border-hairline p-6 sm:p-8 lg:border-l lg:border-t-0">
            <div class="flex items-center justify-between gap-4">
              <span class="font-mono text-xs text-accent-ink">{factory.index}</span>
              <span class="font-mono text-xs text-ink-soft">{factory.location}</span>
            </div>
            <h4 class="mt-5 text-2xl font-semibold tracking-tight text-ink">
              {factory.name}
            </h4>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{factory.scope}</p>
            <dl class="mt-6 grid gap-5 border-t border-hairline pt-5 text-sm">
              <div>
                <dt class="font-medium text-ink">Factory-supplied source material</dt>
                <dd class="mt-1 leading-relaxed text-ink-soft">{factory.material}</dd>
              </div>
              <div>
                <dt class="font-medium text-ink">Harpa Pro review</dt>
                <dd class="mt-1 leading-relaxed text-ink-soft">{factory.use}</dd>
              </div>
            </dl>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section aria-labelledby="product-information-heading" class="mt-24">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-start">
    <div class="max-w-xl">
      <p class="font-mono text-xs text-accent-ink">Buyer information</p>
      <h3
        id="product-information-heading"
        class="mt-3 text-2xl font-semibold tracking-tight text-ink"
      >
        What each quoted item should show
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-ink-soft">
        A catalogue image starts the discussion. The order brief then records
        the details needed to compare, approve, buy, inspect, and ship the item.
      </p>
    </div>
    <ol class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
      {
        buyerInformation.map((item, index) => (
          <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 border-t border-hairline pt-3 text-sm leading-relaxed text-ink">
            <span class="font-mono text-xs text-accent-ink">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section aria-labelledby="product-briefs-heading" class="mt-20">
  <div class="max-w-3xl">
    <p class="font-mono text-xs text-accent-ink">Examples, not a live catalogue.</p>
    <h3
      id="product-briefs-heading"
      class="mt-3 text-2xl font-semibold tracking-tight text-ink"
    >
      Representative product briefs
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
      These examples show how factory material becomes a buyer-facing brief.
      They do not show stock, final prices, or a complete product range.
    </p>
  </div>

  <div class="mt-10 grid gap-8">
    {
      productBriefs.map((brief, index) => (
        <article
          data-product-brief
          class="grid overflow-hidden rounded-2xl border border-hairline bg-card shadow-sm lg:grid-cols-2"
        >
          <figure
            class:list={[
              "h-80 bg-white sm:h-96 lg:h-[30rem]",
              index % 2 === 1 && "lg:order-2",
            ]}
          >
            <Image
              src={brief.image}
              alt={brief.alt}
              widths={[520, 760, 1040, 1400]}
              sizes="(min-width: 64rem) 36rem, calc(100vw - 3rem)"
              format="webp"
              quality={90}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-contain p-3"
            />
          </figure>
          <div
            class:list={[
              "border-t border-hairline p-6 sm:p-8 lg:border-t-0",
              index % 2 === 1 ? "lg:border-r" : "lg:border-l",
            ]}
          >
            <div class="flex items-center justify-between gap-4">
              <span class="font-mono text-xs text-accent-ink">Example {brief.index}</span>
              <span class="text-right font-mono text-[0.68rem] leading-relaxed text-ink-soft">
                {brief.source}
              </span>
            </div>
            <h4 class="mt-5 text-2xl font-semibold tracking-tight text-ink">
              {brief.title}
            </h4>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">
              {brief.description}
            </p>
            <dl class="mt-6 grid gap-3 border-t border-hairline pt-5 text-sm">
              {brief.details.map(([term, value]) => (
                <div class="grid gap-1 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-4">
                  <dt class="text-ink-soft">{term}</dt>
                  <dd class="font-medium leading-relaxed text-ink">{value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section aria-labelledby="factory-documents-heading" class="mt-24">
  <div class="max-w-3xl">
    <p class="font-mono text-xs text-accent-ink">Factory records</p>
    <h3
      id="factory-documents-heading"
      class="mt-3 text-2xl font-semibold tracking-tight text-ink"
    >
      Original factory documents
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
      Factory-supplied document. Harpa Pro has not independently verified its
      current status or scope.
    </p>
    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
      Select a document to inspect its first page. The dialog also links to the
      original file supplied by the factory.
    </p>
  </div>

  <div class="mt-10 grid gap-14">
    {
      credentialGroups.map((group) => (
        <section aria-label={`${group.name} records`}>
          <h4 class="border-b border-hairline pb-3 text-lg font-semibold text-ink">
            {group.name}
          </h4>
          <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-5 xl:grid-cols-3">
            {group.documents.map((document) => (
              <article
                data-credential-record
                data-credential-status={document.status}
                class="overflow-hidden rounded-xl border border-hairline bg-card shadow-sm"
              >
                <button
                  type="button"
                  aria-label={`Open full view of ${document.title}`}
                  class="evidence-image-trigger block w-full border-0 bg-white p-0 ring-focus"
                  data-evidence-image-trigger
                  data-evidence-image-src={document.image.src}
                  data-evidence-image-alt={document.alt}
                  data-evidence-image-title={document.title}
                  data-evidence-image-caption={`${document.meta}. ${document.description}`}
                  data-evidence-image-width={document.image.width}
                  data-evidence-image-height={document.image.height}
                  data-evidence-document-href={document.href}
                  data-evidence-document-label={document.linkLabel}
                >
                  <Image
                    src={document.image}
                    alt={document.alt}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 80rem) 22rem, (min-width: 48rem) 44vw, 44vw"
                    format="webp"
                    quality={92}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/5] w-full object-contain p-2"
                  />
                </button>
                <div class="border-t border-hairline p-3 sm:p-5">
                  <div class="flex flex-wrap items-start justify-between gap-2">
                    <h5 class="text-sm font-semibold leading-snug text-ink sm:text-base">
                      {document.title}
                    </h5>
                    {document.statusLabel && (
                      <span class="rounded-full border border-accent/40 bg-accent/10 px-2.5 py-1 font-mono text-[0.65rem] font-semibold uppercase tracking-wide text-accent-ink">
                        {document.statusLabel}
                      </span>
                    )}
                  </div>
                  <p class="mt-3 break-words font-mono text-[0.62rem] leading-relaxed text-ink-soft sm:text-[0.68rem]">
                    {document.meta}
                  </p>
                  <p class="mt-3 hidden text-sm leading-relaxed text-ink-soft sm:block">
                    {document.description}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</section>

<section aria-labelledby="technical-reviews-heading" class="mt-24">
  <div class="max-w-3xl">
    <p class="font-mono text-xs text-accent-ink">Design review</p>
    <h3
      id="technical-reviews-heading"
      class="mt-3 text-2xl font-semibold tracking-tight text-ink"
    >
      Technical reviews
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
      These working sheets show how Harpa Pro records design coordination and
      factory drawing review. Original Revit files will replace these extracts.
    </p>
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-2">
    {
      technicalReviews.map((review) => (
        <figure
          data-technical-review
          class="overflow-hidden rounded-xl border border-hairline bg-card shadow-sm"
        >
          <button
            type="button"
            aria-label={`Open full view of ${review.title}`}
            class="evidence-image-trigger block w-full border-0 bg-white p-0 ring-focus"
            data-evidence-image-trigger
            data-evidence-image-src={review.image.src}
            data-evidence-image-alt={review.alt}
            data-evidence-image-title={review.title}
            data-evidence-image-caption={review.description}
            data-evidence-image-width={review.image.width}
            data-evidence-image-height={review.image.height}
          >
            <Image
              src={review.image}
              alt={review.alt}
              widths={[480, 720, 960, 1400]}
              sizes="(min-width: 48rem) 36rem, calc(100vw - 3rem)"
              format="webp"
              quality={90}
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full object-contain"
            />
          </button>
          <figcaption class="border-t border-hairline p-5">
            <h4 class="font-semibold text-ink">{review.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
              {review.description}
            </p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>


---
import { Image } from "astro:assets";
import chinaFactoryQualityControlImg from "../../assets/agents/china-factory-quality-control.jpg";
import chinaFurnitureProductionImg from "../../assets/agents/china-furniture-production.jpg";
import procurementInteriorImg from "../../assets/agents/procurement-interior.jpg";
import harunaImg from "../../assets/team/haruna.jpg";

const steps = [
  {
    title: "Meet Haruna",
    description:
      "Haruna reviews your brief, drawings, priorities, and finish requirements. She then makes a sourcing plan for the project.",
    image: harunaImg,
    alt: "Haruna Bayoh, the Harpa Pro procurement agent",
    position: "object-center",
  },
  {
    title: "Match the right factory",
    description:
      "Haruna identifies factories that suit the product, materials, quantity, and finish requirements.",
    image: chinaFurnitureProductionImg,
    alt: "Furniture production floor in China with machinery, stacked panels, and workers",
    position: "object-center",
  },
  {
    title: "Place the order",
    description:
      "The order moves into production after you confirm the scope, sample, price, and terms.",
    image: chinaFurnitureProductionImg,
    alt: "Stacked furniture panels ready for production in a factory in China",
    position: "object-center",
  },
  {
    title: "Track production",
    description:
      "Haruna follows the factory milestones and tells you when a change or delay needs a decision.",
    image: chinaFurnitureProductionImg,
    alt: "Workers and machinery on a furniture production floor in China",
    position: "object-center",
  },
  {
    title: "Check quality",
    description:
      "The finished work is checked against the agreed specification before shipment.",
    image: chinaFactoryQualityControlImg,
    alt: "Chinese quality inspector checking laminated furniture panels inside a production factory",
    position: "object-center",
  },
  {
    title: "Prepare shipment",
    description:
      "Haruna confirms the packing, quantities, documents, and collection details before the goods leave the factory.",
    image: chinaFurnitureProductionImg,
    alt: "Furniture panels and packing materials on a factory floor in China",
    position: "object-center",
  },
  {
    title: "Follow delivery",
    description:
      "Haruna follows the shipment through handover and delivery. She records any issues while the details are clear.",
    image: procurementInteriorImg,
    alt: "Finished furniture installed in a contemporary living room",
    position: "object-center",
  },
  {
    title: "Complete the handover",
    description:
      "You review what arrived and record any open issues. The order closes after the handover is complete.",
    image: procurementInteriorImg,
    alt: "Completed living room interior ready for final review",
    position: "object-center",
  },
];
---

<div data-journey class="mt-10 grid gap-5 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-8">
  <ol
    role="tablist"
    aria-label="Procurement journey"
    aria-orientation="vertical"
    class="grid content-start gap-2"
  >
    {
      steps.map((step, index) => (
        <li>
          <button
            id={`journey-tab-${index + 1}`}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`journey-panel-${index + 1}`}
            tabindex={index === 0 ? 0 : -1}
            data-journey-tab
            class="grid w-full grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-3 rounded-lg border border-transparent px-4 py-3 text-left text-sm text-ink-soft transition-colors hover:border-hairline hover:bg-card hover:text-ink aria-selected:border-accent aria-selected:bg-card aria-selected:font-medium aria-selected:text-ink aria-selected:shadow-sm ring-focus"
          >
            <span class="font-mono text-xs text-accent-ink">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span>{step.title}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="min-w-0">
    {
      steps.map((step, index) => (
        <article
          id={`journey-panel-${index + 1}`}
          role="tabpanel"
          aria-labelledby={`journey-tab-${index + 1}`}
          tabindex="0"
          hidden={index !== 0}
          data-journey-panel
          class="overflow-hidden rounded-xl border border-hairline bg-card shadow-sm ring-focus"
        >
          <Image
            src={step.image}
            alt={step.alt}
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 64rem) 48rem, calc(100vw - 3rem)"
            format="webp"
            quality={84}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            class={`aspect-[16/9] w-full object-cover ${step.position}`}
          />
          <div class="border-t border-hairline p-6 sm:p-8">
            <p class="font-mono text-xs text-accent-ink">
              Stage {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight text-ink">
              {step.title}
            </h3>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft sm:text-base">
              {step.description}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</div>

<script>
  function initializeJourney(root: HTMLElement) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-journey-tab]"),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>("[data-journey-panel]"),
    );

    function activate(index: number, moveFocus = false) {
      tabs.forEach((tab, tabIndex) => {
        const isSelected = tabIndex === index;
        tab.setAttribute("aria-selected", String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        const panel = panels[tabIndex];
        if (panel) panel.hidden = !isSelected;
      });

      const nextTab = tabs[index];
      if (moveFocus && nextTab) nextTab.focus();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(index));
      tab.addEventListener("keydown", (event) => {
        let nextIndex = index;

        if (event.key === "ArrowDown" || event.key === "ArrowRight") {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = tabs.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        activate(nextIndex, true);
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-journey]").forEach(initializeJourney);
</script>

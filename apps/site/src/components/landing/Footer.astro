---
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<footer class="border-t border-hairline">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-start md:justify-between">
    <div class="flex flex-col gap-2">
      <Wordmark />
      <p class="text-xs text-ink-soft">Technical procurement and factory records in China.</p>
      <p class="text-xs text-ink-soft">© {year} Harpa Pro</p>
    </div>
    <nav aria-label="Footer" class="flex flex-col gap-2 text-sm text-ink-soft sm:flex-row sm:gap-6">
      <a
        href="/"
        aria-current={currentPath === "/" ? "page" : undefined}
        class:list={["inline-flex min-h-11 items-center underline-offset-4 hover:text-ink hover:underline ring-focus", { "text-ink underline": currentPath === "/" }]}
      >Home</a>
      <a
        href="/how-to-buy-from-china"
        aria-current={currentPath === "/how-to-buy-from-china" ? "page" : undefined}
        class:list={["inline-flex min-h-11 items-center underline-offset-4 hover:text-ink hover:underline ring-focus", { "text-ink underline": currentPath === "/how-to-buy-from-china" }]}
      >How to Buy from China</a>
    </nav>
  </div>
</footer>

---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import Section from "../../components/primitives/Section.astro";
import Container from "../../components/primitives/Container.astro";
import Icon from "../../components/Icon.astro";
import Button from "../../components/primitives/Button.astro";
import Card from "../../components/primitives/Card.astro";
import SectionHeader from "../../components/primitives/SectionHeader.astro";
import { APP_STORE_URL } from "../../lib/reports/links";

const entries = (await getCollection("reportsRoadmap")).sort(
  (a, b) => a.data.order - b.data.order,
);

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      title: entry.data.title,
      icon: entry.data.icon,
      status: entry.data.status,
      Content,
    };
  }),
);

const groups: {
  id: "available" | "planned";
  label: string;
  heading: string;
  blurb: string;
}[] = [
  {
    id: "available",
    label: "Available Now",
    heading: "Current Reporting Workflow",
    blurb:
      "Harpa Pro focuses on one job: turning field captures into daily site reports.",
  },
  {
    id: "planned",
    label: "Planned",
    heading: "Planned Capability Areas",
    blurb:
      "Planned features will reuse field captures so crews do not have to record the same work twice.",
  },
];
---

<Layout
  section="reports"
  title="Site Reporting Roadmap | Harpa Pro"
  description="See the current Harpa Pro reporting workflow and the capabilities planned for future releases."
>
  <div class="min-h-screen bg-background text-ink">
    <Header section="reports" />
    <main id="main-content">
      <Section bordered="top">
        <Container padding="lg">
          <SectionHeader
            as="h1"
            eyebrow="Site Reporting Roadmap"
            title="Current and Planned Capabilities"
            ledeSize="base"
            lede="Harpa Pro turns site updates into daily reports. Planned work will use the same captures for materials, equipment, people, costs, and cross-project insights. Priorities may change as we learn from project teams."
          />
        </Container>
      </Section>

      {
        groups.map((group) => {
          const groupItems = items.filter((i) => i.status === group.id);
          if (groupItems.length === 0) return null;
          return (
            <Section
              tone={group.id === "available" ? "paper-2" : "default"}
              bordered="top"
            >
              <Container padding="lg">
                <SectionHeader
                  size="md"
                  eyebrow={group.label}
                  title={group.heading}
                  lede={group.blurb}
                />
                <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {groupItems.map(({ title, icon, Content }) => (
                    <Card>
                      <span class="grid h-9 w-9 place-items-center rounded-md border border-hairline bg-paper-2 text-ink">
                        <Icon name={icon} class="h-4 w-4" />
                      </span>
                      <h3 class="mt-4 text-base font-semibold text-ink">
                        {title}
                      </h3>
                      <div class="mt-1.5 text-sm leading-relaxed text-ink-soft">
                        <Content />
                      </div>
                    </Card>
                  ))}
                </div>
              </Container>
            </Section>
          );
        })
      }

      <Section bordered="top">
        <Container padding="lg">
          <div
            class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between"
          >
            <p class="text-sm text-ink-soft">
              Harpa Pro is available on the App Store. The guides explain the
              current site reporting workflow.
            </p>
            <div class="flex flex-wrap gap-3">
              <Button
                href="/reports/docs"
                variant="secondary"
                elevated={false}
                class="transition-colors"
              >
                View guides
              </Button>
              <Button
                href={APP_STORE_URL}
                external
                externalIcon={false}
                variant="outline-tinted"
                class="transition-colors"
              >
                Get the app
              </Button>
            </div>
          </div>
        </Container>
      </Section>
    </main>
    <Footer section="reports" />
  </div>
</Layout>

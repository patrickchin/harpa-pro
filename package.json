{
  "name": "harpa-pro",
  "version": "0.1.65",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "pnpm test:infra:neon && turbo run test",
    "test:infra:neon": "tsx --test infra/neon/branch.test.ts",
    "test:unit": "turbo run test:unit",
    "test:api": "pnpm --filter @harpa/api test",
    "test:api:integration": "pnpm --filter @harpa/api test:integration",
    "test:mobile": "pnpm --filter @harpa/mobile test",
    "test:docs:e2e": "pnpm --filter @harpa/site test:e2e",
    "lint": "turbo run lint && node scripts/run-bash-checks.cjs scripts/check-no-supabase.sh scripts/check-no-unistyles.sh scripts/check-scope-tests.sh scripts/check-spec-drift.sh scripts/check-maestro-appid.sh scripts/check-no-maestro-point-taps.sh scripts/check-native-input-smoke.sh scripts/check-no-process-env-r2.sh scripts/check-usage-limit-wiring.sh scripts/check-no-process-env-rate-limit.sh && node scripts/check-doc-links.mjs",
    "test:docs:links": "node scripts/check-doc-links.mjs",
    "typecheck": "turbo run typecheck",
    "gen:api": "pnpm --filter @harpa/api-contract gen:types && pnpm --filter @harpa/mobile gen:hooks",
    "spec:emit": "pnpm --filter @harpa/api spec:emit",
    "fixtures:record": "pnpm --filter @harpa/ai-fixtures record",
    "fixtures:replay": "AI_FIXTURE_MODE=replay pnpm test:api",
    "db:branch:create": "tsx infra/neon/branch.ts create",
    "db:branch:create-empty": "tsx infra/neon/branch.ts create-empty",
    "db:branch:delete": "tsx infra/neon/branch.ts delete",
    "db:branch:ensure": "tsx infra/neon/branch.ts ensure",
    "db:branch:uri": "tsx infra/neon/branch.ts uri",
    "db:branch:snapshot": "tsx infra/neon/branch.ts snapshot",
    "db:branch:prune-snapshots": "tsx infra/neon/branch.ts prune-snapshots",
    "secrets:pull:dev": "doppler secrets download --project harpa-pro --config dev --no-file --format env > .env.dev",
    "secrets:pull:prod": "doppler secrets download --project harpa-pro --config prd --no-file --format env > .env.prod",
    "secrets:push:dev": "doppler secrets upload --project harpa-pro --config dev .env.dev",
    "secrets:push:prod": "doppler secrets upload --project harpa-pro --config prd .env.prod",
    "format": "prettier --write .",
    "harpa": "pnpm --filter @harpa/cli dev --",
    "prepare": "husky",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^22.7.5",
    "husky": "^9.1.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "^5.6.2",
    "wrangler": "^4.125.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-native-css-interop@0.2.3": "patches/react-native-css-interop@0.2.3.patch"
    },
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
      "@grpc/grpc-js@>=1.14.0 <1.14.4": "1.14.4",
      "@types/react": "^19.2.0",
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "lodash@>=4.0.0 <4.18.0": "4.18.0",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "postcss@>=8.0.0 <8.5.23": "8.5.25",
      "protobufjs@>=7.0.0 <7.6.5": "7.6.5",
      "react": "19.2.0",
      "react-devtools-core>shell-quote": "1.10.0",
      "react-dom": "19.2.0",
      "react-native": "0.83.6",
      "react-native-reanimated": "4.2.1",
      "react-native-safe-area-context": "5.6.2",
      "react-native-screens": "4.23.0",
      "react-native-svg": "15.15.3",
      "react-native-worklets": "0.7.4",
      "react-test-renderer": "19.2.0",
      "svgo@>=4.0.0 <4.0.2": "4.0.2",
      "tmp@>=0.2.0 <0.2.7": "0.2.7",
      "undici@>=6.0.0 <6.28.0": "6.28.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.2",
      "yaml@>=2.0.0 <2.8.3": "2.9.0"
    }
  },
  "dependencies": {
    "expo": "~55.0.0",
    "react": "19.2.0",
    "react-native": "0.83.6"
  }
}

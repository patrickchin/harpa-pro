---
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 md:grid-cols-[minmax(14rem,1.4fr)_repeat(3,minmax(8rem,1fr))]"
  >
    <div class="flex flex-col gap-2">
      <Wordmark />
      <p class="text-xs text-ink-soft">
        Technical procurement and factory records in China.
      </p>
    </div>
    <nav aria-label="Procurement" class="grid content-start gap-2 text-xs text-ink-soft">
      <h2 class="font-semibold uppercase tracking-wider text-ink">Procurement</h2>
      <a href="/" class="rounded-sm hover:text-ink ring-focus">Overview</a>
      <a href="/#factory-partners" class="rounded-sm hover:text-ink ring-focus">Products and factories</a>
      <a href="/#considerations" class="rounded-sm hover:text-ink ring-focus">Our process</a>
      <a href="/procurement/how-to-buy-from-china" class="rounded-sm hover:text-ink ring-focus">How to Buy from China</a>
      <a href="/procurement/guides" class="rounded-sm hover:text-ink ring-focus">Procurement guides</a>
      <a href="/#contact" class="rounded-sm hover:text-ink ring-focus">Contact Us</a>
    </nav>
    <nav aria-label="Site Reporting" class="grid content-start gap-2 text-xs text-ink-soft">
      <h2 class="font-semibold uppercase tracking-wider text-ink">Site Reporting</h2>
      <a href="/reports" class="rounded-sm hover:text-ink ring-focus">Harpa Pro App</a>
      <a href="/reports/docs" class="rounded-sm hover:text-ink ring-focus">Guides</a>
      <a href="/reports/roadmap" class="rounded-sm hover:text-ink ring-focus">Roadmap</a>
      <a href="/reports/account-deletion" class="rounded-sm hover:text-ink ring-focus">Account Deletion</a>
    </nav>
    <nav aria-label="Company" class="grid content-start gap-2 text-xs text-ink-soft">
      <h2 class="font-semibold uppercase tracking-wider text-ink">Company</h2>
      <a href="/privacy" class="rounded-sm hover:text-ink ring-focus">Privacy</a>
      <a href="/#contact" class="rounded-sm hover:text-ink ring-focus">Contact</a>
      <span>© {year} Harpa Pro</span>
    </nav>
  </div>
</footer>

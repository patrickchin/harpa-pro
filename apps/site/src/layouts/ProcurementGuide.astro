---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import woodInteriorImg from "../assets/procurement/finishes/wood.webp";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import Container from "../components/primitives/Container.astro";
import Section from "../components/primitives/Section.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/luxury.css";
import { canonicalPathname } from "../lib/urls";

interface Props {
  headline: string;
  description: string;
  introduction?: string;
  seoTitle?: string;
  headings: { slug: string; text: string }[];
  showIndexBreadcrumb?: boolean;
  hero?: { image: ImageMetadata; alt: string; caption: string };
}

const {
  headline,
  description,
  introduction = description,
  seoTitle = `${headline} | Harpa Pro`,
  headings,
  showIndexBreadcrumb = true,
  hero = {
    image: woodInteriorImg,
    alt: "Generated living-room material concept with walnut joinery, pale stone, and linen upholstery",
    caption: "Generated material concept · Wood",
  },
} = Astro.props;
const homeUrl = new URL("/", Astro.site).href;
const articleUrl = new URL(canonicalPathname(Astro.url.pathname), Astro.site).href;
const imageAlt = hero.alt;
const socialImage = await getImage({
  src: hero.image,
  width: 1200,
  height: 630,
  format: "png",
});
const breadcrumbs = [
  { name: "Home", url: homeUrl },
  ...(showIndexBreadcrumb
    ? [{ name: "Procurement guides", url: new URL("/procurement/guides", Astro.site).href }]
    : []),
  { name: headline, url: articleUrl },
];
const structuredData = [
  {
    "@type": "Article",
    "@id": `${articleUrl}#article`,
    url: articleUrl,
    headline,
    description,
    inLanguage: "en",
    author: { "@id": `${homeUrl}#organization` },
    publisher: { "@id": `${homeUrl}#organization` },
    mainEntityOfPage: { "@id": `${articleUrl}#webpage` },
    image: new URL(socialImage.src, Astro.site).href,
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${articleUrl}#breadcrumbs`,
    itemListElement: breadcrumbs.map(({ name, url }, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name,
      item: url,
    })),
  },
];
---

<Layout
  title={seoTitle}
  description={description}
  image={socialImage.src}
  imageAlt={imageAlt}
  structuredData={structuredData}
  ogType="article"
>
  <div class="luxury-site procurement-guide min-h-screen bg-background text-ink">
    <Header />
    <main id="main-content">
      <Section id="top">
        <Container>
          <nav aria-label="Breadcrumb" class="docs-breadcrumbs">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            {showIndexBreadcrumb && <>
              <a href="/procurement/guides">Procurement guides</a>
              <span aria-hidden="true">/</span>
            </>}
            <span aria-current="page">{headline}</span>
          </nav>
          <article>
            <div class="guide-intro">
              <header>
                <p class="guide-audience">A guide for architects and interior designers</p>
                <h1 class:list={{ "guide-long-title": headline.length > 34 }}>{headline}</h1>
                <p class="guide-description">
                  {introduction}
                </p>
                <p class="guide-byline">By Harpa Pro</p>
              </header>
              <figure class="guide-material">
                <Image
                  src={hero.image}
                  alt={imageAlt}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 1024px) 460px, (min-width: 640px) 640px, calc(100vw - 32px)"
                  format="webp"
                  quality={84}
                  priority
                />
                <figcaption>{hero.caption}</figcaption>
              </figure>
            </div>
            <div class="guide-reading-layout">
              <nav aria-label="On this page" class="guide-contents">
                <p>On this page</p>
                <ol>
                  {headings.map(({ slug, text }) => (
                    <li>
                      <a href={`#${slug}`} class="ring-focus">{text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
              <div class="guide-reading-column">
                <div class="docs-prose article-copy">
                  <slot />
                </div>
                <p class="guide-browse">
                  <a href="/procurement/guides" class="ring-focus">Browse all procurement guides</a>
                </p>
                <aside aria-label="Procurement support" class="guide-support">
                  <p class="font-semibold">Need help coordinating your order?</p>
                  <p class="mt-2 text-ink-soft">
                    Send your materials schedule, drawings, quantities, and
                    destination to our procurement team.
                  </p>
                  <a href="/#contact" class="mt-4 inline-flex min-h-11 items-center font-semibold text-accent-ink underline underline-offset-4 ring-focus">
                    Contact Harpa Pro
                  </a>
                </aside>
              </div>
            </div>
          </article>
        </Container>
      </Section>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .procurement-guide {
    color: var(--luxury-walnut);
  }

  .docs-breadcrumbs {
    color: var(--luxury-muted);
  }

  .guide-intro {
    align-items: center;
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .guide-audience,
  .guide-byline,
  .guide-material figcaption {
    color: var(--luxury-muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .guide-audience {
    color: var(--accent-ink);
    font-weight: 600;
  }

  .guide-intro h1 {
    font-family: var(--font-sans);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-top: 1rem;
    max-width: 9em;
    text-wrap: balance;
  }

  .guide-intro h1.guide-long-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    max-width: 20ch;
  }

  .guide-description {
    color: var(--luxury-muted);
    font-size: 1rem;
    line-height: 1.75;
    margin-top: 1.5rem;
    max-width: 34rem;
  }

  .guide-byline {
    margin-top: 1.5rem;
  }

  .guide-material img {
    aspect-ratio: 2 / 1;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .guide-material figcaption {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
  }

  .guide-reading-layout {
    border-top: 1px solid var(--border);
    display: grid;
    gap: 2.5rem;
    padding-top: 2.5rem;
  }

  .guide-contents > p {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .guide-contents ol {
    display: grid;
  }

  .guide-contents a {
    align-items: center;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    display: flex;
    font-size: 0.8125rem;
    line-height: 1.6;
    min-height: 2.75rem;
    padding: 0.65rem 0;
  }

  .guide-contents a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .guide-reading-column {
    min-width: 0;
    max-width: 44rem;
  }

  .article-copy {
    color: var(--luxury-walnut);
    font-size: 1.0625rem;
    margin-top: 0;
  }

  .article-copy :global(> :first-child) {
    margin-top: 0;
  }

  .article-copy :global(h2) {
    border-top: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 3rem 0 1rem;
    padding-top: 2rem;
  }

  .article-copy :global(h2),
  .article-copy :global(h3) {
    scroll-margin-top: 6rem;
  }

  .article-copy :global(a) {
    overflow-wrap: anywhere;
  }

  .article-copy :global(.procurement-table-scroll) {
    margin: 1.5rem 0;
    max-width: 100%;
    overflow-x: auto;
  }

  .article-copy :global(.procurement-table-scroll:focus-visible) {
    outline: 2px solid var(--accent-ink);
    outline-offset: 3px;
  }

  .article-copy :global(table) {
    border-collapse: collapse;
    font-size: 1rem;
    width: 100%;
  }

  .article-copy :global(th),
  .article-copy :global(td) {
    border-bottom: 1px solid var(--border);
    min-width: 9rem;
    padding: 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .article-copy :global(th) {
    background: var(--background);
    font-weight: 600;
  }

  .article-copy :global(pre) {
    max-width: 100%;
    overflow-x: auto;
  }

  .guide-browse {
    line-height: 1.75;
    margin-top: 2rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .guide-support {
    border-top: 1px solid var(--border);
    line-height: 1.75;
    margin-top: 3rem;
    padding-top: 1.5rem;
  }

  @media (min-width: 64rem) {
    .guide-intro {
      gap: 4rem;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      padding-bottom: 4rem;
    }

    .guide-material img {
      aspect-ratio: 16 / 10;
    }

    .guide-reading-layout {
      gap: 4rem;
      grid-template-columns: 15rem minmax(0, 1fr);
      padding-top: 3rem;
    }

    .guide-contents {
      align-self: start;
      max-height: calc(100dvh - 7rem);
      overflow-y: auto;
      position: sticky;
      top: 6rem;
    }
  }
</style>

---
import Wordmark from "./Wordmark.astro";
import Icon from "../Icon.astro";
---

<header
  class="sticky top-0 z-40 border-b border-hairline bg-paper-2/90 backdrop-blur"
>
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6"
  >
    <Wordmark />
    <nav aria-label="Primary" class="hidden items-center gap-5 md:flex">
      <a
        href="/procurement"
        class="text-sm text-ink-soft hover:text-ink transition-colors"
      >
        Procurement
      </a>

      <details class="site-reporting-menu group relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 text-sm text-ink-soft transition-colors hover:text-ink ring-focus [&::-webkit-details-marker]:hidden"
        >
          Site reporting
          <Icon
            name="chevron-down"
            class="h-3.5 w-3.5 transition-transform group-open:rotate-180"
          />
        </summary>
        <div
          class="absolute left-1/2 top-full z-50 mt-3 grid w-48 -translate-x-1/2 gap-1 rounded-xl border border-hairline bg-background p-2 shadow-lg"
        >
          <a
            href="/app"
            class="rounded-md px-3 py-2 text-sm text-ink hover:bg-secondary"
          >
            Overview
          </a>
          <a
            href="/docs"
            class="rounded-md px-3 py-2 text-sm text-ink hover:bg-secondary"
          >
            Guides
          </a>
          <a
            href="/roadmap"
            class="rounded-md px-3 py-2 text-sm text-ink hover:bg-secondary"
          >
            Roadmap
          </a>
        </div>
      </details>

      <a
        href="/procurement#contact"
        class="inline-flex h-9 items-center rounded-md bg-accent px-4 text-sm font-medium text-accent-foreground shadow-sm transition-[filter] hover:brightness-95 ring-focus"
      >
        Contact Haruna
      </a>
    </nav>

    {/* No-JS mobile menu via <details>/<summary>. The panel is
        absolute-positioned so it overlays content below the sticky
        header — the source's React version pushed content down by
        re-rendering as a sibling of the row, which we cannot do
        here without scripting (a `<summary>` must be a direct child
        of its `<details>`, and we want the toggle inside the row).
        Cosmetic delta is negligible (no layout shift on toggle);
        documented as an intentional, scripted-equivalent change. */}
    <details class="md:hidden site-menu group">
      <summary
        aria-label="Toggle menu"
        class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-md border border-hairline text-ink [&::-webkit-details-marker]:hidden"
      >
        <Icon name="menu" class="h-4 w-4 group-open:hidden" />
        <Icon name="x" class="hidden h-4 w-4 group-open:block" />
      </summary>
      <div
        class="absolute inset-x-0 top-16 border-t border-hairline bg-background"
      >
        <div class="mx-auto grid max-w-6xl gap-4 p-4">
          <div class="grid gap-1">
            <p class="px-3 text-xs font-semibold uppercase tracking-wider text-ink-soft">
              Procurement
            </p>
            <a
              href="/procurement"
              class="rounded-md px-3 py-2 text-sm text-ink hover:bg-secondary"
            >
              Procurement
            </a>
            <a
              href="/procurement#considerations"
              class="rounded-md px-3 py-2 text-sm text-ink hover:bg-secondary"
            >
              What we consider
            </a>
            <a
              href="/procurement#evidence"
              class="rounded-md px-3 py-2 text-sm text-ink hover:bg-secondary"
            >
              Project evidence
            </a>
            <a
              href="/procurement#contact"
              class="rounded-md px-3 py-2 text-sm font-medium text-accent-ink hover:bg-secondary"
            >
              Contact Haruna
            </a>
          </div>
          <div class="grid gap-1 border-t border-hairline pt-4" data-mobile-site-reporting>
            <p class="px-3 text-xs font-semibold uppercase tracking-wider text-ink-soft">
              Site reporting
            </p>
            <a
              href="/app"
              class="rounded-md px-3 py-2 text-sm text-ink hover:bg-secondary"
            >
              Overview
            </a>
            <a
              href="/docs"
              class="rounded-md px-3 py-2 text-sm text-ink hover:bg-secondary"
            >
              Guides
            </a>
            <a
              href="/roadmap"
              class="rounded-md px-3 py-2 text-sm text-ink hover:bg-secondary"
            >
              Roadmap
            </a>
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

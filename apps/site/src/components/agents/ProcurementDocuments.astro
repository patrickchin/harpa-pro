---
import Icon from "../Icon.astro";

const factories = [
  {
    name: "AIS Factory Furniture",
    category: "Cabinetry and whole-house furniture",
    documents: ["CE", "E1", "REACH", "VOC"],
  },
  {
    name: "Langyao Factory LED Lighting",
    category: "LED bulkhead and panel lights",
    documents: ["CE", "LVD", "RoHS"],
  },
  {
    name: "Mingyuan Factory Floor Panels",
    category: "SPC floor panels",
    documents: ["CE", "E1", "Fire test", "VOC"],
  },
  {
    name: "JLA Factory Ceramic Tiles",
    category: "Ceramic tiles",
    documents: ["CE", "Performance report", "Test report"],
  },
];
---

<div class="max-w-3xl">
  <p class="text-xs font-semibold uppercase tracking-wider text-accent-ink">
    Project information
  </p>
  <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
    Technical package
  </h2>
  <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">
    The project record combines technical drawings, product specifications,
    factory documents, inspections, and shipping records.
  </p>
</div>

<div class="mt-10 grid gap-5 lg:grid-cols-2">
  <article class="rounded-xl border border-hairline bg-card p-6 shadow-sm sm:p-8">
    <p class="font-mono text-xs text-accent-ink">Technical drawings</p>
    <h3 class="mt-3 text-xl font-semibold text-ink">
      Project-specific Revit files
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
      Each project package can contain Revit sheets, 3D views, shop drawings,
      and specification schedules.
    </p>
    <dl class="mt-6 grid gap-3 border-t border-hairline pt-5 text-sm">
      <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-3">
        <dt class="text-ink-soft">File status</dt>
        <dd class="font-medium text-ink">Source PDFs pending</dd>
      </div>
      <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-3">
        <dt class="text-ink-soft">Issued by</dt>
        <dd class="font-medium text-ink">Project</dd>
      </div>
    </dl>
  </article>

  <article class="rounded-xl border border-hairline bg-card p-6 shadow-sm sm:p-8">
    <p class="font-mono text-xs text-accent-ink">Current PDF</p>
    <h3 class="mt-3 text-xl font-semibold text-ink">
      Interior procurement overview
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
      The nine-page document contains the service scope, workflow, sample Revit
      sheets, factory profiles, and supplied document scans.
    </p>
    <a
      href="/downloads/harpa-pro-interior-procurement.pdf"
      download
      class="mt-6 inline-flex h-11 items-center gap-2 rounded-md border border-primary/30 bg-card px-5 text-sm font-medium text-primary shadow-sm transition-colors hover:bg-primary hover:text-primary-foreground ring-focus"
    >
      Download procurement PDF
      <Icon name="download" class="h-4 w-4" />
    </a>
  </article>
</div>

<div class="mt-14">
  <div class="max-w-3xl">
    <p class="font-mono text-xs text-accent-ink">Factory records</p>
    <h3 class="mt-3 text-2xl font-semibold tracking-tight text-ink">
      Factory document register
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
      The register lists the documents supplied for each product category. It
      does not replace a project-specific compliance review.
    </p>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {
      factories.map((factory) => (
        <article
          data-factory-record
          class="rounded-xl border border-hairline bg-card p-6 shadow-sm"
        >
          <h4 class="text-lg font-semibold text-ink">{factory.name}</h4>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">
            {factory.category}
          </p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${factory.name} documents`}>
            {factory.documents.map((document) => (
              <li class="rounded-full border border-hairline bg-paper-2 px-3 py-1 font-mono text-xs text-ink-soft">
                {document}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</div>

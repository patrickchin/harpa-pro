---
import { Image } from "astro:assets";
import ProcurementDocuments from "../components/agents/ProcurementDocuments.astro";
import ProcurementJourney from "../components/agents/ProcurementJourney.astro";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Container from "../components/primitives/Container.astro";
import Section from "../components/primitives/Section.astro";
import Layout from "../layouts/Layout.astro";
import procurementInteriorImg from "../assets/agents/procurement-interior.jpg";
import harunaImg from "../assets/team/haruna.jpg";
---

<Layout
  title="Interior procurement in China — Harpa Pro"
  description="Interior procurement in China, with technical specifications, factory records, quality control, shipping documents, and project approvals."
>
  <div class="min-h-screen bg-background text-ink">
    <Header />
    <main class="agents-page">
      <section class="border-b border-hairline">
        <Container padding="lg">
          <div
            class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(30rem,1.1fr)] lg:gap-16"
          >
            <div class="max-w-3xl">
              <p class="text-xs font-semibold uppercase tracking-wider text-accent-ink">
                Harpa Pro procurement
              </p>
              <h1
                class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.4rem] lg:leading-[1.05]"
              >
                Interior procurement in China.
              </h1>
              <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
                Haruna Bayoh manages technical specifications, factory
                coordination, quality control, shipping records, and project
                approvals from China.
              </p>
            </div>

            <figure class="overflow-hidden rounded-xl border border-hairline bg-card shadow-sm">
              <Image
                src={procurementInteriorImg}
                alt="Contemporary living room with stone, timber, and fabric samples arranged for review"
                widths={[480, 720, 960, 1200]}
                sizes="(min-width: 64rem) 50vw, calc(100vw - 3rem)"
                format="webp"
                quality={84}
                loading="eager"
                decoding="async"
                class="aspect-[3/2] w-full object-cover"
              />
            </figure>
          </div>

          <aside
            aria-labelledby="agent-role-heading"
            class="mt-8 rounded-xl border border-hairline bg-card p-6 shadow-sm lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-8"
          >
            <div>
              <p class="font-mono text-xs text-ink-soft">Service scope</p>
              <h2 id="agent-role-heading" class="mt-3 text-xl font-semibold text-ink">
                Procurement coordination.
              </h2>
            </div>
            <ul
              class="mt-5 grid gap-3 text-sm leading-relaxed text-ink-soft sm:grid-cols-2 lg:mt-0"
            >
              <li class="border-t border-hairline pt-3">
                Translate design intent into production specifications
              </li>
              <li class="border-t border-hairline pt-3">
                Review factory capability and supplied documents
              </li>
              <li class="border-t border-hairline pt-3">
                Record inspections before and during production
              </li>
              <li class="border-t border-hairline pt-3">
                Coordinate shipping documents and approval records
              </li>
            </ul>
          </aside>
        </Container>
      </section>

      <Section id="agent" bordered="top">
        <Container padding="lg">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent-ink">
              Procurement lead
            </p>
            <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
              Haruna Bayoh
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">
              Haruna applies architecture and materials experience to the
              technical and production stages of each order.
            </p>
          </div>

          <article
            data-agent-profile
            class="mt-10 grid max-w-3xl gap-6 rounded-xl border border-hairline bg-card p-6 shadow-sm sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-start"
          >
            <Image
              src={harunaImg}
              alt="Haruna Bayoh"
              width={320}
              height={320}
              densities={[1, 2]}
              class="aspect-square w-36 rounded-xl object-cover"
            />

            <div class="min-w-0">
              <h3 class="text-xl font-semibold text-ink">Haruna Bayoh</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                Architecture and material procurement
              </p>
              <dl class="mt-6 grid gap-3 border-t border-hairline pt-5 text-sm">
                <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3">
                  <dt class="text-ink-soft">Education</dt>
                  <dd class="font-medium text-ink">Master's degree</dd>
                </div>
                <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3">
                  <dt class="text-ink-soft">Experience</dt>
                  <dd class="font-medium text-ink">6 years</dd>
                </div>
              </dl>
            </div>
          </article>
        </Container>
      </Section>

      <Section id="journey" tone="paper-2" bordered="top">
        <Container padding="lg">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent-ink">
              Controlled process
            </p>
            <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
              Procurement workflow.
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">
              Each stage records the checks, documents, and approvals required
              before the order moves forward.
            </p>
          </div>

          <ProcurementJourney />
        </Container>
      </Section>

      <Section id="documents" bordered="top">
        <Container padding="lg">
          <ProcurementDocuments />
        </Container>
      </Section>
    </main>
    <Footer />
  </div>
</Layout>

---
import Icon from "../Icon.astro";
import WaitlistFormIsland from "./WaitlistFormIsland";
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";

/*
 * M1: the form is now a real React island (`WaitlistFormIsland.tsx`)
 * that posts directly to `POST {PUBLIC_API_BASE_URL}/waitlist`.
 *
 * The product-updates copy + grid layout stay in this Astro file; only
 * the inner `<form>` is hydrated. We use `client:only="react"`
 * (not `client:visible`) because `@marsidev/react-turnstile` touches
 * browser globals during module init — SSR is impossible. The
 * fallback below is what users see for the few-hundred-ms before
 * hydration.
 */
---

<Section id="waitlist">
  <Container>
    <div
      class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-8 rounded-xl border border-hairline bg-card p-5 shadow-[var(--shadow-raised)] sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]"
    >
      <div class="min-w-0">
        <span class="site-eyebrow">
          Product updates
        </span>
        <h2 class="site-section-title mt-2 text-ink">
          Need Android, web, or team rollout updates?
        </h2>
        <p class="mt-4 text-base leading-6 text-ink-soft">
          The iPhone app is live now. Leave your email if you want Android,
          web, or team workflow updates as they open.
        </p>
        <ul class="mt-5 space-y-3 text-sm leading-5 text-ink">
          <li class="flex items-start gap-2">
            <Icon name="circle-check" class="mt-0.5 h-4 w-4 text-emerald-500" />
            Android pilot and web companion updates
          </li>
          <li class="flex items-start gap-2">
            <Icon name="circle-check" class="mt-0.5 h-4 w-4 text-emerald-500" />
            Notes on team workflows and office-facing features
          </li>
          <li class="flex items-start gap-2">
            <Icon name="circle-check" class="mt-0.5 h-4 w-4 text-emerald-500" />
            Direct line to the team building it
          </li>
        </ul>
      </div>

      <WaitlistFormIsland client:only="react">
        <div
          slot="fallback"
          class="min-w-0 rounded-lg border border-hairline bg-paper-2 p-5 text-sm text-ink-soft"
          aria-busy="true"
        >
          Loading signup form…
        </div>
      </WaitlistFormIsland>
    </div>
  </Container>
</Section>

---
import Section from "../primitives/Section.astro";
import Container from "../primitives/Container.astro";
import { Image } from "astro:assets";
import harunaImg from "../../assets/team/haruna.jpg";
import patrickImg from "../../assets/team/patrick.jpg";

const team = [
  {
    name: "Haruna Bayoh",
    avatar: harunaImg,
    blurb:
      "Haruna has a BEng in Civil Engineering and an MEng in Structural Engineering. He has worked in building design and prefabricated construction. He is a researcher at Zhejiang University.",
  },
  {
    name: "Patrick Chin",
    avatar: patrickImg,
    blurb:
      "Patrick is a senior software engineer who works on real-time systems, platforms, and machine-learning integration. He has an MSc in Physics from University College London.",
  },
];
---

<Section id="about" bordered="top">
  <Container padding="lg">
    <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      The Team Behind Harpa Pro
    </h2>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        team.map((member) => (
          <div class="flex flex-col items-start gap-5 rounded-xl border border-hairline bg-card p-6 sm:flex-row sm:gap-6">
            <Image
              src={member.avatar}
              alt={member.name}
              width={320}
              height={320}
              densities={[1, 2]}
              class="h-32 w-32 flex-none rounded-full object-cover sm:h-36 sm:w-36"
            />
            <div class="flex flex-col gap-2">
              <h3 class="text-base font-semibold text-ink">
                {member.name}
              </h3>
              <p class="text-sm leading-relaxed text-ink-soft">
                {member.blurb}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</Section>

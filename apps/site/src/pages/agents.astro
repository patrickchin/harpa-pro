---
import { Image } from "astro:assets";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Container from "../components/primitives/Container.astro";
import Section from "../components/primitives/Section.astro";
import Layout from "../layouts/Layout.astro";
import harunaImg from "../assets/team/haruna.jpg";

const processSteps = [
  "Choose an agent",
  "Select a factory",
  "Place the order",
  "Monitor procurement",
  "Confirm quality",
  "Confirm shipment",
  "Confirm delivery",
  "Sign off",
];

const agents = [
  {
    name: "Haruna Bayoh",
    focus: "Architecture and material procurement",
    education: "Master's degree",
    experience: "6 years",
    portrait: harunaImg,
    initials: null,
  },
  {
    name: "Hashy",
    focus: "Material procurement",
    education: "Bachelor's degree",
    experience: "4 years",
    portrait: null,
    initials: "H",
  },
];
---

<Layout
  title="Procurement agents — Harpa Pro"
  description="Meet Harpa Pro procurement agents and see the journey from design brief and factory selection through quality checks, delivery, and sign-off."
>
  <div class="min-h-screen bg-background text-ink">
    <Header />
    <main class="agents-page">
      <section class="border-b border-hairline">
        <Container
          padding="lg"
          class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(18rem,0.7fr)] lg:gap-16"
        >
          <div class="max-w-3xl">
            <p
              class="text-xs font-semibold uppercase tracking-wider text-accent-ink"
            >
              Procurement agents
            </p>
            <h1
              class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.4rem] lg:leading-[1.05]"
            >
              Procurement support from brief to delivery.
            </h1>
            <p
              class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg"
            >
              Work with specialists who understand design intent, material
              sourcing, and manufacturing in China. Your agent helps translate
              the brief, identify suitable factories, and keep each stage
              moving through sign-off.
            </p>
          </div>

          <aside
            aria-labelledby="agent-role-heading"
            class="rounded-xl border border-hairline bg-card p-6 shadow-sm"
          >
            <p class="font-mono text-xs text-ink-soft">Agent role</p>
            <h2 id="agent-role-heading" class="mt-3 text-xl font-semibold text-ink">
              One point of coordination.
            </h2>
            <ul class="mt-5 grid gap-3 text-sm leading-relaxed text-ink-soft">
              <li class="border-t border-hairline pt-3">
                Translate design specifications
              </li>
              <li class="border-t border-hairline pt-3">
                Match the project with suitable factories
              </li>
              <li class="border-t border-hairline pt-3">
                Track procurement and product quality
              </li>
              <li class="border-t border-hairline pt-3">
                Coordinate shipment and delivery milestones
              </li>
            </ul>
          </aside>
        </Container>
      </section>

      <Section id="process" tone="paper-2" bordered="top">
        <Container padding="lg">
          <div class="max-w-2xl">
            <p
              class="text-xs font-semibold uppercase tracking-wider text-accent-ink"
            >
              The journey
            </p>
            <h2
              class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
            >
              Eight clear stages, one continuous handover.
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">
              Follow the work from the first introduction to final acceptance,
              with every handover made explicit.
            </p>
          </div>

          <ol
            aria-label="Procurement journey"
            class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"
          >
            {
              processSteps.map((step, index) => (
                <li class="min-h-36 rounded-xl border border-hairline bg-card p-5 shadow-sm">
                  <span class="font-mono text-xs text-accent-ink">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3 class="mt-7 text-base font-semibold leading-snug text-ink">
                    {step}
                  </h3>
                </li>
              ))
            }
          </ol>
        </Container>
      </Section>

      <Section id="agents" bordered="top">
        <Container padding="lg">
          <div class="max-w-2xl">
            <p
              class="text-xs font-semibold uppercase tracking-wider text-accent-ink"
            >
              The people
            </p>
            <h2
              class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
            >
              Meet your procurement agents.
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">
              Compare each agent's background and experience to understand who
              is best aligned with your project.
            </p>
          </div>

          <div class="mt-10 grid gap-5 lg:grid-cols-2">
            {
              agents.map((agent) => (
                <article
                  data-agent-profile
                  class="grid gap-6 rounded-xl border border-hairline bg-card p-6 shadow-sm sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-start"
                >
                  {agent.portrait ? (
                    <Image
                      src={agent.portrait}
                      alt={agent.name}
                      width={320}
                      height={320}
                      densities={[1, 2]}
                      class="aspect-square w-36 rounded-xl object-cover"
                    />
                  ) : (
                    <div
                      aria-hidden="true"
                      class="grid aspect-square w-36 place-items-center rounded-xl border border-hairline bg-paper-2 text-4xl font-semibold text-ink"
                    >
                      {agent.initials}
                    </div>
                  )}

                  <div class="min-w-0">
                    <h3 class="text-xl font-semibold text-ink">{agent.name}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                      {agent.focus}
                    </p>
                    <dl class="mt-6 grid gap-3 border-t border-hairline pt-5 text-sm">
                      <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3">
                        <dt class="text-ink-soft">Education</dt>
                        <dd class="font-medium text-ink">{agent.education}</dd>
                      </div>
                      <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3">
                        <dt class="text-ink-soft">Experience</dt>
                        <dd class="font-medium text-ink">{agent.experience}</dd>
                      </div>
                    </dl>
                  </div>
                </article>
              ))
            }
          </div>
        </Container>
      </Section>
    </main>
    <Footer />
  </div>
</Layout>

---
import "@fontsource-variable/inter";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  pageType?: "WebPage" | "CollectionPage" | "TechArticle";
  structuredData?: Record<string, unknown>[];
}

const {
  title = "Interior Procurement in China | Harpa Pro",
  description = "Harpa Pro coordinates interior procurement in China, from design specifications and factory coordination to quality checks, shipping, and project records.",
  image = "/og-image.png",
  imageAlt = "Harpa Pro",
  noindex = false,
  ogType = "website",
  pageType = "WebPage",
  structuredData = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname.replace(/\/+$/, "") || "/", Astro.site);
const ogImageUrl = new URL(image, Astro.site);
const homeUrl = new URL("/", Astro.site).href;
const organizationId = `${homeUrl}#organization`;
const websiteId = `${homeUrl}#website`;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Harpa Pro",
      url: homeUrl,
      logo: new URL("/brand-icon.svg", Astro.site).href,
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Harpa Pro",
      url: homeUrl,
      inLanguage: "en",
      publisher: { "@id": organizationId },
    },
    {
      "@type": pageType,
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl.href,
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": websiteId },
      ...(pageType === "TechArticle" && {
        headline: title,
        author: { "@id": organizationId },
      }),
    },
    ...structuredData,
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
    />
    <meta name="theme-color" content="#e55d22" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <title>{title}</title>
    {!noindex && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Harpa Pro" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
  </body>
</html>

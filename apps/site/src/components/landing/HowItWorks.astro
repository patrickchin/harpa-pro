---
import Icon from "../Icon.astro";
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";

const steps = [
  {
    title: "Capture the day",
    body: "Add text notes, photos, and voice updates from the field, in the moment, with one tap.",
    icon: "mic",
  },
  {
    title: "Generate the report",
    body: "Turn the day's captures into a clean, organized report ready to review, edit, and share.",
    icon: "file-text",
  },
  {
    title: "Review and export",
    body: "Check the draft, make edits, then export or share the finished daily report.",
    icon: "clipboard-check",
  },
];
---

<Section id="how">
  <Container>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-2xl">
      <span class="site-eyebrow">
        How it works
      </span>
      <h2 class="site-section-title mt-2 text-ink">
        Three steps from boots to report.
      </h2>
    </div>
  </div>

  <ol
    class="mt-8 grid gap-3 sm:grid-cols-3"
  >
    {
      steps.map((s, i) => (
        <li class="rounded-lg border border-hairline bg-card p-5 shadow-[var(--shadow-raised)]">
          <div class="flex items-center justify-between">
            <span class="grid h-10 w-10 place-items-center rounded-lg bg-primary text-primary-foreground">
              <Icon name={s.icon} class="h-4 w-4" />
            </span>
            <span class="font-mono text-xs text-ink-soft">0{i + 1}</span>
          </div>
          <h3 class="mt-4 text-base font-bold leading-6 text-ink">{s.title}</h3>
          <p class="mt-2 text-sm leading-5 text-ink-soft">{s.body}</p>
        </li>
      ))
    }
  </ol>
  </Container>
</Section>

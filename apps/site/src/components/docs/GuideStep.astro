---
import type { DocsScreenshotId } from "../../lib/docs";
import GuideStepMedia from "./GuideStepMedia.astro";

type WithScreenshot = {
  screenshot: DocsScreenshotId;
  screenshotAlt: string;
};

type WithoutScreenshot = {
  screenshot?: never;
  screenshotAlt?: never;
};

type Props = {
  number: number;
  title: string;
} & (WithScreenshot | WithoutScreenshot);

const { number, title, screenshot, screenshotAlt } = Astro.props;
const hasMedia = Boolean(screenshot && screenshotAlt);
---

<section class:list={["docs-step", { "docs-step--with-media": hasMedia }]}>
  <div class="docs-step-copy">
    <header>
      <span aria-hidden="true">{number}</span>
      <h2>{title}</h2>
    </header>
    <div class="docs-step-body"><slot /></div>
  </div>
  {
    screenshot && screenshotAlt && (
      <GuideStepMedia
        screenshot={screenshot}
        alt={screenshotAlt}
        stepTitle={title}
      />
    )
  }
</section>

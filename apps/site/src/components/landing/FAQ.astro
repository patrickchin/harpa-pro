---
import { getCollection, render } from "astro:content";
import Section from "../primitives/Section.astro";
import Container from "../primitives/Container.astro";
import Icon from "../Icon.astro";

const entries = (await getCollection("faq")).sort(
  (a, b) => a.data.order - b.data.order,
);

// Render MDX bodies with their default Content components.
const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { question: entry.data.question, Content };
  }),
);
---

<Section id="faq" tone="paper-2" bordered="top">
  <Container padding="lg">
    <div class="max-w-2xl">
      <span class="site-eyebrow">
        Questions
      </span>
      <h2 class="site-section-title mt-2 text-ink">
        Things teams ask before trying Harpa Pro.
      </h2>
    </div>

    <div
      class="mt-8 grid overflow-hidden rounded-lg border border-hairline bg-card shadow-[var(--shadow-raised)] divide-y divide-[color:var(--color-border)]"
    >
      {
        items.map(({ question, Content }) => (
          <details class="group px-5 py-3">
            <summary
              class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-base font-bold leading-6 text-ink ring-focus [&::-webkit-details-marker]:hidden"
            >
              <span class="leading-snug">{question}</span>
              <span
                aria-hidden="true"
                class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-hairline bg-paper-2 text-ink-soft transition-transform group-open:rotate-45"
              >
                <Icon name="plus" class="h-3.5 w-3.5" />
              </span>
            </summary>
            <div class="pb-2 pt-2 text-sm leading-5 text-ink-soft prose-p:m-0">
              <Content />
            </div>
          </details>
        ))
      }
    </div>
  </Container>
</Section>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/landing/Header.astro";
import Footer from "../components/landing/Footer.astro";
import Container from "../components/primitives/Container.astro";
import { PRIVACY_POLICY_URL } from "../lib/legal";
---

<Layout
  title="Privacy Policy | Harpa Pro"
  description="Harpa Pro privacy policy for the website and mobile application."
>
  <div class="min-h-screen bg-background text-ink">
    <Header hideCta />
    <main>
      <Container padding="md" class="space-y-6">
        <div class="space-y-3">
          <p class="site-eyebrow">
            Legal
          </p>
          <h1 class="site-page-title text-ink">
            Privacy Policy
          </h1>
          <p class="max-w-3xl text-base leading-6 text-ink-soft">
            The policy below is hosted by Termly and reflects the current
            privacy notice for the Harpa Pro website and mobile application.
          </p>
          <a
            href={PRIVACY_POLICY_URL}
            class="inline-flex min-h-11 items-center rounded-md text-sm font-bold text-accent-ink hover:text-ink ring-focus"
          >
            Open the hosted policy
          </a>
        </div>
        <iframe
          src={PRIVACY_POLICY_URL}
          title="Harpa Pro Privacy Policy"
          class="h-[72vh] min-h-[680px] w-full rounded-md border border-hairline bg-white"
          loading="lazy"
        ></iframe>
      </Container>
    </main>
    <Footer />
  </div>
</Layout>

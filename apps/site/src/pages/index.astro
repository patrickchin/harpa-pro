---
import Layout from "../layouts/Layout.astro";
import Header from "../components/landing/Header.astro";
import Hero from "../components/landing/Hero.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import Features from "../components/landing/Features.astro";
import FAQ from "../components/landing/FAQ.astro";
import About from "../components/landing/About.astro";
import WaitlistForm from "../components/landing/WaitlistForm.astro";
import Footer from "../components/landing/Footer.astro";
---

<Layout
  title="Harpa Pro — Site reports by voice"
  description="Use Harpa Pro to turn voice notes, photos, and field updates into daily construction reports you can review, edit, finalize, and share."
>
  <div class="min-h-screen bg-background text-ink">
    <Header />
    <main>
      <Hero />
      <HowItWorks />
      <Features />
      <About />
      <FAQ />
      <WaitlistForm />
    </main>
    <Footer />
  </div>
</Layout>

# Marketing site — local development environment variables.
# Astro inlines PUBLIC_* vars at build time. Rename this to .env for local dev.
# For deploys, these are passed inline at build time by the CI workflows
# (see .github/workflows/marketing-dev.yml and marketing-prod.yml).
# See repo root .env.example for the full reference.

# Base URL for the waitlist API.
# local: http://localhost:8787  dev: https://harpa-pro-api-dev.fly.dev  prod: https://api.harpapro.com
PUBLIC_API_BASE_URL=http://localhost:8787

# Cloudflare Turnstile site key (public). The default is Cloudflare's
# always-passes test key, safe for local dev and the dev environment.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

---
import { getCollection, render } from "astro:content";
import Icon from "../Icon.astro";
import Section from "../primitives/Section.astro";
import Container from "../primitives/Container.astro";

const entries = (await getCollection("features")).sort(
  (a, b) => a.data.order - b.data.order,
);

const feats = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { title: entry.data.title, icon: entry.data.icon, Content };
  }),
);
---

<Section tone="paper-2" bordered="top">
  <Container padding="lg">
    <div class="max-w-2xl">
      <span class="site-eyebrow">
        What you get
      </span>
      <h2 class="site-section-title mt-2 text-ink">
        What's in the app now.
      </h2>
      <p class="mt-4 max-w-[68ch] text-base leading-6 text-ink-soft">
        The first iPhone release focuses on one job, done well:
        AI-generated daily site reports from voice, photos, and notes.
        Inventory, equipment, people, money, and cross-project insights
        are on the <a
          href="/roadmap"
          class="font-medium text-primary underline-offset-4 hover:underline"
          >roadmap</a
        >.
      </p>
    </div>
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        feats.map(({ title, icon, Content }) => (
          <div class="rounded-lg border border-hairline bg-card p-5 shadow-[var(--shadow-raised)]">
            <span class="grid h-10 w-10 place-items-center rounded-lg border border-hairline bg-paper-2 text-ink">
              <Icon name={icon} class="h-4 w-4" />
            </span>
            <h3 class="mt-4 text-base font-bold leading-6 text-ink">{title}</h3>
            <div class="mt-1 text-sm leading-5 text-ink-soft prose-p:m-0">
              <Content />
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</Section>

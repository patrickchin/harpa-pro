---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  id?: string;
  /** A muted band may separate adjacent content groups. */
  tone?: "default" | "paper-2";
  /** Optional structural boundary. */
  bordered?: boolean | "top" | "y";
}

const {
  id,
  tone = "default",
  bordered = false,
  class: extra = "",
  ...rest
} = Astro.props;

const toneCls = tone === "paper-2" ? "bg-paper-2" : "";

const borderCls =
  bordered === true || bordered === "y"
    ? "border-y border-hairline"
    : bordered === "top"
      ? "border-t border-hairline"
      : "";

const cls = [toneCls, borderCls, extra].filter(Boolean).join(" ");
---

<section id={id} class={cls} {...rest}><slot /></section>

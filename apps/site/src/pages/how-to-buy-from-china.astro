---
import { getImage, Image } from "astro:assets";
import woodInteriorImg from "../assets/agents/finishes/wood.webp";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Container from "../components/primitives/Container.astro";
import Section from "../components/primitives/Section.astro";
import Content, { getHeadings } from "../content/articles/how-to-buy-from-china.mdx";
import Layout from "../layouts/Layout.astro";
import "../styles/luxury.css";

const headline = "How to buy from China";
const description = "A practical guide for architects and interior designers buying from China: import requirements, factory checks, quotations, samples, payments, and inspection.";
const homeUrl = new URL("/", Astro.site).href;
const articleUrl = new URL("/how-to-buy-from-china", Astro.site).href;
const imageAlt = "Generated living-room material concept with walnut joinery, pale stone, and linen upholstery";
const socialImage = await getImage({
  src: woodInteriorImg,
  width: 1200,
  height: 630,
  format: "png",
});
const headings = getHeadings().filter(({ depth }) => depth === 2);
const breadcrumbs = [
  { name: "Home", url: homeUrl },
  { name: headline, url: articleUrl },
];
const structuredData = [
  {
    "@type": "Article",
    "@id": `${articleUrl}#article`,
    url: articleUrl,
    headline,
    description,
    inLanguage: "en",
    author: { "@id": `${homeUrl}#organization` },
    publisher: { "@id": `${homeUrl}#organization` },
    mainEntityOfPage: { "@id": `${articleUrl}#webpage` },
    image: new URL(socialImage.src, Astro.site).href,
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${articleUrl}#breadcrumbs`,
    itemListElement: breadcrumbs.map(({ name, url }, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name,
      item: url,
    })),
  },
];
---

<Layout
  title="How to Buy from China for Architects and Interior Designers | Harpa Pro"
  description={description}
  image={socialImage.src}
  imageAlt={imageAlt}
  structuredData={structuredData}
  ogType="article"
>
  <div class="luxury-site procurement-guide min-h-screen bg-background text-ink">
    <Header />
    <main id="main-content">
      <Section id="top">
        <Container>
          <nav aria-label="Breadcrumb" class="docs-breadcrumbs">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{headline}</span>
          </nav>
          <article>
            <div class="guide-intro">
              <header>
                <p class="guide-audience">A guide for architects and interior designers</p>
                <h1>{headline}</h1>
                <p class="guide-description">
                  A practical way to import from China, from finding a factory
                  and checking production capability to payments, quality
                  inspection, and shipping to your country.
                </p>
                <p class="guide-byline">By Harpa Pro</p>
              </header>
              <figure class="guide-material">
                <Image
                  src={woodInteriorImg}
                  alt={imageAlt}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 1024px) 460px, (min-width: 640px) 640px, calc(100vw - 32px)"
                  format="webp"
                  quality={84}
                  priority
                />
                <figcaption>Generated material concept · Wood</figcaption>
              </figure>
            </div>
            <div class="guide-reading-layout">
              <nav aria-label="On this page" class="guide-contents">
                <p>On this page</p>
                <ol>
                  {headings.map(({ slug, text }) => (
                    <li>
                      <a href={`#${slug}`} class="ring-focus">{text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
              <div class="guide-reading-column">
                <div class="docs-prose article-copy">
                  <Content />
                </div>
                <aside aria-label="Procurement support" class="guide-support">
                  <p class="font-semibold">Need help coordinating your order?</p>
                  <p class="mt-2 text-ink-soft">
                    Send your materials schedule, drawings, quantities, and
                    destination to our procurement team.
                  </p>
                  <a href="/#contact" class="mt-4 inline-flex min-h-11 items-center font-semibold text-accent-ink underline underline-offset-4 ring-focus">
                    Contact Harpa Pro
                  </a>
                </aside>
              </div>
            </div>
          </article>
        </Container>
      </Section>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .procurement-guide {
    color: var(--luxury-walnut);
  }

  .docs-breadcrumbs {
    color: var(--luxury-muted);
  }

  .guide-intro {
    align-items: center;
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .guide-audience,
  .guide-byline,
  .guide-material figcaption {
    color: var(--luxury-muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .guide-audience {
    color: var(--accent-ink);
    font-weight: 600;
  }

  .guide-intro h1 {
    font-family: var(--luxury-serif);
    font-size: clamp(3.25rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin-top: 1rem;
    max-width: 9em;
    text-wrap: balance;
  }

  .guide-description {
    color: var(--luxury-muted);
    font-size: 1rem;
    line-height: 1.75;
    margin-top: 1.5rem;
    max-width: 34rem;
  }

  .guide-byline {
    margin-top: 1.5rem;
  }

  .guide-material img {
    aspect-ratio: 2 / 1;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .guide-material figcaption {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
  }

  .guide-reading-layout {
    border-top: 1px solid var(--border);
    display: grid;
    gap: 2.5rem;
    padding-top: 2.5rem;
  }

  .guide-contents > p {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .guide-contents ol {
    display: grid;
  }

  .guide-contents a {
    align-items: center;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    display: flex;
    font-size: 0.8125rem;
    line-height: 1.6;
    min-height: 2.75rem;
    padding: 0.65rem 0;
  }

  .guide-contents a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .guide-reading-column {
    min-width: 0;
    max-width: 44rem;
  }

  .article-copy {
    color: var(--luxury-walnut);
    font-size: 1.0625rem;
    margin-top: 0;
  }

  .article-copy :global(> :first-child) {
    margin-top: 0;
  }

  .article-copy :global(h2) {
    border-top: 1px solid var(--border);
    font-family: var(--luxury-serif);
    font-size: clamp(2rem, 3vw, 2.6rem);
    font-weight: 500;
    line-height: 1.15;
    margin: 3rem 0 1rem;
    padding-top: 2rem;
  }

  .article-copy :global(h2),
  .article-copy :global(h3) {
    scroll-margin-top: 6rem;
  }

  .guide-support {
    border-top: 1px solid var(--border);
    line-height: 1.75;
    margin-top: 3rem;
    padding-top: 1.5rem;
  }

  @media (min-width: 64rem) {
    .guide-intro {
      gap: 4rem;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      padding-bottom: 4rem;
    }

    .guide-material img {
      aspect-ratio: 16 / 10;
    }

    .guide-reading-layout {
      gap: 4rem;
      grid-template-columns: 15rem minmax(0, 1fr);
      padding-top: 3rem;
    }

    .guide-contents {
      align-self: start;
      max-height: calc(100dvh - 7rem);
      overflow-y: auto;
      position: sticky;
      top: 6rem;
    }
  }
</style>

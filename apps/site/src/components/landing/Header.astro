---
import Wordmark from "./Wordmark.astro";
import Icon from "../Icon.astro";
import Button from "../primitives/Button.astro";
import Container from "../primitives/Container.astro";
import { APP_STORE_URL } from "../../lib/links";

interface Props {
  hideCta?: boolean;
}

const { hideCta = false } = Astro.props;
---

<header
  class="sticky top-0 z-40 border-b border-hairline bg-paper-2/90 backdrop-blur"
>
  <Container padding="none" class="flex h-16 items-center justify-between">
    <Wordmark />
    <nav class="hidden items-center gap-4 md:flex">
      <a
        href="/roadmap"
        class="inline-flex min-h-11 items-center rounded-md px-3 text-sm text-ink-soft transition-colors hover:bg-secondary hover:text-ink ring-focus"
      >
        Roadmap
      </a>
      <a
        href="/docs"
        class="inline-flex min-h-11 items-center rounded-md px-3 text-sm text-ink-soft transition-colors hover:bg-secondary hover:text-ink ring-focus"
      >
        Docs
      </a>
      {
        !hideCta && (
        <Button
          href={APP_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="ghost"
        >
          Download iOS app
        </Button>
        )
      }
    </nav>

    {/* No-JS mobile menu via <details>/<summary>. The panel is
        absolute-positioned so it overlays content below the sticky
        header — the source's React version pushed content down by
        re-rendering as a sibling of the row, which we cannot do
        here without scripting (a `<summary>` must be a direct child
        of its `<details>`, and we want the toggle inside the row).
        Cosmetic delta is negligible (no layout shift on toggle);
        documented as an intentional, scripted-equivalent change. */}
    <details class="md:hidden site-menu group">
      <summary
        aria-label="Toggle menu"
        class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-md border border-hairline bg-card text-ink ring-focus [&::-webkit-details-marker]:hidden"
      >
        <Icon name="menu" class="h-4 w-4 group-open:hidden" />
        <Icon name="x" class="hidden h-4 w-4 group-open:block" />
      </summary>
      <div
        class="absolute inset-x-0 top-16 border-t border-hairline bg-background"
      >
        <div class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-4 sm:px-6">
          <a
            href="/roadmap"
            class="flex min-h-11 items-center rounded-md px-3 text-sm text-ink hover:bg-secondary ring-focus"
          >
            Roadmap
          </a>
          <a
            href="/docs"
            class="flex min-h-11 items-center rounded-md px-3 text-sm text-ink hover:bg-secondary ring-focus"
          >
            Docs
          </a>
          {!hideCta && (
            <Button
              href={APP_STORE_URL}
              target="_blank"
              rel="noopener noreferrer"
              variant="ghost"
              class="mt-1"
            >
              Download iOS app
            </Button>
          )}
        </div>
      </div>
    </details>
  </Container>
</header>

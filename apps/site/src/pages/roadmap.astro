---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/landing/Header.astro";
import Footer from "../components/landing/Footer.astro";
import Section from "../components/primitives/Section.astro";
import Container from "../components/primitives/Container.astro";
import Button from "../components/primitives/Button.astro";
import Icon from "../components/Icon.astro";
import { APP_STORE_URL } from "../lib/links";

const entries = (await getCollection("roadmap")).sort(
  (a, b) => a.data.order - b.data.order,
);

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      title: entry.data.title,
      icon: entry.data.icon,
      status: entry.data.status,
      Content,
    };
  }),
);

const groups: {
  id: "available" | "planned";
  label: string;
  heading: string;
  blurb: string;
}[] = [
  {
    id: "available",
    label: "Available now",
    heading: "What you can use today.",
    blurb:
      "The iPhone app focuses on doing one thing well: AI-generated daily site reports.",
  },
  {
    id: "planned",
    label: "Planned",
    heading: "Where it's going.",
    blurb:
      "Built on the same field captures — so the office sees more without crews doing more work.",
  },
];
---

<Layout
  title="Roadmap — Harpa Pro"
  description="What's next for Harpa Pro after the iPhone launch: Android, full offline mode, materials, inventory, equipment, people, money, and the insights dashboard."
>
  <div class="min-h-screen bg-background text-ink">
    <Header />
    <main>
      <Section bordered="top">
        <Container padding="lg">
          <div class="max-w-2xl">
            <span class="site-eyebrow">
              Roadmap
            </span>
            <h1 class="site-page-title mt-2 text-ink">
              Where Harpa Pro is going.
            </h1>
            <p class="mt-4 max-w-[68ch] text-base leading-6 text-ink-soft">
              The iPhone app is live with the core workflow: turning
              voice, photos, and notes into clean AI-generated daily
              reports. Everything below builds on those same captures
              — so the office gets inventory, equipment, people,
              money, and cross-project insights without crews doing
              more work on site. Dates aren't promises; order can
              shift based on what teams need most.
            </p>
          </div>
        </Container>
      </Section>

      {
        groups.map((group) => {
          const groupItems = items.filter((i) => i.status === group.id);
          if (groupItems.length === 0) return null;
          return (
            <Section
              tone={group.id === "available" ? "paper-2" : "default"}
              bordered="top"
            >
              <Container padding="lg">
                <div class="max-w-2xl">
                  <span class="site-eyebrow">
                    {group.label}
                  </span>
                  <h2 class="site-section-title mt-2 text-ink">
                    {group.heading}
                  </h2>
                  <p class="mt-3 text-base leading-6 text-ink-soft">
                    {group.blurb}
                  </p>
                </div>
                <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {groupItems.map(({ title, icon, Content }) => (
                    <div class="rounded-lg border border-hairline bg-card p-5 shadow-[var(--shadow-raised)]">
                      <span class="grid h-10 w-10 place-items-center rounded-lg border border-hairline bg-paper-2 text-ink">
                        <Icon name={icon} class="h-4 w-4" />
                      </span>
                      <h3 class="mt-4 text-base font-bold leading-6 text-ink">
                        {title}
                      </h3>
                      <div class="mt-1 text-sm leading-5 text-ink-soft prose-p:m-0">
                        <Content />
                      </div>
                    </div>
                  ))}
                </div>
              </Container>
            </Section>
          );
        })
      }

      <Section bordered="top">
        <Container padding="lg">
          <div
            class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between"
          >
            <p class="text-sm text-ink-soft">
              Want the current iPhone app? Download it from the App Store.
              Need Android or web? Join the updates list on the home page.
            </p>
            <Button
              href={APP_STORE_URL}
              target="_blank"
              rel="noopener noreferrer"
              variant="ghost"
            >
              Download iOS app
            </Button>
          </div>
        </Container>
      </Section>
    </main>
    <Footer />
  </div>
</Layout>

---
import { Image } from "astro:assets";
import Card from "../primitives/Card.astro";
import { lightboxImage } from "../../lib/lightbox-image";
import { factoryDocuments } from "../../lib/procurement/factory-documents";

const lightboxes = await Promise.all(
  factoryDocuments.map((document) => lightboxImage(document.image)),
);
---

<div id="factory-document-grid" class="grid gap-4 sm:gap-5 md:grid-cols-3">
  {
    factoryDocuments.map((document, index) => (
      <Card
        data-credential-record=""
        as="article"
        padding="none"
        elevated
        class="overflow-hidden"
      >
        <button
          type="button"
          aria-label={`Open full view of ${document.title}`}
          class="evidence-image-trigger block w-full border-0 bg-white p-0 ring-focus"
          data-evidence-image-trigger
          data-evidence-image-src={lightboxes[index]!.src}
          data-evidence-image-alt={document.alt}
          data-evidence-image-title={document.title}
          data-evidence-image-caption={`${document.meta}. ${document.description}`}
          data-evidence-image-width={lightboxes[index]!.width}
          data-evidence-image-height={lightboxes[index]!.height}
        >
          <div data-document-preview-crop class="aspect-[21/10] w-full overflow-hidden">
            <Image
              src={document.image}
              alt={document.alt}
              widths={[320, 480, 640]}
              sizes="(min-width: 72rem) 23rem, (min-width: 48rem) 31vw, calc(100vw - 2rem)"
              format="webp"
              quality={92}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-top"
            />
          </div>
        </button>
        <div class="border-t border-hairline p-4 sm:p-5">
          <h2 class="text-sm font-semibold leading-snug text-ink sm:text-base">
            {document.title}
          </h2>
          <p class="mt-2 text-xs font-medium text-ink">{document.source}</p>
          <p class="mt-2 break-words font-mono text-xs leading-relaxed text-ink-soft">
            {document.meta}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{document.description}</p>
        </div>
      </Card>
    ))
  }
</div>

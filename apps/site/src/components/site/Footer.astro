---
import Icon from "../Icon.astro";
import Wordmark from "./Wordmark.astro";
import { ALSO_FROM_LABEL, SECTIONS, type SiteSection } from "../../lib/site/sections";

interface Props {
  section: SiteSection;
}

const { section } = Astro.props;
const config = SECTIONS[section];
const { crossLink } = config;
const year = new Date().getFullYear();

const linkClass =
  "inline-flex min-h-11 items-center gap-1.5 rounded-sm py-1 text-sm text-ink-soft transition-colors hover:text-ink ring-focus md:min-h-9";
---

<footer class="border-t border-hairline" data-site-footer>
  <div
    class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-8 px-4 py-10 sm:px-6 md:grid-cols-3 md:gap-x-10 lg:grid-cols-[minmax(14rem,1.4fr)_repeat(3,minmax(9rem,1fr))]"
  >
    <div class="col-span-2 flex flex-col gap-3 md:col-span-3 lg:col-span-1">
      <Wordmark href={config.home} />
      <p class="max-w-xs text-sm leading-relaxed text-ink-soft">
        {config.footer.tagline}
      </p>
    </div>
    {
      config.footer.columns.map((column) => (
        <nav aria-label={column.label} class="min-w-0">
          <h2 class="mb-1 text-xs font-semibold uppercase tracking-wider text-ink">
            {column.label}
          </h2>
          <ul class="grid">
            {column.links.map((link) => (
              <li>
                {link.external ? (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}
                  >
                    {link.label}
                    <Icon name="arrow-up-right" class="h-3.5 w-3.5 shrink-0" />
                  </a>
                ) : (
                  <a href={link.href} class={linkClass}>
                    {link.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    {
      crossLink && (
        <nav aria-label={ALSO_FROM_LABEL} class="min-w-0">
          <h2 class="mb-1 text-xs font-semibold uppercase tracking-wider text-ink">
            {ALSO_FROM_LABEL}
          </h2>
          <ul class="grid">
            <li>
              <a
                href={crossLink.href}
                class={linkClass}
                data-audience-switch
                data-audience-from={section}
                data-audience-to={crossLink.to}
                data-audience-location="footer"
              >
                {crossLink.label}
              </a>
            </li>
          </ul>
        </nav>
      )
    }
  </div>
  <div class="border-t border-hairline">
    <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
      <p class="text-sm text-ink-soft" data-footer-copyright>
        <small class="text-sm">© {year} Harpa Pro</small>
      </p>
    </div>
  </div>
</footer>

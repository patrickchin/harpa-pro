---
import type { CollectionEntry } from "astro:content";

import DocsSidebar from "../components/docs/DocsSidebar.astro";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  guides: CollectionEntry<"docs">[];
  currentSlug?: string;
  currentTitle?: string;
}

const { title, description, guides, currentSlug, currentTitle } = Astro.props;
---

<Layout title={`${title} | Harpa Pro`} description={description}>
  <div class="min-h-screen bg-background text-ink">
    <Header hideCta />
    <div class="docs-shell">
      <details class="docs-mobile-nav">
        <summary>Browse guides</summary>
        <DocsSidebar guides={guides} currentSlug={currentSlug} />
      </details>

      <div class="docs-columns">
        <aside class="docs-desktop-nav">
          <a class="docs-home-link" href="/docs">Harpa Pro guides</a>
          <DocsSidebar guides={guides} currentSlug={currentSlug} />
        </aside>

        <main class="docs-main" id="main-content">
          <nav aria-label="Breadcrumb" class="docs-breadcrumbs">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            {
              currentTitle ? (
                <>
                  <a href="/docs">Guides</a>
                  <span aria-hidden="true">/</span>
                  <span aria-current="page">{currentTitle}</span>
                </>
              ) : (
                <span aria-current="page">Guides</span>
              )
            }
          </nav>
          <slot />
        </main>
      </div>
    </div>
    <Footer />
  </div>
</Layout>

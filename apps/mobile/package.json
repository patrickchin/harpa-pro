{
  "name": "@harpa/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "ios": "expo run:ios",
    "ios:mock": "EXPO_PUBLIC_USE_FIXTURES=true expo run:ios",
    "android": "expo run:android",
    "start": "expo start --dev-client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --ext .ts,.tsx",
    "build": "echo 'mobile build (EAS) — see infra/'",
    "bundle:smoke": "bash scripts/bundle-smoke.sh",
    "gen:hooks": "tsx scripts/gen-hooks.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0",
    "@harpa/api-contract": "workspace:*",
    "@harpa/report-core": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "expo": "~55.0.25",
    "expo-audio": "^55.0.14",
    "expo-camera": "^55.0.18",
    "expo-clipboard": "^55.0.13",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "^55.0.35",
    "expo-file-system": "^55.0.21",
    "expo-image": "^55.0.10",
    "expo-image-manipulator": "^55.0.16",
    "expo-image-picker": "^55.0.20",
    "expo-linking": "~55.0.15",
    "expo-media-library": "^55.0.17",
    "expo-router": "~55.0.15",
    "expo-secure-store": "^55.0.14",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "^55.0.23",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "~0.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.14",
    "zod": "^3.23.8"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "clsx"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "^19.0.0",
    "react-test-renderer": "19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vitest": "^2.1.2"
  }
}

---
import AppStoreBadge from "./AppStoreBadge.astro";
import Button from "../primitives/Button.astro";
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";
import SectionHeader from "../primitives/SectionHeader.astro";
---

<Section id="get-the-app" bordered="top" data-closing-cta>
  <Container padding="lg">
    <div
      class="flex flex-col gap-8 rounded-2xl border border-hairline bg-card p-6 shadow-sm sm:p-10 lg:flex-row lg:items-center lg:justify-between"
    >
      <SectionHeader
        width="xl"
        title="Try Harpa Pro on your next site visit"
        lede="Download the app, capture today's site updates, and review the report draft before you share it."
      />
      <div class="flex flex-col items-start gap-5 lg:items-end">
        <AppStoreBadge />
        <div class="flex flex-wrap gap-3">
          <Button href="/reports/docs" variant="outline" size="md">
            View guides
          </Button>
          <Button href="/reports/roadmap" variant="outline" size="md">
            View roadmap
          </Button>
        </div>
      </div>
    </div>
  </Container>
</Section>

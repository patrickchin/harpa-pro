{
  "name": "@harpa/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "ios": "expo run:ios",
    "ios:mock": "EXPO_PUBLIC_USE_FIXTURES=true expo run:ios",
    "android": "expo run:android",
    "start": "expo start --dev-client",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:nocoverage": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --ext .ts,.tsx",
    "build": "echo 'mobile build (EAS) — see infra/'",
    "bundle:smoke": "bash scripts/bundle-smoke.sh",
    "gen:hooks": "tsx scripts/gen-hooks.ts"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.13",
    "@expo/metro-runtime": "~56.0.18",
    "@harpa/api-contract": "workspace:*",
    "@harpa/report-core": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "^8.13.0",
    "@tanstack/query-async-storage-persister": "^5.100.14",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-persist-client": "^5.100.14",
    "better-auth": "^1.6.13",
    "clsx": "^2.1.1",
    "expo": "~56.0.18",
    "expo-asset": "~56.0.21",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.24",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-file-system": "~56.0.8",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.23",
    "expo-image-picker": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-localization": "~56.0.6",
    "expo-media-library": "~56.0.10",
    "expo-network": "~56.0.5",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.17",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.23",
    "i18n-iso-countries": "^7.14.0",
    "libphonenumber-js": "^1.13.3",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.7",
    "react-native-pager-view": "8.0.1",
    "react-native-pdf": "^7.0.4",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.14",
    "zod": "^3.23.8"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "clsx"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native",
        "typescript"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}

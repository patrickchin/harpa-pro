---
import { getCollection, render } from "astro:content";
import Section from "../primitives/Section.astro";
import Container from "../primitives/Container.astro";
import Card from "../primitives/Card.astro";
import SectionHeader from "../primitives/SectionHeader.astro";

const entries = (await getCollection("reportsFaq")).sort(
  (a, b) => a.data.order - b.data.order,
);

// Render MDX bodies with their default Content components.
const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { question: entry.data.question, Content };
  }),
);
---

<Section id="faq" tone="paper-2" bordered="top">
  <Container padding="lg">
    <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
      <SectionHeader title="Questions" width="md" />

      <Card padding="none" class="overflow-hidden">
        <dl class="divide-y divide-[color:var(--color-border)]">
          {
            items.map(({ question, Content }) => (
              <div class="p-5 sm:p-6">
                <dt class="text-base font-semibold leading-snug text-ink">
                  {question}
                </dt>
                <dd class="mt-2 text-sm leading-relaxed text-ink-soft">
                  <Content />
                </dd>
              </div>
            ))
          }
        </dl>
      </Card>
    </div>
  </Container>
</Section>

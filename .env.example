# =============================================================================
# harpa-pro — environment variables reference
# =============================================================================
# This file lists the application and common deployment variables.
# Workspace-specific files can add test or tool variables. Never put secrets here.
#
# Three live variants (all gitignored):
#   .env.local  — local development (API on localhost, mobile → localhost)
#   .env.dev    — dev deployment    (harpa-pro-api-dev on Fly, Neon `dev` branch)
#   .env.prod   — prod deployment   (harpa-pro-api on Fly, Neon `main` branch)
#
# For local use:  cp .env.example .env.local  then fill in your values.
# For deploying:  copy the relevant section into .env.dev or .env.prod.
#
# Sections:
#   §A  API — @harpa/api (Fly secrets + local API server)
#   §B  Astro browser apps — apps/site and apps/admin (Cloudflare Pages)
#   §C  Mobile — apps/mobile (Expo config and Metro variables)
#   §D  CLI — apps/cli
#   §E  Infrastructure — Neon, Fly, Cloudflare, and Sentry (CI secrets + scripts)
# =============================================================================


# =============================================================================
# §A — API  (@harpa/api — packages/api/src/env.ts)
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=8787

# ── Database ─────────────────────────────────────────────────────────────────
# Pooled Neon connection URI. Get with:
#   neonctl connection-string <branch> --project-id <id> --pooled
# local:  use the Neon `dev` branch or a local Postgres instance
# dev:    Neon `dev` branch pooled URI
# prod:   Neon `main` branch pooled URI
DATABASE_URL=

# Direct (unpooled) connection URI for the independent `harpa-pro-admin`
# Neon project and its `harpa_admin` database. Never point this at the
# application project. The admin migrator requires a direct connection.
# local:  a separate local Postgres instance or database server
# dev:    admin project `dev` branch
# prod:   admin project `main` branch
ADMIN_DATABASE_URL=

# Optional read-only Neon inventory for the dedicated admin operations page.
# Provision a dedicated Neon user with organization role Viewer, or role
# Collaborator plus explicit project-level Viewer grants. Then set BOTH
# variables in the API runtime.
# Keep these commented out when inventory is disabled; blank values fail boot.
# Never reuse the CI-only NEON_API_KEY below, which can manage preview branches.
# ADMIN_NEON_VIEWER_API_KEY=
# ADMIN_NEON_ORG_ID=

# Optional read-only Cloudflare R2 capacity observer for the dedicated admin
# operations page. Set BOTH values in the API runtime. Keep them commented out
# when the observer is disabled; blank values fail boot.
# Provision a dedicated, account-scoped token with only Workers R2 Storage Read
# and Account Analytics: Read. The analytics permission has a broader read
# surface, so use a bounded TTL and Client IP filtering when egress is stable.
# Never reuse R2 S3 credentials or Cloudflare CI/Pages tokens.
# ADMIN_CLOUDFLARE_ACCOUNT_ID=
# ADMIN_CLOUDFLARE_R2_OBSERVER_API_TOKEN=

# Optional read-only Fly inventory for the dedicated admin operations page.
# Set all three values together in the API runtime; keep them commented out
# when disabled because blank values fail boot. Provision a dedicated token
# with `fly tokens create readonly --org <org>` for the reviewed organization,
# never a deploy, CI, or interactive-login token. App names are the exact
# allowlist, with one to ten unique lowercase DNS-label values.
# ADMIN_FLY_ORG_SLUG=harpa-pro
# ADMIN_FLY_READ_ONLY_API_TOKEN=
# ADMIN_FLY_APP_NAMES=harpa-pro-api,harpa-pro-api-dev

# ── Auth (better-auth) ───────────────────────────────────────────────────────
# Development fallback only. NODE_ENV=production rejects this value and
# requires an explicit secret of at least 32 characters, including PR previews.
# Generate 32 random bytes as hex: openssl rand -hex 32
BETTER_AUTH_SECRET=dev-only-secret-do-not-use-in-prod
# Public URL the API is reachable at (used in auth redirect URLs)
# local: http://localhost:8787  dev: https://harpa-pro-api-dev.fly.dev  prod: https://api.harpapro.com
BETTER_AUTH_URL=http://localhost:8787
# Exact browser origins allowed to send credentialed dedicated /admin requests.
# Better Auth browser cookies are not trusted by the admin console.
# local: http://localhost:3102  dev: the stable dev admin origin
# prod: https://admin.harpapro.com (never a wildcard or preview hostname)
ADMIN_CORS_ORIGINS=http://localhost:3102

# ── Email OTP (better-auth + Resend) ─────────────────────────────────────────
# Set to 1 in prod/dev to send real sign-in codes through Resend. Leave 0
# locally/test to log/no-op codes. Fly prod/dev must set this to 1.
EMAIL_OTP_LIVE=0
# Set automatically only for per-PR Fly previews. It permits fixture-backed
# services, but does not relax the production Better Auth secret requirement.
HARPAPRO_PR_BUILD=0
# Shared by email OTP and waitlist mail.
RESEND_API_KEY=

# ── Demo account access ─────────────────────────────────────────────────────
# Public demo emails skip OTP on mobile and use password sign-in.
# DEMO_ACCOUNT_EMAILS may include demo@harpapro.com, demo2@harpapro.com,
# and/or demo3@harpapro.com. Never bundle DEMO_ACCOUNT_PASSWORD into mobile.
DEMO_ACCOUNT_EMAILS=
DEMO_ACCOUNT_PASSWORD=

# ── Test-account password bypass ─────────────────────────────────────────────
# Live-deployment smoke-test escape hatch. Both vars MUST be set together.
# Only emails explicitly listed here can use /api/auth/sign-in/email.
# See docs/v4/arch-auth-and-rls.md §Test-account password bypass.
TEST_ACCOUNT_EMAILS=test@harpapro.com,test2@harpapro.com,test3@harpapro.com
TEST_ACCOUNT_PASSWORD=        # min 16 chars; hashed by better-auth

# Optional fixed synthetic target for the manual admin report-generation
# diagnostic. Set all three values together, and include the diagnostic email
# in TEST_ACCOUNT_EMAILS. The route reuses TEST_ACCOUNT_PASSWORD server-side.
# Keep these commented out to return typed unknown/not_configured without an
# application request. Never point the diagnostic at a customer report.
# ADMIN_REPORT_DIAGNOSTIC_EMAIL=report-canary@e2e.harpapro.com
# ADMIN_REPORT_DIAGNOSTIC_PROJECT_ID=prj_01234567
# ADMIN_REPORT_DIAGNOSTIC_REPORT_NUMBER=7
# Cost-bearing live report canary. Keep disabled unless a separately approved
# dev rollout supplies the exact target and live deployment correlation.
ADMIN_REPORT_LIVE_CANARY_ENABLED=0

# ── AI providers ─────────────────────────────────────────────────────────────
# Fly prod/dev must set both live switches below. Leave live calls off locally.
# When AI_LIVE=1, both OPENAI_API_KEY and GROQ_API_KEY are required (env.ts asserts).
# Split: OpenAI handles chat + report generation; Groq handles transcription
# (whisper-large-v3-turbo, ~10× cheaper than OpenAI Whisper).
AI_LIVE=0
# Parsed for compatibility. The API currently selects live or replay from AI_LIVE.
AI_FIXTURE_MODE=replay        # replay | record | live
OPENAI_API_KEY=
OPENAI_BASE_URL=              # optional; defaults to https://api.openai.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=                # optional; defaults to https://api.groq.com/openai/v1
# Kimi (Moonshot) adapter credentials. The adapter remains available to
# packages/ai-fixtures, but the current product whitelist cannot select it.
# These values are optional and are not required for normal API traffic.
KIMI_API_KEY=
KIMI_BASE_URL=                # optional; defaults to https://api.moonshot.cn/v1

# ── Cloudflare R2 (file storage) ─────────────────────────────────────────────
# Fly prod/dev must use 'live'; local/test/PR previews may use 'replay'.
# Live mode validates its endpoint and credentials at API boot.
R2_FIXTURE_MODE=replay
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional alternative to R2_ACCOUNT_ID, primarily for local S3-compatible mocks.
R2_ENDPOINT=
# Optional client-facing endpoint for local container networking only.
R2_PUBLIC_ENDPOINT=
# Presigned PUT/GET lifetime in seconds. The API rejects values above 300.
R2_PRESIGN_TTL_SEC=300
# local/dev: harpa-pro-dev   prod: harpa-pro
R2_BUCKET=harpa-pro-dev

# ── Cloudflare Turnstile (bot protection) ─────────────────────────────────────
# Required as 1 in Fly prod/dev; live mode requires its secret at API boot.
# Leave 0 locally (uses Cloudflare's always-passes test key).
TURNSTILE_LIVE=0
TURNSTILE_SECRET_KEY=

# ── Resend (waitlist transactional email) ───────────────────────────────────
# Required as 1 in Fly prod/dev; live mode requires RESEND_API_KEY at API boot.
RESEND_LIVE=0

# ── Waitlist (M1) ─────────────────────────────────────────────────────────────
WAITLIST_FROM_EMAIL=Harpa Pro <hello@harpapro.com>
# Where confirmation emails link to. Must match the marketing site URL.
# local: http://localhost:3002/confirm  dev: https://dev.harpa-pro.pages.dev/confirm  prod: https://harpapro.com/confirm
WAITLIST_CONFIRM_BASE_URL=http://localhost:3002/confirm
# Random hex salt (16+ bytes). Never rotate in prod — forfeits de-dupe history.
# Generate with: openssl rand -hex 32
WAITLIST_IP_HASH_SALT=dev-only-waitlist-salt-do-not-use-in-prod
# Comma-separated allowed CORS origins for POST /waitlist (no spaces).
# local: http://localhost:3002  dev: https://dev.harpa-pro.pages.dev  prod: https://harpapro.com,https://www.harpapro.com
WAITLIST_CORS_ORIGINS=http://localhost:3002

# ── Dashboard browser access ──────────────────────────────────────────────────
# Credentialed CORS + better-auth trusted origins. Wildcards match Cloudflare
# Pages preview subdomains. Keep preview/dev/prod origins HTTPS-only.
DASHBOARD_CORS_ORIGINS=https://app.harpapro.com,https://harpa-pro-dashboard.pages.dev,https://*.harpa-pro-dashboard.pages.dev,http://localhost:3003,http://127.0.0.1:3003

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Fly prod/dev must use postgres for cross-machine enforcement.
# Local/test/PR previews may use the per-process memory backend.
RATE_LIMIT_BACKEND=memory
# Production always uses Postgres. This override is for local/test use.
IDEMPOTENCY_BACKEND=memory

# ── Misc ──────────────────────────────────────────────────────────────────────
# Reserved. The API parses this value but does not install request-log middleware.
REQUEST_LOG=false

# ── Universal links ───────────────────────────────────────────────────────────
# Empty values make the matching .well-known route return 404.
IOS_APP_ID_PREFIX=            # 10-character Apple Team ID
IOS_BUNDLE_IDS=com.harpa.pro,com.harpa.pro.dev
ANDROID_PACKAGE_NAMES=com.harpa.pro,com.harpa.pro.dev
ANDROID_CERT_FINGERPRINTS_SHA256=

# ── Sentry (API crash reporting) ──────────────────────────────────────────────
# dev/prod: API DSN for the shared Harpa Pro Sentry project. Leave empty locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1


# =============================================================================
# §B — Astro browser apps  (apps/site and apps/admin — Cloudflare Pages)
# =============================================================================
# Astro inlines PUBLIC_* vars at build time. The site and admin workspaces have
# their own .env.example files. Both use PUBLIC_API_BASE_URL; only the public
# site uses the dashboard URL and Turnstile key. The Vite dashboard uses
# apps/dashboard/.env.example instead.

# local: http://localhost:8787  dev: https://harpa-pro-api-dev.fly.dev  prod: https://api.harpapro.com
PUBLIC_API_BASE_URL=http://localhost:8787
# local: http://localhost:3003  dev: https://dev.harpa-pro-dashboard.pages.dev  prod: https://harpa-pro-dashboard.pages.dev
PUBLIC_DASHBOARD_URL=http://localhost:3003
# Cloudflare Turnstile site key (public). Use Cloudflare's always-passes test
# key for local/dev: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA


# =============================================================================
# §C — Mobile  (apps/mobile — Metro / Expo)
# =============================================================================
# APP_VARIANT configures the native app. EXPO_PUBLIC_* vars are inlined into the
# JavaScript bundle. A new EAS Update can change JavaScript-only values, but an
# APP_VARIANT or native-config change requires a new binary.

APP_VARIANT=development       # development | preview | production
# local: http://localhost:8787  dev: https://harpa-pro-api-dev.fly.dev  prod: https://api.harpapro.com
EXPO_PUBLIC_API_URL=http://localhost:8787
# PR OTA only. This overrides the EAS-managed API URL for that bundle.
EXPO_PUBLIC_API_URL_OVERRIDE=
# Selects local device fixtures such as the canned recorder and report sample.
# It does not force the remote API into replay mode.
EXPO_PUBLIC_USE_FIXTURES=false
EXPO_PUBLIC_APP_VARIANT=development
EXPO_PUBLIC_LAYOUT_PROBE=false
EXPO_PUBLIC_SCREENSHOT_MODE=false
# Mobile DSN for the shared Harpa Pro Sentry project. Leave empty locally.
EXPO_PUBLIC_SENTRY_DSN=
# Set only by the PR OTA workflow.
EXPO_PUBLIC_PR_NUMBER=


# =============================================================================
# §D — CLI  (apps/cli)
# =============================================================================

HARPA_API_URL=http://localhost:8787
HARPA_TOKEN=
HARPA_DEBUG=0                 # 0 | 1
HARPA_IDEMPOTENCY_KEY=


# =============================================================================
# §E — Infrastructure  (Neon, Fly, Cloudflare, and Sentry — CI secrets + scripts)
# =============================================================================

# ── Neon (used by pr-preview.yml + db:branch:* scripts) ──────────────────────
# Personal API key from https://console.neon.tech/app/settings/api-keys
# Push to GitHub Actions with: gh secret set NEON_API_KEY --body "$NEON_API_KEY"
NEON_API_KEY=
# Neon project id (e.g. purple-frost-12345678). Find with: neonctl projects list
NEON_PROJECT_ID=
# GitHub repository variable for the independent admin Neon project.
NEON_ADMIN_PROJECT_ID=

# ── Fly.io ────────────────────────────────────────────────────────────────────
# Token used by api-prod.yml + api-dev.yml. One token covers both apps.
# Generate with: fly tokens create deploy -x 8760h
# Push with: gh secret set FLY_API_TOKEN --body "$FLY_API_TOKEN"
FLY_API_TOKEN=
# infra/fly/deploy.sh always targets harpa-pro-api. It does not read FLY_APP.

# ── Cloudflare Pages project setup (manual operator script) ──────────────────
# Used only by scripts/ci/ensure-dashboard-pages-project.sh. GitHub deployment
# workflows use native Pages Git builds and deliberately hold no Cloudflare API
# credential.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DASHBOARD_PAGES_PROJECT=harpa-pro-dashboard

# ── Sentry CLI / source maps ─────────────────────────────────────────────────
# Used by @sentry/react-native/expo for native builds/source maps.
# Auth token needs project:write. URL is optional unless self-hosting Sentry.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_URL=

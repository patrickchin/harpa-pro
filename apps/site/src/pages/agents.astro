---
import { Image } from "astro:assets";
import harunaImg from "../assets/team/haruna.jpg";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Container from "../components/primitives/Container.astro";
import Section from "../components/primitives/Section.astro";
import Layout from "../layouts/Layout.astro";

const contactHref =
  "mailto:patrick@harpapro.com?subject=China%20sourcing%20enquiry";

const sourcingRoute = [
  {
    title: "Share the brief",
    body: "Send the product, quantity, specifications, reference photos, and destination you have in mind.",
  },
  {
    title: "Search and compare",
    body: "Haruna can look for suitable suppliers, ask practical questions, and help you compare what they offer.",
  },
  {
    title: "Check and document",
    body: "Where practical and agreed, he can visit a supplier or factory, ask questions, and share photos or video of what is there.",
  },
  {
    title: "Coordinate logistics",
    body: "He can stay in touch with the supplier and coordinate the handoff to the logistics provider you choose.",
  },
];
---

<Layout
  title="China sourcing with Haruna | Harpa Pro"
  description="Work with Haruna Bayoh for practical, person-to-person help sourcing products and speaking with suppliers in China."
>
  <div class="min-h-screen bg-background text-ink">
    <Header hideCta />
    <main>
      <section class="border-b border-hairline">
        <Container
          padding="none"
          class="grid gap-10 py-14 sm:px-6 md:py-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:items-center lg:gap-16"
        >
          <div>
            <p
              class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-accent-ink"
            >
              Agents · Human sourcing support
            </p>
            <h1
              class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.04] tracking-tight text-ink sm:text-5xl lg:text-[4rem]"
            >
              Get local help buying from China.
            </h1>
            <p
              class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg"
            >
              Tell Haruna what you want to buy and where it needs to go. He can
              speak with suppliers, ask the questions you would ask in person,
              and show you what he finds.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href={contactHref}
                class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-sm font-semibold text-accent-foreground shadow-sm hover:brightness-95 ring-focus"
              >
                Send a sourcing brief
              </a>
              <span class="text-sm text-ink-soft">
                For buyers outside China
              </span>
            </div>
          </div>

          <figure
            class="overflow-hidden rounded-2xl border border-hairline bg-card shadow-sm"
          >
            <div class="aspect-square overflow-hidden bg-secondary">
              <Image
                src={harunaImg}
                alt="Haruna Bayoh"
                width={642}
                height={642}
                densities={[1, 2]}
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption
              class="flex items-center justify-between gap-5 border-t border-hairline px-5 py-4"
            >
              <div>
                <strong class="block text-sm font-semibold text-ink">
                  Haruna Bayoh
                </strong>
                <span class="mt-0.5 block text-xs text-ink-soft">
                  Your sourcing contact in China
                </span>
              </div>
              <span
                class="font-mono text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-accent-ink"
              >
                Person to person
              </span>
            </figcaption>
          </figure>
        </Container>
      </section>

      <Section tone="paper-2" bordered="y">
        <Container padding="lg">
          <div class="max-w-2xl">
            <p
              class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-accent-ink"
            >
              The sourcing route
            </p>
            <h2
              class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
            >
              How Haruna handles a sourcing request.
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">
              The exact scope depends on the product, the supplier's location,
              and the checks you need.
            </p>
          </div>

          <ol
            aria-label="How sourcing works"
            class="mt-10 grid gap-px overflow-hidden rounded-xl border border-hairline bg-border sm:grid-cols-2 lg:grid-cols-4"
          >
            {
              sourcingRoute.map((step, index) => (
                <li class="bg-card p-6">
                  <span class="font-mono text-xs font-semibold text-accent-ink">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3 class="mt-8 text-lg font-semibold text-ink">
                    {step.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                    {step.body}
                  </p>
                </li>
              ))
            }
          </ol>
        </Container>
      </Section>

      <Section>
        <Container
          padding="lg"
          class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:gap-16"
        >
          <div>
            <p
              class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-accent-ink"
            >
              Why Haruna
            </p>
            <h2
              class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
            >
              Haruna also brings an engineer's experience.
            </h2>
            <div class="mt-6 max-w-2xl space-y-4 text-sm leading-relaxed text-ink-soft sm:text-base">
              <p>
                Haruna is a researcher at Zhejiang University. He holds a BEng
                in Civil Engineering from Fourah Bay College, University of
                Sierra Leone, and an MEng in Structural Engineering from
                Chang'An University.
              </p>
              <p>
                He previously worked as a building design engineer at Cheng
                Xian Prefabricated Building Company in Qingzhou, Shandong,
                focusing on fabricated structural components for modular
                buildings.
              </p>
            </div>
          </div>

          <aside class="rounded-2xl border border-hairline bg-card p-6 sm:p-8">
            <p
              class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-accent-ink"
            >
              What to send first
            </p>
            <ul class="mt-6 space-y-4 text-sm leading-relaxed text-ink">
              <li class="border-t border-hairline pt-4 first:border-0 first:pt-0">
                The product name, photos, links, or specifications
              </li>
              <li class="border-t border-hairline pt-4">
                Your expected quantity and destination country
              </li>
              <li class="border-t border-hairline pt-4">
                The supplier questions or checks that matter to you
              </li>
              <li class="border-t border-hairline pt-4">
                Your target timing and current logistics plan, if any
              </li>
            </ul>
          </aside>
        </Container>
      </Section>

      <Section bordered="top">
        <Container padding="lg">
          <div
            class="grid gap-8 rounded-2xl bg-primary p-7 text-primary-foreground sm:p-10 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12"
          >
            <div class="max-w-2xl">
              <p
                class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-primary-foreground/70"
              >
                Start the conversation
              </p>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
                Have a product in mind?
              </h2>
              <p
                class="mt-4 text-sm leading-relaxed text-primary-foreground/75 sm:text-base"
              >
                Send what you know so far. Before work begins, you and Haruna
                will agree on the scope, location, timing, fees, and the
                evidence you need.
              </p>
            </div>
            <a
              href={contactHref}
              class="inline-flex min-h-11 w-fit items-center rounded-md bg-accent px-5 text-sm font-semibold text-accent-foreground shadow-sm hover:brightness-95 ring-focus"
            >
              Send a sourcing brief
            </a>
          </div>
        </Container>
      </Section>
    </main>
    <Footer />
  </div>
</Layout>

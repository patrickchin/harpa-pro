---
import type { HTMLAttributes } from "astro/types";

type Variant = "accent" | "primary" | "ghost";
type Size = "md" | "lg";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: Variant;
  size?: Size;
}

const { href, variant = "accent", size = "md", class: extra = "", ...rest } =
  Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-md font-bold transition ring-focus";

const sizes: Record<Size, string> = {
  md: "min-h-11 px-4 text-base",
  lg: "min-h-13 px-5 text-lg",
};

const variants: Record<Variant, string> = {
  accent:
    "bg-accent text-accent-foreground shadow-[var(--shadow-raised)] hover:brightness-95",
  primary:
    "bg-primary text-primary-foreground shadow-[var(--shadow-raised)] hover:brightness-95",
  ghost:
    "border border-hairline bg-card text-ink hover:bg-secondary",
};

const cls = [base, sizes[size], variants[variant], extra]
  .filter(Boolean)
  .join(" ");
---

<a href={href} class={cls} {...rest}><slot /></a>

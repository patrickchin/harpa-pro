---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /**
   * Vertical padding rhythm. `md` and `lg` share the current section
   * spacing; `none` opts out.
   */
  padding?: "lg" | "md" | "none";
}

const { padding = "lg", class: extra = "", ...rest } = Astro.props;

const padCls = padding === "none" ? "" : "py-14 sm:px-6 md:py-16";

const cls = ["mx-auto max-w-6xl px-4", padCls, extra]
  .filter(Boolean)
  .join(" ");
---

<div class={cls} {...rest}><slot /></div>

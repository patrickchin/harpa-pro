---
import { getCollection, render } from "astro:content";
import Icon from "../Icon.astro";
import Section from "../primitives/Section.astro";
import Container from "../primitives/Container.astro";
import Card from "../primitives/Card.astro";
import SectionHeader from "../primitives/SectionHeader.astro";

const entries = (await getCollection("reportsFeatures")).sort(
  (a, b) => a.data.order - b.data.order,
);

const feats = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { title: entry.data.title, icon: entry.data.icon, Content };
  }),
);
---

<Section tone="paper-2" bordered="top">
  <Container padding="lg">
    <SectionHeader title="Reporting Tools">
      <Fragment slot="lede">
        Keep source updates and report drafts in one project. Review each draft
        before you finalize or share it. See planned work on the <a
          href="/reports/roadmap"
          class="font-medium text-primary underline-offset-4 hover:underline"
          >roadmap</a>.
      </Fragment>
    </SectionHeader>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        feats.map(({ title, icon, Content }) => (
          <Card>
            <span class="grid h-9 w-9 place-items-center rounded-md border border-hairline bg-paper-2 text-ink">
              <Icon name={icon} class="h-4 w-4" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-ink">{title}</h3>
            <div class="mt-1.5 text-sm leading-relaxed text-ink-soft">
              <Content />
            </div>
          </Card>
        ))
      }
    </div>
  </Container>
</Section>

---
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 md:grid-cols-[minmax(14rem,1.4fr)_repeat(3,minmax(8rem,1fr))]"
  >
    <div class="flex flex-col gap-2">
      <Wordmark />
      <p class="text-xs text-ink-soft">
        Technical procurement and factory records in China.
      </p>
    </div>
    <nav aria-label="Procurement" class="grid content-start gap-2 text-xs text-ink-soft">
      <h2 class="font-semibold uppercase tracking-wider text-ink">Procurement</h2>
      <a href="/" class="hover:text-ink">Overview</a>
      <a href="/#considerations" class="hover:text-ink">What We Consider</a>
      <a href="/#factory-partners" class="hover:text-ink">Factory Examples</a>
      <a href="/#contact" class="hover:text-ink">Contact Us</a>
    </nav>
    <nav aria-label="Site Reporting" class="grid content-start gap-2 text-xs text-ink-soft">
      <h2 class="font-semibold uppercase tracking-wider text-ink">Site Reporting</h2>
      <a href="/app" class="hover:text-ink">Harpa Pro App</a>
      <a href="/docs" class="hover:text-ink">Guides</a>
      <a href="/roadmap" class="hover:text-ink">Roadmap</a>
      <a href="/account-deletion" class="hover:text-ink">Account Deletion</a>
    </nav>
    <nav aria-label="Company" class="grid content-start gap-2 text-xs text-ink-soft">
      <h2 class="font-semibold uppercase tracking-wider text-ink">Company</h2>
      <a href="/privacy" class="hover:text-ink">Privacy</a>
      <a href="/#contact" class="hover:text-ink">Contact</a>
      <span>© {year} Harpa Pro</span>
    </nav>
  </div>
</footer>

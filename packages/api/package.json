{
  "name": "@harpa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "TESTCONTAINERS_RYUK_DISABLED=true vitest run --config vitest.integration.config.ts",
    "test:coverage": "TESTCONTAINERS_RYUK_DISABLED=true bash scripts/test-coverage.sh",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0 --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:admin": "tsx src/db/admin-migrate.ts",
    "admin:set-password": "tsx scripts/set-admin-password.ts",
    "db:seed-test-account": "tsx scripts/seed-test-account.ts",
    "activity:reconcile-signups": "tsx scripts/reconcile-signup-activity.ts",
    "spec:emit": "tsx scripts/emit-openapi.ts",
    "r2:rewrite": "tsx scripts/rewrite-r2-keys-to-project-scope.ts",
    "storage:arm-leases": "tsx scripts/arm-storage-lifecycle-rollout.ts",
    "storage:worker": "tsx src/workers/storage-delete.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@better-auth/cli": "^1.4.21",
    "@better-auth/expo": "^1.6.13",
    "@harpa/ai-fixtures": "workspace:*",
    "@harpa/api-contract": "workspace:*",
    "@harpa/report-core": "workspace:*",
    "@hono/node-server": "^1.13.2",
    "@hono/zod-openapi": "^0.18.3",
    "@sentry/hono": "^10.69.0",
    "@sentry/node": "^10.69.0",
    "better-auth": "^1.6.13",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.0",
    "jose": "^5.9.6",
    "nanoid": "^5.1.11",
    "pg": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "^8.57.1",
    "fast-check": "^4.8.0",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  }
}

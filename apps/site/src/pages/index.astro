---
import { Image } from "astro:assets";
import ProcurementConsiderations from "../components/agents/ProcurementConsiderations.astro";
import ProcurementEvidence from "../components/agents/ProcurementEvidence.astro";
import Icon from "../components/Icon.astro";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Container from "../components/primitives/Container.astro";
import Section from "../components/primitives/Section.astro";
import Layout from "../layouts/Layout.astro";
import procurementInteriorImg from "../assets/agents/procurement-interior.jpg";
import harunaImg from "../assets/team/haruna.jpg";
---

<Layout
  title="Harpa Pro — Interior procurement in China"
  description="We coordinate specifications, factories, quality checks, shipping records, and project approvals in China."
>
  <div class="min-h-screen bg-background text-ink">
    <Header />
    <main class="agents-page">
      <section id="top" class="bg-background">
        <div class="mx-auto max-w-7xl sm:px-6 sm:py-10 lg:py-12">
          <figure
            data-hero-visual
            class="relative isolate min-h-[40rem] overflow-hidden border-y border-primary/15 bg-primary shadow-lg sm:min-h-[40rem] sm:rounded-2xl sm:border md:min-h-[43rem]"
          >
            <Image
              src={procurementInteriorImg}
              alt="Contemporary living room with stone, timber, and fabric samples arranged for review"
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 80rem) 80rem, (min-width: 40rem) calc(100vw - 3rem), 100vw"
              format="webp"
              quality={84}
              priority
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div
              data-hero-scrim
              aria-hidden="true"
              class="hero-scrim absolute inset-0"
            ></div>
            <figcaption
              data-hero-copy
              class="relative z-10 flex min-h-[40rem] items-end p-5 sm:min-h-[40rem] sm:p-8 md:min-h-[43rem] lg:p-12"
            >
              <div class="max-w-6xl">
                <h1
                  class="text-[2rem] font-semibold leading-[1.02] tracking-tight text-primary-foreground sm:text-5xl lg:whitespace-nowrap lg:text-[3.75rem] xl:text-[4.25rem]"
                >
                  Luxury Interior procurement in China
                </h1>
                <p class="mt-5 max-w-2xl text-base leading-relaxed text-primary-foreground/85 sm:text-lg">
                  We manage design specifications, factory coordination, quality
                  checks, shipment, and complete procurement documentation
                  (approved health, safety, and quality standards).
                </p>
              </div>
            </figcaption>
          </figure>
        </div>
      </section>

      <Section id="agent" tone="paper-2" bordered="top">
        <Container padding="lg">
          <article
            data-single-agent-profile
            class="grid overflow-hidden rounded-2xl border border-hairline bg-card shadow-sm md:grid-cols-[minmax(14rem,0.72fr)_minmax(0,1.28fr)] lg:grid-cols-[minmax(18rem,0.82fr)_minmax(0,1.18fr)]"
          >
            <figure data-agent-portrait class="h-[22rem] bg-primary sm:h-[26rem] md:h-auto md:min-h-[34rem]">
              <Image
                src={harunaImg}
                alt="Haruna Bayoh"
                widths={[480, 720, 960]}
                sizes="(min-width: 64rem) 35vw, (min-width: 48rem) 38vw, calc(100vw - 3rem)"
                format="webp"
                quality={90}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top md:object-[35%_top] lg:object-top"
              />
            </figure>

            <div data-agent-bio class="min-w-0 p-7 sm:p-10 lg:p-12">
              <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
                Procurement Lead
              </h2>
              <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft sm:text-base">
                Haruna Bayoh is Harpa Pro's procurement lead in China. He receives
                the project brief, works with the factories, records and approve
                quality standards and inspections, manage shipping logistics, and
                keep the order files complete.
              </p>
              <a
                href="https://www.linkedin.com/in/harunabayoh/"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary ring-focus"
              >
                LinkedIn profile <Icon name="external-link" class="h-4 w-4" />
              </a>

              <dl class="mt-8 grid gap-4 border-y border-hairline py-5 text-sm sm:grid-cols-3">
                <div>
                  <dt class="text-ink-soft">Discipline</dt>
                  <dd class="mt-1 font-medium text-ink">Architecture and materials</dd>
                </div>
                <div>
                  <dt class="text-ink-soft">Education</dt>
                  <dd class="mt-1 font-medium text-ink">Master's degree</dd>
                </div>
                <div>
                  <dt class="text-ink-soft">Experience</dt>
                  <dd class="mt-1 font-medium text-ink">6 years</dd>
                </div>
              </dl>

              <dl class="mt-8 grid gap-x-6 gap-y-5 sm:grid-cols-2">
                <div>
                  <dt class="text-sm font-semibold text-ink">Technical coordination</dt>
                  <dd class="mt-1 text-sm leading-relaxed text-ink-soft">
                    Drawings, dimensions, finishes, and approval records.
                  </dd>
                </div>
                <div>
                  <dt class="text-sm font-semibold text-ink">Factory coordination</dt>
                  <dd class="mt-1 text-sm leading-relaxed text-ink-soft">
                    Capability, samples, quotations, and production questions.
                  </dd>
                </div>
                <div>
                  <dt class="text-sm font-semibold text-ink">Order control</dt>
                  <dd class="mt-1 text-sm leading-relaxed text-ink-soft">
                    Quantities, inspections, packing, and delivery checks.
                  </dd>
                </div>
                <div>
                  <dt class="text-sm font-semibold text-ink">Document record</dt>
                  <dd class="mt-1 text-sm leading-relaxed text-ink-soft">
                    Product data, certificates, approvals, and shipping files.
                  </dd>
                </div>
              </dl>
            </div>
          </article>
        </Container>
      </Section>

      <Section id="contact" bordered="top" class="scroll-mt-16 bg-background">
        <Container padding="lg">
          <div class="grid gap-10 lg:grid-cols-[minmax(0,0.78fr)_minmax(32rem,1.22fr)] lg:gap-16">
            <div class="max-w-xl">
              <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
                Contact us
              </h2>
              <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">
                Email or message us about an interior procurement project in
                China.
              </p>
            </div>

            <dl class="grid gap-5 sm:grid-cols-2">
              <div class="rounded-xl border border-hairline bg-card p-6 shadow-sm">
                <dt class="flex items-center gap-2 text-sm font-semibold text-ink">
                  <Icon name="mail" class="h-4 w-4 text-accent-ink" />
                  Email
                </dt>
                <dd class="mt-4">
                  <p class="select-all break-all font-mono text-sm text-ink">
                    haruna@harpapro.com
                  </p>
                  <div
                    class="mt-5 flex flex-wrap gap-3"
                    data-contact-email-actions
                  >
                    <button
                      type="button"
                      class="inline-flex h-10 items-center gap-2 rounded-md bg-accent-ink px-4 text-sm font-medium text-accent-foreground shadow-sm hover:brightness-95 ring-focus"
                      data-copy-email
                      data-email="haruna@harpapro.com"
                    >
                      <Icon name="copy" class="h-4 w-4" />
                      Copy email
                    </button>
                    <a
                      href="mailto:haruna@harpapro.com"
                      class="inline-flex h-10 items-center gap-2 rounded-md border border-hairline px-4 text-sm font-medium text-ink hover:bg-secondary ring-focus"
                    >
                      Open email app
                    </a>
                  </div>
                  <p
                    class="mt-3 min-h-5 text-xs text-ink-soft"
                    role="status"
                    aria-live="polite"
                    data-copy-email-status
                  ></p>
                </dd>
              </div>

              <div class="rounded-xl border border-hairline bg-card p-6 shadow-sm">
                <dt class="flex items-center gap-2 text-sm font-semibold text-ink">
                  <Icon name="message-circle" class="h-4 w-4 text-accent-ink" />
                  WhatsApp
                </dt>
                <dd class="mt-4">
                  <p class="font-mono text-sm text-ink">+86 193 7283 7269</p>
                  <a
                    href="https://wa.me/861937283726"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-5 inline-flex h-10 items-center gap-2 rounded-md border border-primary/30 px-4 text-sm font-medium text-primary hover:bg-card ring-focus"
                  >
                    Message on WhatsApp
                    <Icon name="external-link" class="h-4 w-4" />
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        </Container>
      </Section>

      <Section id="considerations" tone="paper-2" bordered="top" class="scroll-mt-16">
        <Container padding="lg">
          <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
            What we consider
          </h2>

          <ProcurementConsiderations />
        </Container>
      </Section>

      <ProcurementEvidence />
    </main>
    <Footer />
  </div>

  <script>
    const copyEmailButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    const copyEmailStatus = document.querySelector<HTMLElement>("[data-copy-email-status]");

    copyEmailButton?.addEventListener("click", async () => {
      const email = copyEmailButton.dataset.email;
      if (!email || !copyEmailStatus) return;

      try {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(email);
        copyEmailStatus.textContent = "Email copied";
      } catch {
        copyEmailStatus.textContent = "Select and copy the email address above";
      }
    });
  </script>
</Layout>

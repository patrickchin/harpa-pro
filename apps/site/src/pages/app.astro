---
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Icon from "../components/Icon.astro";
import Container from "../components/primitives/Container.astro";
import Section from "../components/primitives/Section.astro";
import Layout from "../layouts/Layout.astro";
import { APP_STORE_URL } from "../lib/links";

const reportWorkflow = [
  {
    title: "Capture",
    description: "Record a voice note and add photos or text from the site.",
  },
  {
    title: "Draft",
    description: "Harpa Pro organizes the update into a daily report draft.",
  },
  {
    title: "Review",
    description: "Check and edit the report before export or sharing.",
  },
];
---

<Layout
  title="Harpa Pro app — Construction site reporting"
  description="Harpa Pro turns voice notes, photos, and text updates into daily construction report drafts for review and export."
>
  <div class="min-h-screen bg-background text-ink">
    <Header />
    <main>
      <section class="border-b border-hairline">
        <Container padding="lg">
          <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(28rem,1.1fr)] lg:items-center lg:gap-16">
            <div class="max-w-2xl">
              <p class="text-xs font-semibold uppercase tracking-wider text-accent-ink">
                Harpa Pro app
              </p>
              <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
                Construction site reporting.
              </h1>
              <p class="mt-5 text-base leading-relaxed text-ink-soft sm:text-lg">
                Turn voice notes, photos, and text updates into a daily report
                draft. Review and edit the draft before export or sharing.
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a
                  href={APP_STORE_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground shadow-sm hover:brightness-110 ring-focus"
                >
                  Get the app <Icon name="external-link" class="h-4 w-4" />
                </a>
                <a
                  href="/docs"
                  class="inline-flex h-11 items-center gap-2 rounded-md border border-hairline bg-card px-5 text-sm font-medium text-ink shadow-sm hover:bg-secondary ring-focus"
                >
                  App guides <Icon name="arrow-right" class="h-4 w-4" />
                </a>
              </div>
            </div>

            <ol class="grid gap-3" aria-label="Reporting app workflow">
              {
                reportWorkflow.map((item, index) => (
                  <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4 rounded-xl border border-hairline bg-card p-5 shadow-sm">
                    <span class="font-mono text-xs text-accent-ink">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <div>
                      <h2 class="text-base font-semibold text-ink">{item.title}</h2>
                      <p class="mt-1 text-sm leading-relaxed text-ink-soft">
                        {item.description}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </Container>
      </section>

      <Section tone="paper-2" bordered="top">
        <Container padding="lg">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent-ink">
              App resources
            </p>
            <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
              Current guidance and planned work.
            </h2>
          </div>
          <div class="mt-10 grid gap-5 md:grid-cols-2">
            <article class="rounded-xl border border-hairline bg-card p-6 shadow-sm">
              <h3 class="text-xl font-semibold text-ink">App guides</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">
                Instructions for capture, report generation, editing, export,
                projects, members, and account settings.
              </p>
              <a
                href="/docs"
                class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary ring-focus"
              >
                App guides <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </article>
            <article class="rounded-xl border border-hairline bg-card p-6 shadow-sm">
              <h3 class="text-xl font-semibold text-ink">App roadmap</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">
                Current capabilities and the areas planned for later app
                releases.
              </p>
              <a
                href="/roadmap"
                class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary ring-focus"
              >
                App roadmap <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </article>
          </div>
        </Container>
      </Section>
    </main>
    <Footer />
  </div>
</Layout>

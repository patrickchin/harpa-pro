---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Harpa Pro Admin">
  <main class="mx-auto flex min-h-screen w-full max-w-xl items-center px-6 py-16">
    <section>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent-ink">404</p>
      <h1 class="mt-2 text-3xl font-semibold text-ink">Page not found</h1>
      <p class="mt-3 text-muted-foreground">The requested admin page does not exist.</p>
      <a
        class="mt-6 inline-flex rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground"
        href="/"
      >
        Open admin console
      </a>
    </section>
  </main>
</Layout>

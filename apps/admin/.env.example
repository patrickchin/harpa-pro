# Standalone admin site local configuration.
# Rename this file to .env before running `pnpm --filter @harpa/admin dev`.

# local: http://localhost:8787  dev: https://harpa-pro-api-dev.fly.dev  prod: https://api.harpapro.com
PUBLIC_API_BASE_URL=http://localhost:8787

# Exact origins used to read the public-site and dashboard Pages deployment markers.
PUBLIC_SITE_BASE_URL=http://localhost:4321
PUBLIC_DASHBOARD_URL=http://localhost:3003

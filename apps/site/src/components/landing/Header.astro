---
import Wordmark from "./Wordmark.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const linkClass = "inline-flex min-h-11 min-w-11 items-center justify-center border-b text-xs font-medium ring-focus sm:text-sm";
---

<header
  class="relative sticky top-0 z-40 border-b border-border bg-paper-2 shadow-sm"
  data-site-header
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <Wordmark />
    <nav aria-label="Primary" class="flex items-center gap-2 sm:gap-6">
      <a
        href="/"
        aria-current={currentPath === "/" ? "page" : undefined}
        class:list={[linkClass, currentPath === "/" ? "border-primary text-ink" : "border-transparent text-ink-soft hover:text-ink"]}
      >Home</a>
      <a
        href="/how-to-buy-from-china"
        aria-current={currentPath === "/how-to-buy-from-china" ? "page" : undefined}
        class:list={[linkClass, currentPath === "/how-to-buy-from-china" ? "border-primary text-ink" : "border-transparent text-ink-soft hover:text-ink"]}
      >
        <span class="max-w-28 text-balance leading-tight sm:max-w-none">How to Buy from China</span>
      </a>
    </nav>
  </div>
</header>

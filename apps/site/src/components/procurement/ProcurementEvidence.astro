---
import { Image } from "astro:assets";
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";
import Button from "../primitives/Button.astro";
import Card from "../primitives/Card.astro";
import SectionHeader from "../primitives/SectionHeader.astro";
import {
  FACTORY_DOCUMENTS_PATH,
  factoryDocuments,
} from "../../lib/procurement/factory-documents";
// Pre-cropped from ais-factory-exterior.webp (sharp extract left 5, top 5,
// 871x478) to drop the catalogue's embedded caption and white border.
import aisFactoryImg from "../../assets/procurement/factories/ais-factory-exterior-photo.webp";
import aisStyleImg from "../../assets/procurement/factories/catalogues/ais-style-selection-p04.webp";
import j2sProjectImg from "../../assets/procurement/factories/catalogues/j2s-project-p05.webp";
import j2sBarChairsImg from "../../assets/procurement/factories/catalogues/j2s-bar-chairs-p12.webp";
import kenuoOfficeImg from "../../assets/procurement/factories/catalogues/kenuo-office-p12.webp";
import masyoungerStorageImg from "../../assets/procurement/factories/catalogues/masyounger-storage-p08.webp";
import rongshuoBathroomImg from "../../assets/procurement/factories/catalogues/rongshuo-bathroom-p02.webp";
// Pre-cropped from rongshuo-shower-p02.webp (sharp extract left 60, top 85,
// 754x471) so mobile does not download the whole catalogue page for a crop.
import rongshuoShowerImg from "../../assets/procurement/factories/catalogues/rongshuo-shower-p02-sw011.webp";

const factories = [
  {
    name: "AIS Smarti",
    location: "Foshan and Jiangmen, Guangdong",
    scope:
      "Custom cabinetry, wardrobes, bathroom cabinets, doors, wall panels, and project joinery.",
    image: aisFactoryImg,
    alt: "AIS Smarti headquarters and factory in Foshan, China",
    imageCrop: "cover",
    imageClass: "h-full w-full object-cover",
    featured: true,
  },
  {
    name: "J2S",
    location: "Foshan, Guangdong",
    scope:
      "Custom furniture for restaurants, cafes, bars, hotel lobbies, and public areas.",
    image: j2sProjectImg,
    alt: "J2S restaurant project and hospitality furniture catalogue spread",
    imageCrop: "cover",
    imageClass: "h-full w-full object-cover",
  },
  {
    name: "Kenuo",
    location: "Guangdong, China",
    scope:
      "Wood office desks, workstations, meeting tables, storage, and seating.",
    image: kenuoOfficeImg,
    alt: "Kenuo executive office desk and storage catalogue page",
    imageCrop: "cover",
    imageClass: "h-full w-full object-cover",
  },
  {
    name: "Masyounger",
    location: "Luoyang, Henan",
    scope:
      "Steel filing cabinets, lockers, shelving, workbenches, and school furniture.",
    image: masyoungerStorageImg,
    alt: "Masyounger steel storage cabinet models and dimensions",
    imageCrop: "cover",
    imageClass: "h-full w-full object-cover",
  },
  {
    name: "Rong Shuo",
    location: "Pinghu, Zhejiang",
    scope:
      "Bathroom cabinets, mirrors, shower enclosures, and prefabricated bathroom systems.",
    image: rongshuoBathroomImg,
    alt: "Rong Shuo bathroom cabinet models from the supplied catalogue",
    imageCrop: "cover",
    imageClass: "h-full w-full object-cover",
  },
];

const buyerInformation = [
  "Product or model reference",
  "Intended use and configuration",
  "Dimensions and permitted variation",
  "Materials and construction",
  "Finish, color, and hardware",
  "Applicable test reports or certificates",
  "Quantity and packing method",
  "Quotation basis, lead time, and items to confirm",
];

const productBriefs = [
  {
    index: "01",
    title: "AIS Custom Kitchen Joinery",
    source: "AIS Smarti Product Style Selection, page 4",
    description:
      "The factory page provides a style reference. A quote adds the approved drawings, dimensions, board grade, finishes, hardware, interfaces, quantity, and packing.",
    image: aisStyleImg,
    alt: "AIS Smarti modern kitchen style selection page",
    imageMode: "cover",
    imageClass: "h-full w-full object-cover",
  },
  {
    index: "02",
    title: "J2S JSBC Hospitality Seating",
    source: "J2S catalogue, pages 21-22",
    description:
      "The catalogue identifies the JSBC bar-chair series. A quote identifies one model and records its dimensions, frame, upholstery, finish, quantity, and packing.",
    image: j2sBarChairsImg,
    alt: "J2S JSBC bar-chair series catalogue spread",
    imageMode: "cover",
    imageClass: "h-full w-full object-cover",
  },
  {
    index: "03",
    title: "Rong Shuo SW-011 Shower Enclosure",
    source: "Rong Shuo Shower Room/Enclosure Catalogue, page 2",
    description:
      "The catalogue provides data for the first comparison. A quote also records the handing, site dimensions, finish, quantity, and packing.",
    image: rongshuoShowerImg,
    alt: "Rong Shuo SW-011 shower enclosure catalogue page",
    imageMode: "source-content",
    imageClass: "h-full w-full object-cover",
  },
];

const documentSources = [
  ...new Set(
    factoryDocuments.map((document) => document.source.replace(/ source package$/, "")),
  ),
];
const documentPreviews = factoryDocuments.slice(0, 3);
---

<Section
  id="evidence"
  aria-labelledby="factory-partners-heading"
  bordered="top"
  class="scroll-mt-16 bg-background"
>
  <Container padding="lg">
    <div id="factory-partners" class="scroll-mt-24">
      <SectionHeader
        width="3xl"
        titleId="factory-partners-heading"
        title="Selected Factory Partners"
        lede="We match each order with the factory that meets the design specifications and the delivery timeline."
      />

      <div class="mt-8 grid gap-5">
    {
      factories.filter((factory) => factory.featured).map((factory) => (
        <article
          data-factory-partner
          data-factory-featured="true"
          class="grid overflow-hidden rounded-2xl border border-hairline bg-card shadow-sm sm:grid-cols-[minmax(0,1.2fr)_minmax(14rem,0.8fr)] lg:grid-cols-2"
        >
          <figure
            data-factory-image-frame
            data-image-crop={factory.imageCrop}
            class="aspect-[16/9] overflow-hidden bg-white sm:aspect-auto sm:h-56 lg:h-64"
          >
            <Image
              src={factory.image}
              alt={factory.alt}
              widths={[520, 760, 1040]}
              sizes="(min-width: 64rem) 36rem, (min-width: 40rem) 55vw, calc(100vw - 3rem)"
              format="webp"
              quality={88}
              loading="lazy"
              decoding="async"
              class={factory.imageClass}
            />
          </figure>
          <div class="flex flex-col justify-center border-t border-hairline p-5 sm:border-l sm:border-t-0 lg:p-10">
            <p class="font-mono text-xs text-ink-soft">{factory.location}</p>
            <h3 class="mt-3 text-xl font-semibold tracking-tight text-ink lg:text-2xl">
              {factory.name}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{factory.scope}</p>
          </div>
        </article>
      ))
    }
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        factories.filter((factory) => !factory.featured).map((factory) => (
          <Card
            data-factory-partner=""
            as="article"
            padding="none"
            elevated
            class="grid grid-cols-[7.5rem_minmax(0,1fr)] overflow-hidden sm:block"
          >
            <figure
              data-factory-image-frame
              data-image-crop={factory.imageCrop}
              class="h-full min-h-28 w-full overflow-hidden bg-white sm:aspect-[16/9] sm:h-auto sm:min-h-0"
            >
              <Image
                src={factory.image}
                alt={factory.alt}
                widths={[360, 520, 720]}
                sizes="(min-width: 64rem) 17rem, (min-width: 40rem) 45vw, 7.5rem"
                format="webp"
                quality={86}
                loading="lazy"
                decoding="async"
                class={factory.imageClass}
              />
            </figure>
            <div class="border-l border-hairline p-4 sm:border-l-0 sm:border-t">
              <p class="font-mono text-xs leading-relaxed text-ink-soft">
                {factory.location}
              </p>
              <h3 class="mt-2 text-base font-semibold text-ink">{factory.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{factory.scope}</p>
            </div>
          </Card>
        ))
      }
    </div>
      </div>
    </div>

    <div
      id="quote-contents"
      class="mt-14 scroll-mt-24 border-t border-hairline pt-12 sm:mt-16"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-start lg:gap-10">
        <SectionHeader
          width="xl"
          titleId="product-information-heading"
          title="What Each Quote Includes"
          lede="A catalogue image identifies the product. The quote records the details needed to compare, approve, inspect, pack, and ship it."
        />
        <ol class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
          {
            buyerInformation.map((item, index) => (
              <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 border-t border-hairline pt-3 text-sm leading-relaxed text-ink">
                <span class="font-mono text-xs text-accent-ink">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div id="product-examples" class="mt-10 scroll-mt-24">
        <h3 class="text-sm font-semibold text-ink">
          From catalogue reference to quote
        </h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">
          These examples are not a stock list, price list, or full catalogue.
        </p>
        <!-- Below lg the examples scroll sideways so three tall cards do not stack. -->
        <div
          role="region"
          aria-label="Product examples"
          tabindex="0"
          data-product-examples-scroller
          class="-mx-4 mt-5 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 ring-focus sm:-mx-6 sm:scroll-px-6 sm:px-6 lg:mx-0 lg:grid lg:snap-none lg:grid-cols-3 lg:overflow-visible lg:px-0 lg:pb-0"
        >
          {
            productBriefs.map((brief) => (
              <Card
                data-product-brief=""
                as="article"
                padding="none"
                elevated
                class="flex w-[82%] max-w-sm flex-none snap-start flex-col overflow-hidden lg:w-auto lg:max-w-none"
              >
                <figure
                  data-product-image-frame
                  data-product-image-mode={brief.imageMode}
                  class="relative aspect-[16/9] w-full overflow-hidden bg-white"
                >
                  <Image
                    src={brief.image}
                    alt={brief.alt}
                    widths={[360, 520, 760]}
                    sizes="(min-width: 64rem) 24rem, (min-width: 30rem) 24rem, 82vw"
                    format="webp"
                    quality={90}
                    loading="lazy"
                    decoding="async"
                    class={brief.imageClass}
                  />
                </figure>
                <div class="flex flex-1 flex-col border-t border-hairline p-4 md:p-5">
                  <p class="font-mono text-xs leading-relaxed text-ink-soft">
                    <span class="whitespace-nowrap text-accent-ink">Example {brief.index}</span>
                    <span aria-hidden="true"> · </span>
                    {brief.source}
                  </p>
                  <h4 class="mt-2 text-base font-semibold tracking-tight text-ink">
                    {brief.title}
                  </h4>
                  <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                    {brief.description}
                  </p>
                </div>
              </Card>
            ))
          }
        </div>
      </div>
    </div>

    <Card
      id="factory-documents"
      as="section"
      aria-labelledby="factory-documents-heading"
      padding="none"
      elevated
      class="mt-14 grid scroll-mt-24 overflow-hidden sm:mt-16 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]"
    >
      <div class="flex flex-col justify-center p-6 sm:p-8">
        <h2
          id="factory-documents-heading"
          class="text-2xl font-semibold tracking-tight text-ink"
        >
          Factory Documents
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft sm:text-base">
          {factoryDocuments.length} test reports and certificates from
          {" "}{documentSources.join(" and ")}, with first-page previews and the
          limits of each record. Full source files are not published on this
          website.
        </p>
        <Button
          href={FACTORY_DOCUMENTS_PATH}
          variant="primary"
          size="lg"
          icon="arrow-right"
          iconPosition="end"
          class="mt-6 self-start"
          data-factory-documents-link=""
        >
          View all factory documents
        </Button>
      </div>
      <div
        aria-hidden="true"
        class="hidden grid-cols-3 gap-px border-l border-hairline bg-hairline md:grid"
      >
        {
          documentPreviews.map((document) => (
            <div class="overflow-hidden bg-white">
              <Image
                src={document.image}
                alt=""
                widths={[200, 320]}
                sizes="12rem"
                format="webp"
                quality={86}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top"
              />
            </div>
          ))
        }
      </div>
    </Card>
  </Container>
</Section>

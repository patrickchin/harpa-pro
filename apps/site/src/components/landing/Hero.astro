---
import { Image } from "astro:assets";
import procurementInteriorImg from "../../assets/agents/procurement-interior.jpg";
import Icon from "../Icon.astro";
---

<section id="top" class="relative border-b border-hairline">
  <div
    class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 md:py-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(30rem,1.1fr)] lg:gap-16"
  >
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-wider text-accent-ink">
        Harpa Pro procurement
      </p>
      <h1
        class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.4rem] lg:leading-[1.05]"
      >
        Your procurement agent in China.
      </h1>
      <p class="mt-5 text-base leading-relaxed text-ink-soft sm:text-lg">
        Haruna turns your design brief into a practical plan for sourcing and
        production. She follows the work through quality checks, shipment, and
        delivery.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/agents"
          class="inline-flex h-11 items-center gap-2 rounded-md bg-accent px-5 text-sm font-medium text-accent-foreground shadow-sm hover:brightness-95 ring-focus"
        >
          Meet Haruna <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a
          href="/agents#journey"
          class="inline-flex h-11 items-center gap-2 rounded-md border border-hairline bg-card px-5 text-sm font-medium text-ink shadow-sm hover:bg-secondary ring-focus"
        >
          See the eight stages
        </a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-soft">
        <li class="flex items-center gap-2">
          <Icon name="circle-check" class="h-3.5 w-3.5 shrink-0 text-ink" />
          Factory matching
        </li>
        <li class="flex items-center gap-2">
          <Icon name="circle-check" class="h-3.5 w-3.5 shrink-0 text-ink" />
          Production follow-up
        </li>
        <li class="flex items-center gap-2">
          <Icon name="circle-check" class="h-3.5 w-3.5 shrink-0 text-ink" />
          Quality and delivery
        </li>
      </ul>
    </div>

    <figure class="overflow-hidden rounded-xl border border-hairline bg-card shadow-sm">
      <Image
        src={procurementInteriorImg}
        alt="Contemporary living room with stone, timber, and fabric samples arranged for review"
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 64rem) 50vw, calc(100vw - 3rem)"
        format="webp"
        quality={84}
        loading="eager"
        decoding="async"
        class="aspect-[3/2] w-full object-cover"
      />
    </figure>
  </div>
</section>

---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Shared public-site section rhythm; `none` opts out. */
  padding?: "lg" | "md" | "none";
}

const { padding = "lg", class: extra = "", ...rest } = Astro.props;

const padCls =
  padding === "lg"
    ? "py-12 md:py-16"
    : padding === "md"
      ? "py-12"
      : "";

const cls = ["mx-auto max-w-6xl px-5 sm:px-6 xl:px-8", padCls, extra]
  .filter(Boolean)
  .join(" ");
---

<div class={cls} {...rest}><slot /></div>

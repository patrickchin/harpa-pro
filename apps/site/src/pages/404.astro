---
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Harpa Pro"
  description="The requested Harpa Pro page could not be found."
  noindex
>
  <div class="min-h-screen bg-background text-ink">
    <Header hideCta />
    <main class="mx-auto flex max-w-3xl flex-col px-4 py-20 sm:px-6 sm:py-28">
      <p class="text-xs font-bold uppercase tracking-wider text-accent-ink">
        Error 404
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        That page is not here.
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft">
        The link may be old, or the page may have moved into the Harpa Pro
        guides.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/docs"
          class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground ring-focus"
        >
          Browse guides
        </a>
        <a
          href="/"
          class="inline-flex min-h-11 items-center rounded-md border border-border px-4 text-sm font-semibold ring-focus"
        >
          Go to Harpa Pro
        </a>
        <a
          href="mailto:patrick@harpapro.com"
          class="inline-flex min-h-11 items-center rounded-md border border-border px-4 text-sm font-semibold ring-focus"
        >
          Contact support
        </a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

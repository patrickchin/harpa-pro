---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/landing/Header.astro";
import Footer from "../components/landing/Footer.astro";
import Section from "../components/primitives/Section.astro";
import Container from "../components/primitives/Container.astro";
import Icon from "../components/Icon.astro";
import { APP_STORE_URL } from "../lib/links";

const entries = (await getCollection("roadmap")).sort(
  (a, b) => a.data.order - b.data.order,
);

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      title: entry.data.title,
      icon: entry.data.icon,
      status: entry.data.status,
      Content,
    };
  }),
);

const groups: {
  id: "available" | "planned";
  label: string;
  heading: string;
  blurb: string;
}[] = [
  {
    id: "available",
    label: "Available now",
    heading: "Current reporting workflow",
    blurb:
      "Harpa Pro focuses on one job: turning field captures into daily site reports.",
  },
  {
    id: "planned",
    label: "Planned",
    heading: "Planned capability areas",
    blurb:
      "Planned features will reuse field captures so crews do not have to record the same work twice.",
  },
];
---

<Layout
  title="Site reporting roadmap | Harpa Pro"
  description="See the current Harpa Pro reporting workflow and the capabilities planned for future releases."
>
  <div class="min-h-screen bg-background text-ink">
    <Header />
    <main>
      <Section bordered="top">
        <Container padding="lg">
          <div class="max-w-2xl">
            <span
              class="text-xs font-semibold uppercase tracking-wider text-accent-ink"
            >
              Site reporting roadmap
            </span>
            <h1
              class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
            >
              Current and planned capabilities
            </h1>
            <p class="mt-4 text-base leading-relaxed text-ink-soft">
              Harpa Pro turns site updates into daily reports. Planned work
              will use the same captures for materials, equipment, people,
              costs, and cross-project insights. Priorities may change as we
              learn from project teams.
            </p>
          </div>
        </Container>
      </Section>

      {
        groups.map((group) => {
          const groupItems = items.filter((i) => i.status === group.id);
          if (groupItems.length === 0) return null;
          return (
            <Section
              tone={group.id === "available" ? "paper-2" : "default"}
              bordered="top"
            >
              <Container padding="lg">
                <div class="max-w-2xl">
                  <span class="text-xs font-semibold uppercase tracking-wider text-accent-ink">
                    {group.label}
                  </span>
                  <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                    {group.heading}
                  </h2>
                  <p class="mt-3 text-sm leading-relaxed text-ink-soft sm:text-base">
                    {group.blurb}
                  </p>
                </div>
                <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {groupItems.map(({ title, icon, Content }) => (
                    <div class="rounded-xl border border-hairline bg-card p-5">
                      <span class="grid h-9 w-9 place-items-center rounded-md border border-hairline bg-paper-2 text-ink">
                        <Icon name={icon} class="h-4 w-4" />
                      </span>
                      <h3 class="mt-4 text-base font-semibold text-ink">
                        {title}
                      </h3>
                      <div class="mt-1.5 text-sm leading-relaxed text-ink-soft prose-p:m-0">
                        <Content />
                      </div>
                    </div>
                  ))}
                </div>
              </Container>
            </Section>
          );
        })
      }

      <Section bordered="top">
        <Container padding="lg">
          <div
            class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between"
          >
            <p class="text-sm text-ink-soft">
              Harpa Pro is available on the App Store. The guides explain the
              current site reporting workflow.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/docs"
                class="inline-flex h-10 items-center rounded-md border border-hairline bg-card px-4 text-sm font-medium text-primary transition-colors hover:bg-secondary ring-focus"
              >
                View guides
              </a>
              <a
                href={APP_STORE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-10 items-center rounded-md border border-primary/30 bg-transparent px-4 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-primary-foreground ring-focus"
              >
                Get the app
              </a>
            </div>
          </div>
        </Container>
      </Section>
    </main>
    <Footer />
  </div>
</Layout>

---
import VoiceDemo from "./VoiceDemo.tsx";
import Icon from "../Icon.astro";
import Button from "../primitives/Button.astro";
import { APP_STORE_URL } from "../../lib/reports/links";
---

<section id="top" class="border-b border-hairline">
  <div
    class="mx-auto grid max-w-6xl gap-12 px-4 py-14 sm:px-6 md:py-16 lg:grid-cols-2 lg:gap-12"
  >
    <div class="flex flex-col justify-center">
      <h1
        class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.4rem] lg:leading-[1.05]"
      >
        Daily site reports from voice notes, photos, and text
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
        Harpa Pro is an AI construction daily report app for foremen and site
        supervisors. Talk, take photos, and add notes as work happens. Harpa
        Pro turns those updates into a structured daily report draft that you
        check, edit, and share as a PDF.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href={APP_STORE_URL} external size="lg">Get the app</Button>
        <Button
          href="#how"
          variant="secondary"
          size="lg"
          icon="arrow-right"
          iconPosition="end"
        >
          See the workflow
        </Button>
      </div>
      <ul class="mt-8 grid gap-2 text-sm text-ink-soft">
        <li class="inline-flex items-center gap-2">
          <Icon name="circle-check" class="h-4 w-4 text-ink" />
          Capture updates by voice, photo, or text
        </li>
        <li class="inline-flex items-center gap-2">
          <Icon name="circle-check" class="h-4 w-4 text-ink" />
          Get a structured daily report draft
        </li>
        <li class="inline-flex items-center gap-2">
          <Icon name="circle-check" class="h-4 w-4 text-ink" />
          Check and edit it before you share the PDF
        </li>
      </ul>
    </div>

    <div class="relative min-h-[640px] lg:pl-6" data-voice-demo>
      <VoiceDemo client:load />
    </div>
  </div>
</section>

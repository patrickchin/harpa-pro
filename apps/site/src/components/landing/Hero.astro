---
import Icon from "../Icon.astro";
import VoiceDemo from "../VoiceDemo.tsx";
import { APP_STORE_URL } from "../../lib/links";
---

<section id="top" class="relative border-b border-hairline">
  <div
    class="mx-auto grid max-w-6xl gap-12 px-4 py-14 sm:px-6 md:py-16 lg:grid-cols-2 lg:gap-12"
  >
    <div class="flex flex-col justify-center">
      <h1
        class="mt-5 text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.4rem] lg:leading-[1.05]"
      >
      Site Reports &mdash;<br>you talk, we write.
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
        Capture voice notes, photos, and text updates as work happens. Harpa Pro
        turns those captures into a draft daily report you can review, edit,
        finalize, and share.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={APP_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center gap-2 rounded-md bg-accent px-5 text-sm font-medium text-accent-foreground shadow-sm hover:brightness-95 ring-focus"
        >
          Get the app <Icon name="external-link" class="h-4 w-4" />
        </a>
        <a
          href="#how"
          class="inline-flex h-11 items-center gap-2 rounded-md border border-hairline bg-card px-5 text-sm font-medium text-ink shadow-sm hover:bg-secondary ring-focus"
        >
          See how it works <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <div
        class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-ink-soft"
      >
        <span class="inline-flex items-center gap-1.5">
          <Icon name="circle-check" class="h-3.5 w-3.5 text-ink" />
          Voice, photo, and text capture
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="circle-check" class="h-3.5 w-3.5 text-ink" />
          AI-assisted report drafts
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="circle-check" class="h-3.5 w-3.5 text-ink" />
          Review before you share
        </span>
      </div>
    </div>

    <!-- min-h matches the VoiceDemo card's fixed 640px height so the grid
         column reserves space before the React island hydrates, preventing
         the layout shift that caused CLS 0.125. client:only is required
         because VoiceDemo depends on NativeWind/RN-Web which cannot SSR. -->
    <div class="relative min-h-[640px] lg:pl-6">
      <VoiceDemo client:only="react" />
    </div>
  </div>
</section>

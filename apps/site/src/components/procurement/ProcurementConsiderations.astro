---
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import revitCoordinationImg from "../../assets/procurement/evidence/revit-a104-coordination.jpg";
import revitShopDrawingImg from "../../assets/procurement/evidence/revit-a103-shop-drawing.jpg";
// Pre-cropped from ais-factory-exterior.webp (sharp extract left 5, top 5,
// 871x478) to drop the catalogue's embedded caption and white border.
import aisFactoryImg from "../../assets/procurement/factories/ais-factory-exterior-photo.webp";
import aisProductionImg from "../../assets/procurement/factories/ais-production-overview.webp";
import aisPackingImg from "../../assets/procurement/factories/catalogues/ais-packing-p41.webp";
import aisHdfReportImg from "../../assets/procurement/factories/credentials/ais-hdf-formaldehyde-e0-2026.webp";
import { lightboxImage } from "../../lib/lightbox-image";

// Technical reviews live inside the Design and specification panel; each
// sheet opens the shared evidence lightbox.
const technicalReviews = [
  {
    title: "Revit A104 coordination review",
    description:
      "We check the layout, finishes, and sizes before we approve the factory information.",
    image: revitCoordinationImg,
    alt: "Revit A104 3D coordination review sheet",
  },
  {
    title: "Revit A103 shop-drawing review",
    description: "We review the drawings before production.",
    image: revitShopDrawingImg,
    alt: "Revit A103 chair shop drawing review sheet",
  },
];
const reviewLightboxes = await Promise.all(
  technicalReviews.map((review) => lightboxImage(review.image)),
);

const considerations = [
  {
    title: "Design and specification",
    description:
      "We check the drawings, dimensions, finishes, quantities, and approval requirements before the factory starts production.",
    image: revitCoordinationImg,
    alt: "Revit A104 coordination sheet with 3D interior views",
    crop: "contain",
    fit: "h-full w-full object-contain bg-white p-2",
    icon: "ruler",
    reviews: true,
  },
  {
    title: "Factory and product fit",
    description:
      "We compare the factory's capability, product range, production capacity, and records with the project brief.",
    image: aisFactoryImg,
    alt: "AIS Smarti headquarters and factory in Foshan, China",
    crop: "cover",
    fit: "h-full w-full object-cover",
    icon: "factory",
  },
  {
    title: "Materials and compliance",
    description:
      "We compare material declarations and test reports with the project's performance, emission, fire, and maintenance requirements.",
    image: aisHdfReportImg,
    alt: "First page of the AIS marine HDF formaldehyde test report",
    crop: "contain",
    fit: "h-full w-full object-contain bg-white p-2",
    icon: "shield-check",
  },
  {
    title: "Production quality",
    description:
      "We inspect materials, workmanship, dimensions, finishes, and finished goods at agreed points during production.",
    image: aisProductionImg,
    alt: "AIS Smarti production lines and factory floor",
    crop: "cover",
    fit: "h-full w-full object-cover",
    icon: "clipboard-check",
  },
  {
    title: "Packing and delivery",
    description:
      "We check packing, labels, collection, freight documents, and delivery records against the order.",
    image: aisPackingImg,
    alt: "AIS Smarti pallet and flat-pack packing examples",
    crop: "cover",
    fit: "h-full w-full object-cover",
    icon: "package-check",
  },
];
---

<!--
  Below lg the tablist and panel wrappers use display: contents so the open
  panel is ordered directly under its tab (accordion layout) while the DOM
  keeps valid tab/tabpanel ownership. At lg the tabs share row 1 and the
  selected panel spans row 2.
-->
<div data-considerations class="mt-8 grid gap-3 lg:grid-cols-5">
  <div
    role="tablist"
    aria-label="Procurement considerations"
    class="contents"
  >
    {
      considerations.map((consideration, index) => (
        <button
          id={`consideration-tab-${index + 1}`}
          type="button"
          role="tab"
          aria-label={consideration.title}
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`consideration-panel-${index + 1}`}
          tabindex={index === 0 ? 0 : -1}
          data-consideration-tab
          style={`--consideration-order: ${index * 2}`}
          class="group order-(--consideration-order) flex h-full min-h-[5.5rem] scroll-mt-24 w-full cursor-pointer flex-row items-center gap-4 rounded-xl border-2 border-border bg-card p-4 text-left text-ink shadow-sm transition-[border-color,background-color,box-shadow] hover:border-primary/50 hover:shadow-md aria-selected:border-primary aria-selected:bg-secondary aria-selected:shadow-md ring-focus lg:order-none lg:row-start-1 lg:min-h-[10.5rem] lg:flex-col lg:items-start lg:gap-0 lg:p-5"
        >
          <span
            data-consideration-icon
            class="grid h-10 w-10 flex-none place-items-center rounded-lg bg-secondary text-accent-ink transition-colors group-aria-selected:bg-primary group-aria-selected:text-primary-foreground"
          >
            <Icon name={consideration.icon} class="h-5 w-5" />
          </span>
          <span
            data-consideration-title
            class="min-w-0 text-base font-semibold leading-snug tracking-tight lg:mt-4"
          >
            {consideration.title}
          </span>
          <span
            data-consideration-action
            class="ml-auto inline-flex flex-none items-center gap-1.5 text-sm font-medium text-accent-ink group-aria-selected:text-primary lg:ml-0 lg:mt-auto lg:pt-5"
          >
            <span class="group-aria-selected:hidden">View details</span>
            <span class="hidden group-aria-selected:inline">Details shown</span>
            <Icon
              name="chevron-right"
              class="h-4 w-4 transition-transform group-aria-selected:rotate-90"
            />
          </span>
        </button>
      ))
    }
  </div>

  <div class="contents">
    {
      considerations.map((consideration, index) => (
        <div
          id={`consideration-panel-${index + 1}`}
          role="tabpanel"
          aria-labelledby={`consideration-tab-${index + 1}`}
          tabindex="0"
          hidden={index !== 0}
          data-consideration-panel
          style={`--consideration-order: ${index * 2 + 1}`}
          class="order-(--consideration-order) min-w-0 overflow-hidden rounded-2xl border border-border bg-card shadow-md ring-focus lg:order-none lg:col-span-full lg:row-start-2 lg:mt-3 lg:grid lg:grid-cols-[minmax(0,1.35fr)_minmax(19rem,0.65fr)]"
        >
          {consideration.reviews ? (
            <div
              id="technical-reviews"
              data-consideration-image-frame
              data-image-crop={consideration.crop}
              class="grid aspect-[16/10] w-full grid-cols-2 gap-px overflow-hidden bg-hairline lg:aspect-auto lg:h-[24rem]"
            >
              {technicalReviews.map((review, reviewIndex) => (
                <button
                  type="button"
                  aria-label={`Open full view of ${review.title}`}
                  class="evidence-image-trigger group/review relative block h-full min-h-0 w-full border-0 bg-white p-0 ring-focus"
                  data-technical-review
                  data-evidence-image-trigger
                  data-evidence-image-src={reviewLightboxes[reviewIndex]!.src}
                  data-evidence-image-alt={review.alt}
                  data-evidence-image-title={review.title}
                  data-evidence-image-caption={review.description}
                  data-evidence-image-width={reviewLightboxes[reviewIndex]!.width}
                  data-evidence-image-height={reviewLightboxes[reviewIndex]!.height}
                >
                  <Image
                    src={review.image}
                    alt={review.alt}
                    widths={[360, 480, 720]}
                    sizes="(min-width: 64rem) 24rem, calc(50vw - 1.5rem)"
                    format="webp"
                    quality={86}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain p-2"
                  />
                  <span
                    aria-hidden="true"
                    class="absolute bottom-2 left-2 inline-flex items-center gap-1.5 rounded-sm bg-primary/90 px-2 py-1 text-xs font-medium text-primary-foreground"
                  >
                    <Icon name="maximize-2" class="h-3.5 w-3.5" />
                    {review.title.replace("Revit ", "").replace(" Review", "")}
                  </span>
                </button>
              ))}
            </div>
          ) : (
            <div
              data-consideration-image-frame
              data-image-crop={consideration.crop}
              class="aspect-[16/10] w-full overflow-hidden bg-white lg:aspect-auto lg:h-[24rem]"
            >
              <Image
                src={consideration.image}
                alt={consideration.alt}
                widths={[480, 720, 960, 1200]}
                sizes="(min-width: 64rem) 48rem, calc(100vw - 3rem)"
                format="webp"
                quality={86}
                loading="lazy"
                decoding="async"
                class={consideration.fit}
              />
            </div>
          )}
          <div class="flex flex-col justify-end border-t border-hairline p-6 sm:p-8 lg:min-h-0 lg:border-l lg:border-t-0 lg:p-10">
            <h3 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
              {consideration.title}
            </h3>
            <p class="mt-4 text-base leading-relaxed text-ink-soft sm:text-lg">
              {consideration.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  function initializeConsiderations(root: HTMLElement) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-consideration-tab]"),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>("[data-consideration-panel]"),
    );

    function activate(index: number, moveFocus = false) {
      // In the stacked (accordion) layout, closing a panel above the chosen
      // tab would shift it upward; keep the tab where the user left it.
      const nextTab = tabs[index];
      const topBefore = nextTab?.getBoundingClientRect().top;

      tabs.forEach((tab, tabIndex) => {
        const isSelected = tabIndex === index;
        tab.setAttribute("aria-selected", String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        const panel = panels[tabIndex];
        if (panel) panel.hidden = !isSelected;
      });

      if (nextTab && topBefore !== undefined) {
        const shift = nextTab.getBoundingClientRect().top - topBefore;
        if (Math.abs(shift) > 1) window.scrollBy({ top: shift, behavior: "instant" });
      }
      if (moveFocus && nextTab) nextTab.focus();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(index));
      tab.addEventListener("keydown", (event) => {
        let nextIndex: number;

        if (event.key === "ArrowDown" || event.key === "ArrowRight") {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = tabs.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        activate(nextIndex, true);
      });
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-considerations]")
    .forEach(initializeConsiderations);
</script>

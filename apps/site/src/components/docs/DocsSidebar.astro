---
import type { CollectionEntry } from "astro:content";

import {
  DOCS_CATEGORIES,
  guideHref,
  guideSlug,
} from "../../lib/docs";

interface Props {
  guides: CollectionEntry<"docs">[];
  currentSlug?: string;
}

const { guides, currentSlug } = Astro.props;
---

<nav aria-label="Guide categories" class="docs-sidebar-nav">
  {
    DOCS_CATEGORIES.map((category) => {
      const categoryGuides = guides.filter(
        (guide) => guide.data.category === category.id,
      );
      if (categoryGuides.length === 0) return null;

      return (
        <section>
          <h2>{category.label}</h2>
          <ul>
            {categoryGuides.map((guide) => {
              const slug = guideSlug(guide.id);
              return (
                <li>
                  <a
                    href={guideHref(guide.id)}
                    aria-current={slug === currentSlug ? "page" : undefined}
                  >
                    {guide.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })
  }
</nav>

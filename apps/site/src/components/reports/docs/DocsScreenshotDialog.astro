<dialog
  class="docs-screenshot-dialog"
  aria-labelledby="docs-screenshot-dialog-title"
  data-docs-screenshot-dialog
>
  <div class="docs-screenshot-dialog-panel">
    <header>
      <h2 id="docs-screenshot-dialog-title" data-docs-screenshot-dialog-title>
        Full Screenshot
      </h2>
      <button
        class="docs-screenshot-dialog-close"
        type="button"
        aria-label="Close full screenshot"
        data-docs-screenshot-dialog-close
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>
    <figure>
      <div
        class="docs-screenshot-dialog-image"
        aria-busy="false"
        data-docs-screenshot-dialog-region
      >
        <img data-docs-screenshot-dialog-image alt="" decoding="async" />
      </div>
      <figcaption data-docs-screenshot-dialog-caption></figcaption>
    </figure>
  </div>
</dialog>

<style>
  /* The thumbnail preview is smaller than the full derivative; fill the same
     box the full screenshot will occupy so the swap does not resize. */
  .docs-screenshot-dialog-image img[data-docs-screenshot-state="preview"] {
    filter: blur(6px);
    height: 100%;
    object-fit: contain;
    opacity: 0.88;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-docs-screenshot-dialog]",
  );

  if (dialog) {
    const image = dialog.querySelector<HTMLImageElement>(
      "[data-docs-screenshot-dialog-image]",
    );
    const title = dialog.querySelector<HTMLElement>(
      "[data-docs-screenshot-dialog-title]",
    );
    const caption = dialog.querySelector<HTMLElement>(
      "[data-docs-screenshot-dialog-caption]",
    );
    const closeButton = dialog.querySelector<HTMLButtonElement>(
      "[data-docs-screenshot-dialog-close]",
    );
    const imageRegion = dialog.querySelector<HTMLElement>(
      "[data-docs-screenshot-dialog-region]",
    );
    let activeTrigger: HTMLAnchorElement | null = null;
    let imageRequest = 0;

    document
      .querySelectorAll<HTMLAnchorElement>("[data-docs-screenshot-trigger]")
      .forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          if (!image || !title || !caption || !dialog.showModal) return;

          const source = trigger.dataset.docsScreenshotSrc;
          if (!source) return;

          event.preventDefault();
          activeTrigger = trigger;
          const request = ++imageRequest;

          // Show the already-loaded thumbnail (same screenshot, smaller
          // derivative) while the full-view derivative downloads.
          const previewImage = trigger.querySelector<HTMLImageElement>("img");
          const previewSource =
            previewImage?.complete && previewImage.naturalWidth > 0
              ? previewImage.currentSrc || previewImage.src
              : "";
          const hasPreview = Boolean(
            previewSource &&
              previewSource !== new URL(source, window.location.href).href,
          );

          const stepTitle = trigger.dataset.docsScreenshotTitle ?? "guide step";
          image.setAttribute("src", hasPreview ? previewSource : source);
          image.dataset.docsScreenshotState = hasPreview ? "preview" : "full";
          imageRegion?.setAttribute("aria-busy", String(hasPreview));
          image.alt = trigger.dataset.docsScreenshotAlt ?? "";
          if (trigger.dataset.docsScreenshotWidth) {
            image.setAttribute("width", trigger.dataset.docsScreenshotWidth);
          }
          if (trigger.dataset.docsScreenshotHeight) {
            image.setAttribute("height", trigger.dataset.docsScreenshotHeight);
          }
          title.textContent = `Full screenshot for ${stepTitle}`;
          caption.textContent = stepTitle;
          dialog.showModal();

          if (!hasPreview) return;

          const fullImage = new Image();
          fullImage.decoding = "async";
          fullImage.fetchPriority = "high";
          fullImage.addEventListener(
            "load",
            () => {
              void fullImage
                .decode()
                .catch(() => undefined)
                .then(() => {
                  if (
                    request !== imageRequest ||
                    activeTrigger !== trigger ||
                    !dialog.open
                  ) {
                    return;
                  }

                  image.setAttribute("src", source);
                  image.dataset.docsScreenshotState = "full";
                  imageRegion?.setAttribute("aria-busy", "false");
                });
            },
            { once: true },
          );
          fullImage.addEventListener(
            "error",
            () => {
              if (request !== imageRequest || activeTrigger !== trigger) return;
              image.dataset.docsScreenshotState = "fallback";
              imageRegion?.setAttribute("aria-busy", "false");
            },
            { once: true },
          );
          fullImage.src = source;
        });
      });

    closeButton?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      imageRequest += 1;
      image?.removeAttribute("src");
      image?.removeAttribute("data-docs-screenshot-state");
      imageRegion?.setAttribute("aria-busy", "false");
      activeTrigger?.focus();
      activeTrigger = null;
    });
  }
</script>

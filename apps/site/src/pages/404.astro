---
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Layout from "../layouts/Layout.astro";
import Button from "../components/primitives/Button.astro";
import Container from "../components/primitives/Container.astro";
---

<Layout
  title="Page not found | Harpa Pro"
  description="The requested Harpa Pro page could not be found."
  noindex
>
  <div class="min-h-screen bg-background text-ink">
    <Header hideCta />
    <main>
      <Container padding="lg" class="flex max-w-3xl flex-col">
        <p class="site-eyebrow">
          Error 404
        </p>
        <h1 class="site-page-title mt-2">
          That page is not here.
        </h1>
        <p class="mt-4 max-w-xl text-base leading-6 text-ink-soft">
          The link may be old, or the page may have moved into the Harpa Pro
          guides.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/docs" variant="primary">
            Browse guides
          </Button>
          <Button href="/" variant="ghost">
            Go to Harpa Pro
          </Button>
          <Button href="mailto:patrick@harpapro.com" variant="ghost">
            Contact support
          </Button>
        </div>
      </Container>
    </main>
    <Footer />
  </div>
</Layout>

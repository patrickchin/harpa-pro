---
import Wordmark from "./Wordmark.astro";
import Container from "../primitives/Container.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline">
  <Container
    padding="none"
    class="flex flex-col items-start justify-between gap-6 py-8 md:flex-row md:items-center"
  >
    <div class="flex flex-col gap-2">
      <Wordmark />
      <p class="text-xs text-ink-soft">
        Construction site reporting made easy
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-sm text-ink-soft">
      <a href="/roadmap" class="inline-flex min-h-11 items-center rounded-md px-2 hover:bg-secondary hover:text-ink ring-focus">Roadmap</a>
      <a href="/docs" class="inline-flex min-h-11 items-center rounded-md px-2 hover:bg-secondary hover:text-ink ring-focus">Docs</a>
      <a href="/privacy" class="inline-flex min-h-11 items-center rounded-md px-2 hover:bg-secondary hover:text-ink ring-focus">Privacy</a>
      <a href="mailto:patrick@harpapro.com" class="inline-flex min-h-11 items-center rounded-md px-2 hover:bg-secondary hover:text-ink ring-focus">Contact</a>
      <span class="hidden sm:inline">© {year} Harpa Pro</span>
    </div>
  </Container>
</footer>

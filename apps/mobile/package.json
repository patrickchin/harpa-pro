{
  "name": "@harpa/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "ios": "expo run:ios",
    "ios:mock": "EXPO_PUBLIC_USE_FIXTURES=true expo run:ios",
    "android": "expo run:android",
    "start": "expo start --dev-client",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:nocoverage": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --ext .ts,.tsx",
    "build": "echo 'mobile build (EAS) — see infra/'",
    "bundle:smoke": "bash scripts/bundle-smoke.sh",
    "gen:hooks": "tsx scripts/gen-hooks.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.28",
    "@expo/metro-runtime": "~55.0",
    "@harpa/api-contract": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "^8.23.0",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "better-auth": "1.6.28",
    "clsx": "^2.1.1",
    "expo": "~55.0.26",
    "expo-asset": "~55.0.17",
    "expo-audio": "^55.0.14",
    "expo-camera": "^55.0.19",
    "expo-clipboard": "^55.0.13",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "^55.0.35",
    "expo-file-system": "^55.0.22",
    "expo-image": "^55.0.11",
    "expo-image-manipulator": "^55.0.17",
    "expo-image-picker": "^55.0.20",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.15",
    "expo-media-library": "^55.0.17",
    "expo-network": "~55.0.14",
    "expo-print": "^55.0.13",
    "expo-router": "~55.0.16",
    "expo-secure-store": "^55.0.14",
    "expo-sharing": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "^55.0.24",
    "immer": "^11.1.16",
    "lucide-react-native": "^1.31.0",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-pager-view": "8.0.0",
    "react-native-pdf": "^7.0.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "~0.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.14",
    "zod": "4.4.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "clsx"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "jsdom": "^30.0.1",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}

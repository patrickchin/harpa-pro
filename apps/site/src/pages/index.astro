---
import { getImage, Image } from "astro:assets";
import ProcurementConsiderations from "../components/agents/ProcurementConsiderations.astro";
import ProcurementEvidence from "../components/agents/ProcurementEvidence.astro";
import Icon from "../components/Icon.astro";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Container from "../components/primitives/Container.astro";
import Section from "../components/primitives/Section.astro";
import Layout from "../layouts/Layout.astro";
import LuxuryEffects from "../components/agents/LuxuryEffects.astro";
import "../styles/luxury.css";
import woodInteriorImg from "../assets/agents/finishes/wood.webp";
import stoneInteriorImg from "../assets/agents/finishes/stone.webp";
import modernInteriorImg from "../assets/agents/finishes/modern.webp";
import hashyImg from "../assets/team/hashy.jpg";
import harunaImg from "../assets/team/haruna.jpg";

const title = "Luxury Interior Procurement in China | Harpa Pro";
const description = "Harpa Pro coordinates interior procurement in China: design specifications, factory coordination, quality checks, shipping, and procurement documentation.";
const homeUrl = new URL("/", Astro.site).href;
const materialSchemes = await Promise.all([
  {
    key: "wood",
    label: "Wood",
    source: woodInteriorImg,
    alt: "Generated interior concept with warm wood finishes in a contemporary living room",
  },
  {
    key: "stone",
    label: "Stone & Marble",
    source: stoneInteriorImg,
    alt: "Generated interior concept with stone and marble finishes in the same contemporary living room",
  },
  {
    key: "modern",
    label: "Glass & Modern",
    source: modernInteriorImg,
    alt: "Generated interior concept with glass and modern finishes in the same contemporary living room",
  },
].map(async (scheme) => ({
  ...scheme,
  caption: `Material concept · ${scheme.label}`,
  image: await getImage({
    src: scheme.source,
    widths: [640, 960, 1280, 1600],
    sizes: "100vw",
    format: "webp",
    quality: 84,
  }),
})));
const socialImage = await getImage({
  src: woodInteriorImg,
  width: 1200,
  height: 630,
  format: "png",
});
const defaultScheme = materialSchemes[0]!;
const structuredData = [{
  "@type": "Service",
  "@id": `${homeUrl}#procurement`,
  name: "Luxury Interior Procurement in China",
  serviceType: "Interior procurement",
  description,
  url: homeUrl,
  areaServed: { "@type": "Country", name: "China" },
  provider: { "@id": `${homeUrl}#organization` },
  mainEntityOfPage: { "@id": `${homeUrl}#webpage` },
}];
const procurementQuestions = [
  {
    topic: "understand",
    label: "How it works",
    message: "Hi Harpa Pro, how can you help with interior procurement in China?",
    question: "What does an interior procurement agent in China do?",
    answer: "Harpa Pro coordinates design specifications, factory selection, technical approvals, production quality checks, packing, and shipping records. We keep drawings, product data, approvals, and procurement documents together for the project.",
  },
  {
    topic: "source",
    label: "Find products",
    message: "Hi Harpa Pro, I'd like help sourcing furniture or interior products from China.",
    question: "What furniture and interior products can Harpa Pro help source?",
    answer: "Our selected factory partners cover custom cabinetry and joinery, hospitality furniture, office desks and seating, steel storage, and bathroom cabinets and shower systems. We match each order with the factory that meets its design specifications.",
  },
  {
    topic: "quality",
    label: "Quality checks",
    message: "Hi Harpa Pro, I'd like help checking materials or production quality for my order.",
    question: "How are materials and production quality checked?",
    answer: "We compare material declarations and test reports with the project's performance, emission, fire, and maintenance requirements. At agreed points during production, we inspect materials, workmanship, dimensions, finishes, and finished goods. Packing, labels, quantities, and freight documents are checked against the order.",
  },
  {
    topic: "brief",
    label: "Start a project",
    message: "Hi Harpa Pro, I'd like to start an interior procurement project. What should I send you?",
    question: "What should I send to start a procurement project?",
    answer: "Send the project brief, drawings or product references, dimensions, finishes, quantities, and approval requirements. Our procurement team coordinates technical approvals and keeps the project record complete.",
  },
];
---

<Layout
  title={title}
  description={description}
  image={socialImage.src}
  imageAlt={defaultScheme.alt}
  structuredData={structuredData}
>
  <div class="luxury-site min-h-screen bg-background text-ink">
    <Header />
    <div class="luxury-reading-progress" aria-hidden="true"></div>
    <main class="agents-page">
      <section id="top" class="bg-background">
        <div class="luxury-hero-shell">
          <figure
            data-hero-visual
            data-material-view="wood"
            class="luxury-hero relative isolate overflow-hidden bg-primary"
          >
            <Image
              src={woodInteriorImg}
              alt={defaultScheme.alt}
              data-material-image
              aria-busy="false"
              widths={[640, 960, 1280, 1600]}
              sizes="100vw"
              format="webp"
              quality={84}
              priority
              class="luxury-hero-image absolute inset-0 h-full w-full object-cover"
            />
            <div
              data-hero-scrim
              aria-hidden="true"
              class="hero-scrim absolute inset-0"
            ></div>
            <div class="luxury-hero-topline" aria-hidden="true">
              <span>Interior procurement · China</span>
              <span>Design / Materials / Detail</span>
            </div>
            <figcaption
              data-hero-copy
              class="luxury-hero-copy relative z-10"
            >
              <div class="luxury-hero-title-group">
                <h1 class="luxury-hero-title">
                  <span>Luxury Interior</span>{" "}<span><em>Procurement</em> in China</span>
                </h1>
                <p class="luxury-hero-description">
                  We manage design specifications, factory coordination, quality
                  checks, shipment, and complete procurement documentation
                  (approved health, safety, and quality standards).
                </p>
                <div class="luxury-hero-actions">
                  <a href="#contact" class="luxury-button ring-focus">
                    Discuss your project <Icon name="arrow-up-right" class="h-4 w-4" />
                  </a>
                  <a href="#considerations" class="luxury-text-link ring-focus">
                    Explore our approach <Icon name="arrow-down" class="h-4 w-4" />
                  </a>
                </div>
              </div>
            </figcaption>
            <div class="luxury-material-controls" data-material-controls hidden>
              <p>A closer look</p>
              <div role="group" aria-label="Interior material concepts">
                {materialSchemes.map((scheme) => (
                  <button
                    type="button"
                    data-material-choice={scheme.key}
                    data-material-src={scheme.image.src}
                    data-material-srcset={scheme.image.srcSet.attribute}
                    data-material-sizes="100vw"
                    data-material-alt={scheme.alt}
                    data-material-description={scheme.caption}
                    data-material-label={scheme.label}
                    aria-pressed={scheme.key === "wood" ? "true" : "false"}
                    class="ring-focus"
                  >
                    <span class={`luxury-swatch luxury-swatch-${scheme.key}`} aria-hidden="true"></span>
                    {scheme.label}
                  </button>
                ))}
              </div>
            </div>
            <span class="luxury-material-caption" data-material-caption role="status" aria-live="polite">{defaultScheme.caption}</span>
          </figure>
        </div>
        <div class="luxury-service-line">
          <p>Design specifications <span aria-hidden="true">↗</span> Factory coordination <span aria-hidden="true">↗</span> Quality checks <span aria-hidden="true">↗</span> Delivery</p>
          <a href="#evidence" class="ring-focus">Explore the project details <Icon name="arrow-down-right" class="h-4 w-4" /></a>
        </div>
      </section>

      <Section id="considerations" tone="paper-2" bordered="top" class="scroll-mt-16">
        <Container padding="lg">
          <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
            What We Consider
          </h2>

          <ProcurementConsiderations />
        </Container>
      </Section>

      <ProcurementEvidence />

      <Section id="agent" tone="paper-2" bordered="top">
        <Container padding="lg" data-procurement-profiles class="grid gap-6 xl:grid-cols-2">
          <article
            data-procurement-profile="haruna"
            class="rounded-2xl border border-hairline bg-card p-5 shadow-sm sm:p-6"
          >
            <div class="grid gap-4 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-5 xl:min-h-56">
              <figure
                data-profile-portrait
                class="h-40 w-40 overflow-hidden rounded-xl bg-primary sm:h-52 sm:w-52"
              >
                <Image
                  src={harunaImg}
                  alt="Haruna Bayoh"
                  widths={[320, 416, 624]}
                  sizes="(min-width: 40rem) 13rem, 10rem"
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-[center_24%]"
                />
              </figure>

              <div data-profile-bio class="min-w-0">
                <h2 class="text-xl font-semibold tracking-tight text-ink sm:text-2xl">
                  Procurement Lead
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                  Haruna Bayoh is Harpa Pro's procurement lead in China. He receives
                  the project brief, coordinates technical approvals, records quality
                  standards and inspections, controls the order, and keeps the project
                  files complete.
                </p>
                <a
                  href="https://www.linkedin.com/in/harunabayoh/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary ring-focus"
                >
                  LinkedIn profile <Icon name="external-link" class="h-4 w-4" />
                </a>
              </div>
            </div>

            <dl
              data-profile-credentials
              class="mt-5 grid grid-cols-3 gap-3 border-y border-hairline py-4 text-sm"
            >
              <div>
                <dt class="text-ink-soft">Discipline</dt>
                <dd class="mt-1 font-medium text-ink">Architecture and materials</dd>
              </div>
              <div>
                <dt class="text-ink-soft">Education</dt>
                <dd class="mt-1 font-medium text-ink">Master's degree</dd>
              </div>
              <div>
                <dt class="text-ink-soft">Experience</dt>
                <dd class="mt-1 font-medium text-ink">6 years</dd>
              </div>
            </dl>

            <dl class="mt-5 grid grid-cols-2 gap-x-5 gap-y-4">
              <div>
                <dt class="text-sm font-semibold text-ink">Technical Coordination</dt>
                <dd class="mt-1 text-sm leading-relaxed text-ink-soft">
                  Drawings, dimensions, finishes, and approval records.
                </dd>
              </div>
              <div>
                <dt class="text-sm font-semibold text-ink">Order Control</dt>
                <dd class="mt-1 text-sm leading-relaxed text-ink-soft">
                  Quantities, approvals, inspections, and order checks.
                </dd>
              </div>
              <div>
                <dt class="text-sm font-semibold text-ink">Document Record</dt>
                <dd class="mt-1 text-sm leading-relaxed text-ink-soft">
                  Product data, certificates, approvals, and project files.
                </dd>
              </div>
            </dl>
          </article>

          <article
            data-procurement-profile="hashy"
            class="rounded-2xl border border-hairline bg-card p-5 shadow-sm sm:p-6"
          >
            <div class="grid gap-4 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-5 xl:min-h-56">
              <figure
                data-profile-portrait
                class="h-40 w-40 overflow-hidden rounded-xl bg-primary sm:h-52 sm:w-52"
              >
                <Image
                  src={hashyImg}
                  alt="Hashy"
                  widths={[320, 416, 624]}
                  sizes="(min-width: 40rem) 13rem, 10rem"
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-center"
                />
              </figure>

              <div data-profile-bio class="min-w-0">
                <h2 class="text-xl font-semibold tracking-tight text-ink sm:text-2xl">
                  Procurement Specialist
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                  Hashy is Harpa Pro's procurement specialist for factory coordination
                  and shipping logistics.
                </p>
              </div>
            </div>

            <dl
              data-profile-credentials
              class="mt-5 grid grid-cols-3 gap-3 border-y border-hairline py-4 text-sm"
            >
              <div>
                <dt class="text-ink-soft">Discipline</dt>
                <dd class="mt-1 font-medium text-ink">Procurement &amp; Logistics</dd>
              </div>
              <div>
                <dt class="text-ink-soft">Education</dt>
                <dd class="mt-1 font-medium text-ink">Bachelor's degree</dd>
              </div>
              <div>
                <dt class="text-ink-soft">Experience</dt>
                <dd class="mt-1 font-medium text-ink">4 years</dd>
              </div>
            </dl>

            <dl class="mt-5 grid grid-cols-2 gap-x-5 gap-y-4">
              <div>
                <dt class="text-sm font-semibold text-ink">Factory Coordination</dt>
                <dd class="mt-1 text-sm leading-relaxed text-ink-soft">
                  Capability, samples, quotations, and production questions.
                </dd>
              </div>
              <div>
                <dt class="text-sm font-semibold text-ink">Shipping Logistics</dt>
                <dd class="mt-1 text-sm leading-relaxed text-ink-soft">
                  Packing, freight documents, shipment coordination, and delivery
                  records.
                </dd>
              </div>
            </dl>
          </article>
        </Container>
      </Section>

      <Section id="procurement-questions" bordered="top">
        <Container padding="lg">
          <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
            Procurement Questions
          </h2>
          <div class="mt-8 grid gap-8 md:grid-cols-2">
            {procurementQuestions.map(({ question, answer, topic }) => (
              <article class="max-w-xl">
                <h3 class="text-lg font-semibold leading-snug text-ink">{question}</h3>
                <p class="mt-3 text-base leading-relaxed text-ink-soft">{answer}</p>
                <a href="#whatsapp-message" data-whatsapp-topic={topic} aria-label={`Ask us: ${question}`} class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink underline underline-offset-4 ring-focus">
                  Ask us <Icon name="arrow-up-right" class="h-4 w-4" />
                </a>
              </article>
            ))}
          </div>
        </Container>
      </Section>

      <Section id="contact" tone="paper-2" bordered="top" class="scroll-mt-16">
        <Container padding="lg">
          <div class="grid gap-10 lg:grid-cols-[minmax(0,0.78fr)_minmax(32rem,1.22fr)] lg:gap-16">
            <div class="max-w-xl">
              <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
                Contact Us
              </h2>
              <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">
                Email or message us about an interior procurement project in
                China.
              </p>
            </div>

            <dl class="grid min-w-0 gap-5 sm:grid-cols-2">
              <div id="whatsapp-message" class="scroll-mt-24 rounded-xl border border-hairline bg-card p-6 shadow-sm ph-no-autocapture">
                <dt class="flex items-center gap-2 text-sm font-semibold text-ink">
                  <Icon name="message-circle" class="h-4 w-4 text-accent-ink" />
                  WhatsApp
                </dt>
                <dd class="mt-4">
                  <p class="font-mono text-sm text-ink">+86 193 7283 7269</p>
                  <a
                    href="https://wa.me/8619372837269"
                    data-contact-event="contact_whatsapp_clicked"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-md border border-primary/30 px-4 text-sm font-medium text-primary hover:bg-card ring-focus"
                  >
                    Message on WhatsApp
                    <Icon name="external-link" class="h-4 w-4" />
                  </a>
                  <button type="button" data-whatsapp-open hidden class="mt-3 min-h-11 items-center gap-2 rounded-sm border border-primary/30 px-4 text-left text-sm font-medium text-primary hover:bg-secondary ring-focus">
                    <Icon name="message-circle" class="h-4 w-4 shrink-0" />
                    Help me write a message
                  </button>
                  <dialog class="whatsapp-dialog ph-no-autocapture" aria-labelledby="whatsapp-title" data-whatsapp-dialog>
                    <div class="p-6">
                      <div class="flex items-center justify-between gap-4">
                        <h3 id="whatsapp-title" class="text-xl font-semibold text-ink">Tell us what you need</h3>
                        <button type="button" data-whatsapp-close aria-label="Close message helper" class="inline-flex h-11 w-11 shrink-0 items-center justify-center text-ink ring-focus">
                          <Icon name="x" class="h-5 w-5" />
                        </button>
                      </div>
                      <label for="whatsapp-topic" class="mt-3 block text-sm font-medium text-ink">I need help with</label>
                      <select id="whatsapp-topic" autofocus class="whatsapp-field mt-2 ring-focus">
                        {procurementQuestions.map(({ topic, label, message }) => (
                          <option value={topic} data-message={message}>{label}</option>
                        ))}
                      </select>
                      <p id="whatsapp-hint" class="mt-3 text-xs text-ink-soft">Share what you know. These details are optional.</p>
                      <label for="whatsapp-products" class="mt-4 block text-sm font-medium text-ink">What are you looking for?</label>
                      <input id="whatsapp-products" type="text" maxlength="300" placeholder="e.g. 30 desks for a hotel" class="whatsapp-field mt-2 ring-focus" />
                      <fieldset class="mt-4">
                        <legend class="text-sm font-medium text-ink">Any preferred materials?</legend>
                        <div class="mt-2 flex flex-wrap gap-2">
                          {["Wood", "Stone / marble", "Metal", "Glass", "Fabric / leather"].map((material) => (
                            <label class="whatsapp-material">
                              <input type="checkbox" name="whatsapp-material" value={material} />
                              {material}
                            </label>
                          ))}
                        </div>
                      </fieldset>
                      <label for="whatsapp-destination" class="mt-4 block text-sm font-medium text-ink">Where should it be delivered?</label>
                      <input id="whatsapp-destination" type="text" maxlength="150" placeholder="City or country" class="whatsapp-field mt-2 ring-focus" />
                      <a href="https://wa.me/8619372837269" data-whatsapp-link data-contact-event="contact_whatsapp_clicked" target="_blank" rel="noopener noreferrer" class="whatsapp-continue mt-5 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-sm px-4 text-sm font-medium ring-focus">
                        Continue in WhatsApp <Icon name="external-link" class="h-4 w-4" />
                      </a>
                      <p class="mt-2 text-center text-xs text-ink-soft">Review and send in WhatsApp.</p>
                    </div>
                  </dialog>
                </dd>
              </div>
              <div class="rounded-xl border border-hairline bg-card p-6 shadow-sm">
                <dt class="flex items-center gap-2 text-sm font-semibold text-ink">
                  <Icon name="mail" class="h-4 w-4 text-accent-ink" />
                  Email
                </dt>
                <dd class="mt-4">
                  <p class="select-all break-all font-mono text-sm text-ink">
                    haruna@harpapro.com
                  </p>
                  <div
                    class="mt-5 flex flex-wrap gap-3"
                    data-contact-email-actions
                  >
                    <button
                      type="button"
                      class="inline-flex h-10 items-center gap-2 rounded-md bg-accent-ink px-4 text-sm font-medium text-accent-foreground shadow-sm hover:brightness-95 ring-focus"
                      data-copy-email
                      data-email="haruna@harpapro.com"
                    >
                      <Icon name="copy" class="h-4 w-4" />
                      Copy email
                    </button>
                    <a
                      href="mailto:haruna@harpapro.com"
                      data-contact-event="contact_email_opened"
                      class="inline-flex h-10 items-center gap-2 rounded-md border border-hairline px-4 text-sm font-medium text-ink hover:bg-secondary ring-focus"
                    >
                      Open email app
                    </a>
                  </div>
                  <p
                    class="mt-3 min-h-5 text-xs text-ink-soft"
                    role="status"
                    aria-live="polite"
                    data-copy-email-status
                  ></p>
                </dd>
              </div>

            </dl>
          </div>
        </Container>
      </Section>
    </main>
    <Footer />
    <LuxuryEffects />
  </div>

  <script>
    import { captureContact } from "../lib/analytics";

    const dialog = document.querySelector<HTMLDialogElement>("[data-whatsapp-dialog]");
    const topic = document.querySelector<HTMLSelectElement>("#whatsapp-topic");
    const products = document.querySelector<HTMLInputElement>("#whatsapp-products");
    const destination = document.querySelector<HTMLInputElement>("#whatsapp-destination");
    const whatsappLink = document.querySelector<HTMLAnchorElement>("[data-whatsapp-link]");

    if (dialog?.showModal && topic && products && destination && whatsappLink) {
      let trigger: HTMLElement | null = null;
      const updateLink = () => {
        const materials = Array.from(dialog.querySelectorAll<HTMLInputElement>('input[name="whatsapp-material"]:checked'), (input) => input.value);
        const message = [
          topic.selectedOptions[0]!.dataset.message!,
          products.value.trim() && `Products: ${products.value.trim()}`,
          materials.length && `Preferred materials: ${materials.join(", ")}`,
          destination.value.trim() && `Delivery: ${destination.value.trim()}`,
        ].filter(Boolean).join("\n\n");
        const url = new URL(whatsappLink.href);
        url.searchParams.set("text", message);
        whatsappLink.href = url.href;
      };
      dialog.addEventListener("input", updateLink);
      dialog.addEventListener("change", updateLink);
      document.querySelectorAll<HTMLElement>("[data-whatsapp-open], [data-whatsapp-topic]").forEach((link) => {
        link.addEventListener("click", (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          trigger = link;
          if (link.dataset.whatsappTopic) topic.value = link.dataset.whatsappTopic;
          updateLink();
          dialog.showModal();
        });
      });
      dialog.querySelector("[data-whatsapp-close]")?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener("close", () => trigger?.focus());
      const helperButton = document.querySelector<HTMLButtonElement>("[data-whatsapp-open]");
      if (helperButton) {
        helperButton.hidden = false;
        helperButton.classList.add("inline-flex");
      }
      updateLink();
    }

    const copyEmailButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    const copyEmailStatus = document.querySelector<HTMLElement>("[data-copy-email-status]");

    copyEmailButton?.addEventListener("click", async () => {
      const email = copyEmailButton.dataset.email;
      if (!email || !copyEmailStatus) return;

      try {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(email);
        copyEmailStatus.textContent = "Email copied";
        captureContact('contact_email_copied');
      } catch {
        copyEmailStatus.textContent = "Select and copy the email address above";
      }
    });
  </script>
</Layout>

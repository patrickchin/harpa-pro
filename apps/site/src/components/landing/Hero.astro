---
import Icon from "../Icon.astro";
import VoiceDemo from "../VoiceDemo.tsx";
import Button from "../primitives/Button.astro";
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";
import { APP_STORE_URL } from "../../lib/links";
---

<Section id="top" class="relative" bordered="y">
  <Container class="grid gap-8 lg:grid-cols-2 lg:gap-12">
    <div class="flex flex-col justify-center">
      <h1
        class="text-[length:var(--font-size-display)] font-bold leading-[var(--line-height-display)] text-ink"
      >
        Site reports &mdash; you talk, we write.
      </h1>
      <p class="site-body-large mt-4">
        Now available for iPhone. Capture field updates by voice, photo, or
        typed note. Harpa Pro turns them into review-ready daily reports you
        can edit, approve, and export.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button
          href={APP_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="accent"
          size="lg"
        >
          Download on the App Store <Icon name="external-link" class="h-4 w-4" />
        </Button>
        <Button
          href="#waitlist"
          variant="ghost"
        >
          Android and web updates <Icon name="arrow-right" class="h-4 w-4" />
        </Button>
      </div>
      <div
        class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm leading-5 text-ink-soft"
      >
        <span class="inline-flex items-center gap-1.5">
          <Icon name="circle-check" class="h-3.5 w-3.5 text-ink" />
          Less end-of-day cleanup
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="circle-check" class="h-3.5 w-3.5 text-ink" />
          Built for quick site capture
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="circle-check" class="h-3.5 w-3.5 text-ink" />
          Review-ready daily reports
        </span>
      </div>
    </div>

    <!-- min-h matches the VoiceDemo card's fixed 640px height so the grid
         column reserves space before the React island hydrates, preventing
         the layout shift that caused CLS 0.125. client:only is required
         because VoiceDemo depends on NativeWind/RN-Web which cannot SSR. -->
    <div class="relative min-h-[640px] lg:pl-6">
      <VoiceDemo client:only="react" />
    </div>
  </Container>
</Section>

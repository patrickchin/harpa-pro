---
import Icon from "../Icon.astro";

const steps = [
  {
    title: "Capture the update",
    body: "Add a voice note, photo, or text note while you are on site.",
    icon: "mic",
  },
  {
    title: "Create a report draft",
    body: "Harpa Pro organizes the site updates into a structured daily report.",
    icon: "file-text",
  },
  {
    title: "Review and share",
    body: "Check and edit the draft. Then finalize, save, or share the PDF.",
    icon: "clipboard-check",
  },
];
---

<section id="how" class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-16">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      From site update to daily report
    </h2>
  </div>

  <ol
    class="mt-10 grid gap-px overflow-hidden rounded-xl border border-hairline bg-border sm:grid-cols-3"
  >
    {
      steps.map((s, i) => (
        <li class="bg-card p-6">
          <div class="flex items-center justify-between">
            <span class="grid h-9 w-9 place-items-center rounded-md bg-primary text-primary-foreground">
              <Icon name={s.icon} class="h-4 w-4" />
            </span>
            <span class="font-mono text-xs text-ink-soft">0{i + 1}</span>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-ink">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{s.body}</p>
        </li>
      ))
    }
  </ol>
</section>
